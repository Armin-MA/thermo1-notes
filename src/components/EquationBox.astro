---
import PersianText from './PersianText.astro';
import { toPersianDigits } from '../utils/bidi';

interface Props {
  id: string;
  number: string;
  label?: string;
}

const { id, number, label } = Astro.props;
const normalizedNumber = toPersianDigits(number);
---

<div class="eq-card not-content" id={id}>
  <div class="eq-card__body">
    <slot />
  </div>
  <div class="eq-card__meta">
    <span class="eq-card__num" dir="rtl">(<PersianText text={normalizedNumber} />)</span>
    {label && <span class="eq-card__label"><PersianText text={label} /></span>}
  </div>
</div>
