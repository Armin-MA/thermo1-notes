        <rect x="44" y="170" width="212" height="52" rx="10" fill="#0284c7" fill-opacity="0.16" stroke="#0284c7" stroke-width="2.2" />
        <text id="tml-sg-tl-txt" x="150" y="193" text-anchor="middle" fill="#0284c7" font-size="12.5" font-weight="800">Sink: T_L = 500 K</text>
        <text id="tml-sg-dsl-txt" x="150" y="211" text-anchor="middle" fill="currentColor" font-size="10.5" font-weight="700">ΔS_sink = +4.00 kJ/K</text>
      </svg>
    </div>

    <!-- پنل ۲ -->
    <div class="jh-widget__pane">
      <div class="jh-widget__pane-title">
