        <!-- ناحیه هاشورخورده q_rev = ∫ T ds -->
        <path id="tml-area-fill" d="" fill="#d97706" fill-opacity="0.24" />
        <text id="tml-area-lbl" x="180" y="196" text-anchor="middle" fill="#d97706" font-size="10" font-weight="800"></text>

        <!-- خط هم‌فشار فعال و مسیر تحول -->
        <path id="tml-active-isobar" d="" fill="none" stroke="#0284c7" stroke-opacity="0.45" stroke-width="2" />
        <path id="tml-proc-path" d="" fill="none" stroke="#d97706" stroke-width="3.2" stroke-linecap="round" />

        <!-- خط هم‌حجم مقایسه شیب در T-s -->
        <path id="tml-isochor-stub" d="" fill="none" stroke="#059669" stroke-width="1.8" stroke-dasharray="4 3" style="display:none" />

