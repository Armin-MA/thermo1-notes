          <circle id="tml-bulb" cx="0" cy="116" r="10" fill="#ef4444" stroke="currentColor" stroke-opacity="0.45" stroke-width="1.5" />
          <rect id="tml-merc" x="-3.5" y="40" width="7" height="70" rx="3" fill="#ef4444" />
          <text id="tml-tlbl" x="0" y="140" text-anchor="middle" fill="#ef4444" font-size="11" font-weight="800">180 °C</text>
        </g>

        <!-- میله‌های h و s و q_rev -->
        <text x="20" y="190" fill="currentColor" font-size="10" font-weight="700">h (kJ/kg)</text>
        <rect x="86" y="180" width="174" height="12" rx="4" fill="currentColor" fill-opacity="0.1" />
        <rect id="tml-bar-h" x="86" y="180" width="90" height="12" rx="4" fill="#0284c7" />
        <text id="tml-val-h" x="260" y="176" text-anchor="end" fill="#0284c7" font-size="9.5" font-weight="800">2000</text>

        <text x="20" y="214" fill="currentColor" font-size="10" font-weight="700">s (kJ/kg·K)</text>
        <rect x="86" y="204" width="174" height="12" rx="4" fill="currentColor" fill-opacity="0.1" />
        <rect id="tml-bar-s" x="86" y="204" width="90" height="12" rx="4" fill="#059669" />
        <text id="tml-val-s" x="260" y="200" text-anchor="end" fill="#059669" font-size="9.5" font-weight="800">5.00</text>

        <text id="tml-qbar-title" x="20" y="236" fill="currentColor" font-size="10" font-weight="700">q_rev = ∫Tds</text>
        <rect x="86" y="226" width="174" height="12" rx="4" fill="currentColor" fill-opacity="0.1" />
        <rect id="tml-bar-q" x="86" y="226" width="90" height="12" rx="4" fill="#d97706" />
        <text id="tml-val-q" x="260" y="222" text-anchor="end" fill="#d97706" font-size="9.5" font-weight="800">1500</text>
      </svg>

      <!-- SVG حالت ۲: میله‌های آنتروپی و نمودار S_gen -->
      <svg id="tml-sg-bars-svg" viewBox="0 0 300 245" style="width:100%;height:auto;display:none;direction:ltr" aria-label="تراز آنتروپی چشمه، چاه و آنتروپی تولیدی S_gen">
        <!-- محور مبنا برای میله‌ها -->
        <line x1="20" y1="108" x2="284" y2="108" stroke="currentColor" stroke-opacity="0.55" stroke-width="1.6" />
        <text x="16" y="112" text-anchor="end" fill="currentColor" fill-opacity="0.65" font-size="9.5">0</text>

        <rect id="tml-sg-bar-src" x="36" y="108" width="50" height="36" rx="4" fill="#ef4444" fill-opacity="0.86" />
        <text id="tml-sg-val-src" x="61" y="158" text-anchor="middle" fill="#ef4444" font-size="10.5" font-weight="800">-2.50</text>
        <text x="61" y="19" text-anchor="middle" fill="currentColor" font-size="10" font-weight="700">ΔS_source</text>

        <rect id="tml-sg-bar-snk" x="120" y="52" width="50" height="56" rx="4" fill="#0284c7" fill-opacity="0.86" />
        <text id="tml-sg-val-snk" x="145" y="45" text-anchor="middle" fill="#0284c7" font-size="10.5" font-weight="800">+4.00</text>
        <text x="145" y="19" text-anchor="middle" fill="currentColor" font-size="10" font-weight="700">ΔS_sink</text>

        <rect id="tml-sg-bar-gen" x="204" y="84" width="54" height="24" rx="4" fill="#d97706" fill-opacity="0.9" />
        <text id="tml-sg-val-gen" x="231" y="77" text-anchor="middle" fill="#d97706" font-size="10.5" font-weight="800">+1.50</text>
        <text x="231" y="19" text-anchor="middle" fill="currentColor" font-size="10" font-weight="700">S_gen ≥ 0</text>

        <!-- مینی نمودار S_gen بر حسب T_L -->
        <text x="26" y="182" fill="currentColor" fill-opacity="0.7" font-size="9.5" font-weight="700">S_gen(T_L) drops to 0 as T_L → T_H:</text>
        <line x1="26" y1="228" x2="280" y2="228" stroke="currentColor" stroke-opacity="0.4" stroke-width="1.4" />
        <line x1="26" y1="186" x2="26" y2="228" stroke="currentColor" stroke-opacity="0.4" stroke-width="1.4" />
        <path id="tml-sg-curve" d="" fill="none" stroke="#d97706" stroke-width="2.4" />
        <circle id="tml-sg-dot" cx="130" cy="200" r="5" fill="#d97706" stroke="#ffffff" stroke-width="1.5" />
      </svg>
    </div>
  </div>

  <div class="jh-widget__metrics">
    <div class="jh-metric">
      <span class="jh-metric__label" id="tml-m1-lbl">دما (<span dir="ltr">T</span>)</span>
      <span class="jh-metric__val" id="tml-m1-val">179.9 °C</span>
    </div>
    <div class="jh-metric">
      <span class="jh-metric__label" id="tml-m2-lbl">آنتروپی ویژه (<span dir="ltr">s</span>)</span>
      <span class="jh-metric__val" id="tml-m2-val">4.50 kJ/kg·K</span>
    </div>
    <div class="jh-metric">
      <span class="jh-metric__label" id="tml-m3-lbl">آنتالپی (<span dir="ltr">h</span>)</span>
      <span class="jh-metric__val" id="tml-m3-val">1920 kJ/kg</span>
    </div>
    <div class="jh-metric">
      <span class="jh-metric__label" id="tml-m4-lbl">گرمای برگشت‌پذیر / کار (<span dir="ltr">q_rev</span>)</span>
      <span class="jh-metric__val" id="tml-m4-val">1752 kJ/kg</span>
    </div>
  </div>

  <div class="jh-widget__explain" id="tml-explain">
    روی نمودار واقعی <span dir="ltr">T-s</span> آب، در فشار <span dir="ltr">1 MPa</span> خط هم‌فشار درون گنبد اشباع دقیقاً افقی است <span dir="ltr">(T_sat = 179.9 °C)</span> و سطح زیر منحنی برابر گرمای برگشت‌پذیر <span dir="ltr">(q_rev = ∫ T ds = Δh)</span> است.
  </div>
</div>

<script>
  import { createViewport, tempToColor, setThermometer, createAnimController } from '../../lib/liveSimKit';
  import { getWaterDome, waterSatByP, waterPT, waterPS } from '../../lib/thermoProps';

  (() => {
    const root = document.getElementById('ts-mollier-lab');
    if (!root) return;

    type MainMode = 'diagrams' | 'entropy-gen';
    type PlotType = 'ts' | 'hs';
    type ProcType = 'isobar' | 'isothermal' | 'isentropic';

    let mode: MainMode = 'diagrams';
    let plotType: PlotType = 'ts';
    let pKpa = 1000;
    let procType: ProcType = 'isobar';
    let dProg = 0.65;

    let sgTH = 800;
    let sgTL = 500;
    let sgQ = 2000;
    let flowDash = 0;

    interface ThermoPt {
      s: number;
      tK: number;
      tC: number;
      h: number;
      x: number | null;
      phase: string;
    }

    const dome = getWaterDome();

    // کش کردن نقاط ایزوبار برای کارایی بالا
    const isobarCache = new Map<number, ThermoPt[]>();
    function getIsobarPts(p: number): ThermoPt[] {
      const cached = isobarCache.get(p);
      if (cached) return cached;
      const sat = waterSatByP(p);
      const pts: ThermoPt[] = [];

      // مایع متراکم: از 35 درجه تا نزدیک Tsat
      const tStart = 35;
      const nLiq = 8;
      for (let i = 0; i < nLiq; i++) {
        const t = tStart + (i / nLiq) * (sat.tC - 1.2 - tStart);
        const st = waterPT(p, t);
        pts.push({ s: st.s, tK: st.tK, tC: st.tC, h: st.h, x: null, phase: 'مایع متراکم' });
      }
      pts.push({ s: sat.sf, tK: sat.tK, tC: sat.tC, h: sat.hf, x: 0, phase: 'مایع اشباع' });

      // مخلوط دوفازی
      const nMix = 10;
      for (let i = 1; i < nMix; i++) {
        const x = i / nMix;
        pts.push({
          s: sat.sf + x * (sat.sg - sat.sf),
          tK: sat.tK,
          tC: sat.tC,
          h: sat.hf + x * (sat.hg - sat.hf),
          x,
          phase: 'مخلوط اشباع',
        });
      }
      pts.push({ s: sat.sg, tK: sat.tK, tC: sat.tC, h: sat.hg, x: 1, phase: 'بخار اشباع' });

      // بخار فوق گرم تا 550 درجه
      const tEnd = 550;
      const nSup = 16;
      for (let i = 1; i <= nSup; i++) {
        const t = sat.tC + 2 + ((i / nSup) * (tEnd - sat.tC - 2));
        const st = waterPT(p, t);
        pts.push({ s: st.s, tK: st.tK, tC: st.tC, h: st.h, x: null, phase: 'بخار فوق‌گرم' });
      }

      isobarCache.set(p, pts);
      return pts;
    }

    function getProcessPts(): ThermoPt[] {
      if (procType === 'isobar') return getIsobarPts(pKpa);
      if (procType === 'isothermal') {
        const sat = waterSatByP(pKpa);
        const pts: ThermoPt[] = [];
        for (let i = 0; i <= 20; i++) {
          const x = i / 20;
          pts.push({
            s: sat.sf + x * (sat.sg - sat.sf),
            tK: sat.tK,
            tC: sat.tC,
            h: sat.hf + x * (sat.hg - sat.hf),
            x,
            phase: x === 0 ? 'مایع اشباع' : x === 1 ? 'بخار اشباع' : 'مخلوط اشباع',
          });
        }
        return pts;
      }
      // انبساط ایزنتروپیک مثال ۷-۴: 5 MPa, 450 C -> P_exit (اگر 5MPa فعال است، مقصد 1.4 MPa)
      const pExit = pKpa >= 5000 ? 1400 : pKpa;
      const st1 = waterPT(5000, 450);
      const pts: ThermoPt[] = [];
      for (let i = 0; i <= 18; i++) {
        const u = i / 18;
        const pCur = 5000 - u * (5000 - pExit);
        const st = waterPS(pCur, st1.s);
        pts.push({ s: st.s, tK: st.tK, tC: st.tC, h: st.h, x: st.x, phase: st.phase });
      }
      return pts;
    }

    function interpPts(pts: ThermoPt[], u: number): ThermoPt {
      const idxF = Math.max(0, Math.min(pts.length - 1, u * (pts.length - 1)));
      const i0 = Math.floor(idxF);
      const i1 = Math.min(pts.length - 1, i0 + 1);
      const f = idxF - i0;
      const a = pts[i0];
      const b = pts[i1];
      return {
        s: a.s + f * (b.s - a.s),
        tK: a.tK + f * (b.tK - a.tK),
        tC: a.tC + f * (b.tC - a.tC),
        h: a.h + f * (b.h - a.h),
        x: a.x !== null && b.x !== null ? a.x + f * (b.x - a.x) : a.x,
        phase: f < 0.5 ? a.phase : b.phase,
      };
    }

    // المان‌ها
