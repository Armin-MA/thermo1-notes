    function renderDiagrams() {
      dTLbl.textContent = `${Math.round(dProg * 100)}%`;
      dTSlider.value = String(Math.round(dProg * 100));

      const isTS = plotType === 'ts';
      const yMax = isTS ? 920 : 3750;
      const vp = createViewport(0, 9.5, 0, yMax, 48, 342, 210, 18);

      p1Title.innerHTML = isTS
        ? 'نمودار واقعی <span dir="ltr">T-s</span> آب (<span dir="ltr">IAPWS-IF97</span>)'
        : 'نمودار مولیر واقعی <span dir="ltr">(h-s)</span> آب (<span dir="ltr">IAPWS-IF97</span>)';
      p2Title.innerHTML = 'وضعیت فاز آب و خواص لحظه‌ای';

      const yVal = (pt: { tK: number; h: number }) => (isTS ? pt.tK : pt.h);
      yAxisLbl.textContent = isTS ? 'T (K)' : 'h (kJ/kg)';

      // شبکه‌بندی و برچسب محورها
      const yTickVals = isTS ? [0, 300, 600, 900] : [0, 1000, 2000, 3000];
      const xTickVals = [0, 2, 4, 6, 8];
      let gridHtml = '';
      let ytHtml = '';
      let xtHtml = '';
      for (const yv of yTickVals) {
        const py = vp.y(yv);
        if (yv > 0) gridHtml += `<line x1="48" y1="${py.toFixed(1)}" x2="342" y2="${py.toFixed(1)}" />`;
        ytHtml += `<text x="42" y="${(py + 3.5).toFixed(1)}">${yv}</text>`;
      }
      for (const xv of xTickVals) {
        const px = vp.x(xv);
        if (xv > 0) gridHtml += `<line x1="${px.toFixed(1)}" y1="18" x2="${px.toFixed(1)}" y2="210" />`;
        xtHtml += `<text x="${px.toFixed(1)}" y="222">${xv}</text>`;
      }
      gridGrp.innerHTML = gridHtml;
      yTicksGrp.innerHTML = ytHtml;
      xTicksGrp.innerHTML = xtHtml;

      // گنبد اشباع واقعی
      const domePts: Array<[number, number]> = [];
      for (const pt of dome) {
        domePts.push([pt.sf, isTS ? pt.tK : pt.hf]);
      }
      for (let i = dome.length - 1; i >= 0; i--) {
        const pt = dome[i];
        domePts.push([pt.sg, isTS ? pt.tK : pt.hg]);
      }
      const domeD = vp.path(domePts, true);
      domeFill.setAttribute('d', domeD);
      domeLine.setAttribute('d', vp.path(domePts, false));

      const crit = dome[dome.length - 1];
      const critS = (crit.sf + crit.sg) / 2;
      const critY = isTS ? crit.tK : (crit.hf + crit.hg) / 2;
      critDot.setAttribute('cx', vp.x(critS).toFixed(1));
      critDot.setAttribute('cy', vp.y(critY).toFixed(1));
      critLbl.setAttribute('x', vp.x(critS).toFixed(1));
      critLbl.setAttribute('y', (vp.y(critY) - 8).toFixed(1));

      // خطوط هم‌فشار شبح
      let ghostHtml = '';
      for (const p of [100, 1000, 5000]) {
        const iso = getIsobarPts(p);
        const pathPts: Array<[number, number]> = iso.map((pt) => [pt.s, yVal(pt)]);
        ghostHtml += `<path d="${vp.path(pathPts)}" />`;
      }
      ghostIso.innerHTML = ghostHtml;

      // خط هم‌فشار فعال و مسیر فرآیند
      const actIso = getIsobarPts(pKpa);
      activeIsobar.setAttribute('d', vp.path(actIso.map((pt) => [pt.s, yVal(pt)])));

      const procPts = getProcessPts();
      const maxIdx = Math.max(1, Math.round(dProg * (procPts.length - 1)));
      const subPts = procPts.slice(0, maxIdx + 1);
      const curPt = interpPts(procPts, dProg);
      const startPt = procPts[0];

      const traceCoords: Array<[number, number]> = subPts.map((pt) => [pt.s, yVal(pt)]);
      traceCoords[traceCoords.length - 1] = [curPt.s, yVal(curPt)];
      procPath.setAttribute('d', vp.path(traceCoords));

      // مساحت زیر منحنی T-s یا تغییر h در مولیر
      if (isTS && procType !== 'isentropic' && traceCoords.length >= 2) {
        const areaD = `${vp.path(traceCoords)} L ${vp.x(curPt.s).toFixed(1)} ${vp.y(0).toFixed(1)} L ${vp.x(startPt.s).toFixed(1)} ${vp.y(0).toFixed(1)} Z`;
        areaFill.setAttribute('d', areaD);
        const qRev = curPt.h - startPt.h;
        areaLbl.textContent = qRev > 20 ? `q_rev = ∫Tds = ${qRev.toFixed(0)} kJ/kg` : '';
        areaLbl.setAttribute('x', vp.x((startPt.s + curPt.s) / 2).toFixed(1));
      } else {
        areaFill.setAttribute('d', '');
        areaLbl.textContent = '';
      }

      // نمایش شیب پرشیب‌تر هم‌حجم (v=const) نسبت به هم‌فشار (P=const) در T-s
      if (isTS && curPt.x === null && curPt.s > 6.0 && procType !== 'isentropic') {
        isochorStub.style.display = '';
        const slopeV = curPt.tK / 1.5; // تقریبی بخار: cv ~ 1.5
        const dsStub = 0.55;
        const pA: [number, number] = [Math.max(0.5, curPt.s - dsStub), Math.max(250, curPt.tK - slopeV * dsStub)];
        const pB: [number, number] = [Math.min(9.2, curPt.s + dsStub), Math.min(900, curPt.tK + slopeV * dsStub)];
        isochorStub.setAttribute('d', vp.path([pA, [curPt.s, curPt.tK], pB]));
      } else {
        isochorStub.style.display = 'none';
      }

      ptStart.setAttribute('cx', vp.x(startPt.s).toFixed(1));
      ptStart.setAttribute('cy', vp.y(yVal(startPt)).toFixed(1));
      ptCur.setAttribute('cx', vp.x(curPt.s).toFixed(1));
      ptCur.setAttribute('cy', vp.y(yVal(curPt)).toFixed(1));

      const pTagStr = procType === 'isentropic'
        ? `5 MPa → ${pKpa >= 5000 ? '1.4 MPa' : pKpa >= 1000 ? `${pKpa / 1000} MPa` : `${pKpa} kPa`}`
        : `P = ${pKpa >= 1000 ? `${pKpa / 1000} MPa` : `${pKpa} kPa`}`;
      p1Tag.textContent = pTagStr;
      p2Tag.textContent = curPt.phase;

      // محفظه فاز آب در پنل ۲
      const col = tempToColor(curPt.tK);
      let liqFrac = 0;
      if (curPt.x !== null) {
        liqFrac = Math.max(0, Math.min(1, 1 - curPt.x));
        vessLbl.textContent = `x = ${(curPt.x * 100).toFixed(1)}%`;
      } else if (curPt.phase === 'مایع متراکم') {
        liqFrac = 0.92;
        vessLbl.textContent = 'Compressed Liquid';
      } else {
        liqFrac = 0;
        vessLbl.textContent = 'Superheated Vapor';
      }
      const liqH = liqFrac * 116;
      vessLiq.setAttribute('y', (144 - liqH).toFixed(1));
      vessLiq.setAttribute('height', liqH.toFixed(1));
      vessVap.setAttribute('fill', col);
      vessVap.setAttribute('fill-opacity', curPt.x === null && liqFrac === 0 ? '0.28' : '0.12');

      setThermometer(mercEl, curPt.tK, 273, 850, 108, 96);
      mercEl.setAttribute('fill', col);
      bulbEl.setAttribute('fill', col);
      tLblEl.setAttribute('fill', col);
      tLblEl.textContent = `${curPt.tC.toFixed(1)} °C`;

      barH.setAttribute('width', (174 * Math.min(1, curPt.h / 3650)).toFixed(1));
      valH.textContent = `${curPt.h.toFixed(1)} kJ/kg`;

      barS.setAttribute('width', (174 * Math.min(1, curPt.s / 9.2)).toFixed(1));
      valS.textContent = `${curPt.s.toFixed(3)} kJ/kg·K`;

      const qOrW = procType === 'isentropic' ? startPt.h - curPt.h : curPt.h - startPt.h;
      qbarTitle.textContent = procType === 'isentropic' ? 'w_s = Δh' : 'q_rev = ∫Tds';
      barQ.setAttribute('width', (174 * Math.min(1, Math.abs(qOrW) / 3400)).toFixed(1));
      valQ.textContent = `${qOrW.toFixed(1)} kJ/kg`;

      // معیارها
      m1Lbl.innerHTML = 'دما (<span dir="ltr">T</span>)';
      m2Lbl.innerHTML = 'آنتروپی ویژه (<span dir="ltr">s</span>)';
      m3Lbl.innerHTML = 'آنتالپی (<span dir="ltr">h</span>)';
      m4Lbl.innerHTML = procType === 'isentropic'
        ? 'کار توربین ایزنتروپیک <span dir="ltr">(w_s = h₁ - h₂)</span>'
        : 'گرمای برگشت‌پذیر <span dir="ltr">(q_rev = ∫ T ds)</span>';

      m1Val.textContent = `${curPt.tC.toFixed(1)} °C (${curPt.tK.toFixed(1)} K)`;
      m2Val.textContent = `${curPt.s.toFixed(4)} kJ/kg·K`;
      m3Val.textContent = `${curPt.h.toFixed(1)} kJ/kg`;
      m4Val.textContent = `${qOrW.toFixed(1)} kJ/kg`;

      if (procType === 'isentropic') {
        explainEl.innerHTML = `در <strong>انبساط ایزنتروپیک</strong> مثال ۷-۴ (<span dir="ltr">s = ${startPt.s.toFixed(3)} kJ/kg·K</span> ثابت)، مسیر روی نمودار <span dir="ltr">T-s</span> و مولیر <span dir="ltr">h-s</span> دقیقاً عمودی است <span dir="ltr">(q_rev = 0)</span> و افت عمودی آنتالپی مستقیماً برابر کار بیشینه توربین <strong><span dir="ltr">w_s = ${qOrW.toFixed(1)} kJ/kg</span></strong> است.`;
      } else {
        explainEl.innerHTML = `با داده‌های واقعی <strong><span dir="ltr">IAPWS-IF97</span></strong>، خط فشار ثابت <span dir="ltr">${pTagStr}</span> درون گنبد اشباع افقی (در <span dir="ltr">T-s</span>) و خط راست با شیب <span dir="ltr">T_sat</span> (در مولیر <span dir="ltr">h-s</span>) است. مساحت نارنجی زیر منحنی <span dir="ltr">T-s</span> دقیقاً برابر گرمای ورودی برگشت‌پذیر <strong><span dir="ltr">q_rev = ∫ T ds = ${qOrW.toFixed(1)} kJ/kg</span></strong> است.`;
      }
    }

    function renderSgen() {
      if (sgTL >= sgTH) {
        sgTL = sgTH - 10;
        sgTlSlider.value = String(sgTL);
      }
      sgTlSlider.max = String(sgTH - 10);
      sgThLbl.textContent = `${sgTH.toFixed(0)} K`;
      sgTlLbl.textContent = `${sgTL.toFixed(0)} K`;
      sgQLbl.textContent = `${sgQ.toFixed(0)} kJ`;

      const dsSrc = -sgQ / sgTH;
      const dsSnk = sgQ / sgTL;
      const sGen = dsSrc + dsSnk;

      p1Title.innerHTML = 'جریان حرارت بین دو مخزن دما';
      p1Tag.textContent = `ΔT = ${(sgTH - sgTL).toFixed(0)} K`;
      p2Title.innerHTML = 'تراز آنتروپی و اصل افزایش آنتروپی';
      p2Tag.textContent = `S_gen = +${sGen.toFixed(2)} kJ/K`;

      sgThTxt.textContent = `Source: T_H = ${sgTH} K`;
      sgDshTxt.textContent = `ΔS_source = ${dsSrc.toFixed(2)} kJ/K`;
      sgTlTxt.textContent = `Sink: T_L = ${sgTL} K`;
      sgDslTxt.textContent = `ΔS_sink = +${dsSnk.toFixed(2)} kJ/K`;
      sgQtxt.textContent = `Q = ${sgQ} kJ`;
      sgDttxt.textContent = `ΔT = ${sgTH - sgTL} K`;
      sgQline.setAttribute('stroke-width', (3 + 8 * (sgQ / 4000)).toFixed(1));

      // میله‌های ΔS
      const maxS = Math.max(4, sgQ / 300);
      const pxPerS = 74 / maxS;
      const zeroY = 108;

      const hSrc = Math.min(62, Math.abs(dsSrc) * pxPerS);
      sgBarSrc.setAttribute('y', String(zeroY));
      sgBarSrc.setAttribute('height', Math.max(2, hSrc).toFixed(1));
      sgValSrc.setAttribute('y', (zeroY + hSrc + 13).toFixed(1));
      sgValSrc.textContent = dsSrc.toFixed(2);

      const hSnk = Math.min(78, dsSnk * pxPerS);
      sgBarSnk.setAttribute('y', (zeroY - hSnk).toFixed(1));
      sgBarSnk.setAttribute('height', Math.max(2, hSnk).toFixed(1));
      sgValSnk.setAttribute('y', Math.max(30, zeroY - hSnk - 6).toFixed(1));
      sgValSnk.textContent = `+${dsSnk.toFixed(2)}`;

      const hGen = Math.min(78, sGen * pxPerS);
      sgBarGen.setAttribute('y', (zeroY - hGen).toFixed(1));
      sgBarGen.setAttribute('height', Math.max(2, hGen).toFixed(1));
      sgValGen.setAttribute('y', Math.max(30, zeroY - hGen - 6).toFixed(1));
      sgValGen.textContent = `+${sGen.toFixed(2)}`;

      // مینی نمودار S_gen(T_L)
      const sMaxCurve = sgQ * (1 / 300 - 1 / sgTH);
      const cvp = createViewport(300, sgTH, 0, Math.max(0.5, sMaxCurve * 1.1), 26, 280, 228, 186);
      const cPts: Array<[number, number]> = [];
      for (let i = 0; i <= 40; i++) {
        const t = 300 + (i / 40) * (sgTH - 300);
        cPts.push([t, sgQ * (1 / t - 1 / sgTH)]);
      }
      sgCurve.setAttribute('d', cvp.path(cPts));
      sgDot.setAttribute('cx', cvp.x(sgTL).toFixed(1));
      sgDot.setAttribute('cy', cvp.y(sGen).toFixed(1));

      m1Lbl.innerHTML = 'تغییر آنتروپی چشمه (<span dir="ltr">ΔS_source</span>)';
      m2Lbl.innerHTML = 'تغییر آنتروپی چاه (<span dir="ltr">ΔS_sink</span>)';
      m3Lbl.innerHTML = 'آنتروپی تولیدی <span dir="ltr">(S_gen = ΔS_total)</span>';
      m4Lbl.innerHTML = 'اختلاف دما <span dir="ltr">(ΔT = T_H - T_L)</span>';

      m1Val.textContent = `${dsSrc.toFixed(2)} kJ/K`;
      m2Val.textContent = `+${dsSnk.toFixed(2)} kJ/K`;
      m3Val.textContent = `+${sGen.toFixed(2)} kJ/K (≥ 0)`;
      m4Val.textContent = `${(sgTH - sgTL).toFixed(0)} K`;

      explainEl.innerHTML = `در انتقال گرمای <span dir="ltr">${sgQ} kJ</span> از چشمه <span dir="ltr">${sgTH} K</span> به چاه <span dir="ltr">${sgTL} K</span>، چشمه <span dir="ltr">${dsSrc.toFixed(2)} kJ/K</span> از دست می‌دهد اما چاه <strong><span dir="ltr">+${dsSnk.toFixed(2)} kJ/K</span></strong> به‌دست می‌آورد؛ در نتیجه آنتروپی کل جهان به اندازهٔ <strong><span dir="ltr">S_gen = +${sGen.toFixed(2)} kJ/K</span></strong> افزایش می‌یابد. هرچه <span dir="ltr">T_L</span> به <span dir="ltr">T_H</span> نزدیک‌تر شود، <span dir="ltr">S_gen</span> به صفر میل می‌کند.`;
    }

    function renderAll() {
      if (mode === 'diagrams') renderDiagrams();
      else renderSgen();
    }

    const anim = createAnimController(root, (dt) => {
      if (mode === 'diagrams') {
        dProg += dt * 0.16;
        if (dProg >= 1) {
          dProg = 1;
          renderDiagrams();
          dPlayBtn.textContent = '▶ پخش تحول';
          return false;
        }
        renderDiagrams();
      } else {
        flowDash = (flowDash + dt * 28) % 28;
        sgQline.setAttribute('stroke-dashoffset', (-flowDash).toFixed(1));
      }
    });

    root.querySelectorAll('#tml-modes button').forEach((btn) => {
      btn.addEventListener('click', () => {
        root.querySelectorAll('#tml-modes button').forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        mode = (btn.getAttribute('data-mode') as MainMode) || 'diagrams';

        diagCtrls.style.display = mode === 'diagrams' ? '' : 'none';
        sgenCtrls.style.display = mode === 'entropy-gen' ? '' : 'none';

        diagSvg.style.display = mode === 'diagrams' ? 'block' : 'none';
        phaseSvg.style.display = mode === 'diagrams' ? 'block' : 'none';
        sgFlowSvg.style.display = mode === 'entropy-gen' ? 'block' : 'none';
        sgBarsSvg.style.display = mode === 'entropy-gen' ? 'block' : 'none';

        if (mode === 'entropy-gen') {
          anim.start();
        } else {
          anim.stop();
          dPlayBtn.textContent = '▶ پخش تحول';
        }
        renderAll();
      });
    });

    root.querySelectorAll('#tml-plot-types button').forEach((btn) => {
      btn.addEventListener('click', () => {
        root.querySelectorAll('#tml-plot-types button').forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        plotType = (btn.getAttribute('data-plot') as PlotType) || 'ts';
        renderDiagrams();
      });
    });

    root.querySelectorAll('#tml-pressures button').forEach((btn) => {
      btn.addEventListener('click', () => {
        root.querySelectorAll('#tml-pressures button').forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        pKpa = parseFloat(btn.getAttribute('data-p') || '1000');
        renderDiagrams();
      });
    });

    root.querySelectorAll('#tml-procs button').forEach((btn) => {
      btn.addEventListener('click', () => {
        root.querySelectorAll('#tml-procs button').forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        procType = (btn.getAttribute('data-proc') as ProcType) || 'isobar';
        renderDiagrams();
      });
    });

    dPlayBtn.addEventListener('click', () => {
      if (anim.isPlaying()) {
        anim.stop();
        dPlayBtn.textContent = '▶ پخش تحول';
      } else {
        if (dProg >= 0.99) dProg = 0;
        anim.start();
        dPlayBtn.textContent = '⏸ توقف';
      }
    });

    dResetBtn.addEventListener('click', () => {
      anim.stop();
      dPlayBtn.textContent = '▶ پخش تحول';
      dProg = 0;
      renderDiagrams();
    });

    dTSlider.addEventListener('input', () => {
      anim.stop();
      dPlayBtn.textContent = '▶ پخش تحول';
      dProg = parseFloat(dTSlider.value) / 100;
      renderDiagrams();
    });

    root.querySelectorAll('#tml-sgen-presets button').forEach((btn) => {
      btn.addEventListener('click', () => {
        root.querySelectorAll('#tml-sgen-presets button').forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        sgTH = 800;
        sgQ = 2000;
        sgTL = parseFloat(btn.getAttribute('data-tl') || '500');
        sgThSlider.value = '800';
        sgTlSlider.value = String(sgTL);
        sgQSlider.value = '2000';
        renderSgen();
      });
    });

    sgThSlider.addEventListener('input', () => {
      sgTH = parseFloat(sgThSlider.value);
      renderSgen();
    });
    sgTlSlider.addEventListener('input', () => {
      sgTL = parseFloat(sgTlSlider.value);
      renderSgen();
    });
    sgQSlider.addEventListener('input', () => {
      sgQ = parseFloat(sgQSlider.value);
      renderSgen();
    });

    // مقداردهی اولیه نمایش پنل ۲
    phaseSvg.style.display = 'block';
    renderAll();
  })();
</script>
