    </div>
    <div class="jh-widget__toolbar">
      <button type="button" class="jh-widget__btn jh-widget__btn--primary" id="pcl2-ic-opt">🎯 تنظیم روی فشار بهینه <span dir="ltr">P_x = √(P₁·P₂)</span></button>
    </div>
  </div>

  <div class="jh-widget__split">
    <!-- پنل ۱: نمودار P-v و سطح سمت چپ -->
    <div class="jh-widget__pane">
