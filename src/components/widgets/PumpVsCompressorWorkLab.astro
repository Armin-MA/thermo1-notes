        <!-- منحنی همدما (حد ایده‌آل) -->
        <path id="pcl2-ic-iso" d="" fill="none" stroke="#059669" stroke-width="1.8" stroke-dasharray="4 3" />
        <!-- منحنی ۱-مرحله‌ای ایزنتروپیک -->
        <path id="pcl2-ic-1st" d="" fill="none" stroke="#ef4444" stroke-width="2.2" stroke-dasharray="5 3" />
        <!-- مسیر ۲-مرحله‌ای با خنک‌کن میانی -->
