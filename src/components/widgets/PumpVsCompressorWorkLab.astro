        <text id="pcl2-ic-saved-lbl" x="215" y="64" text-anchor="middle" fill="#059669" font-size="10" font-weight="800">Work Saved</text>
        <text x="194" y="24" text-anchor="middle" fill="currentColor" fill-opacity="0.72" font-size="9">Red: 1-stage | Blue: 2-stage | Green dash: Isothermal</text>
      </svg>
    </div>

    <!-- پنل ۲ -->
    <div class="jh-widget__pane">
      <div class="jh-widget__pane-title">
        <span id="pcl2-p2-title">مقایسهٔ مقیاس کار پمپ و کمپرسور</span>
        <span dir="ltr" id="pcl2-p2-tag">v_g / v_f = 1624×</span>
      </div>

      <!-- SVG حالت ۱: میله‌های نسبت کار پمپ vs کمپرسور -->
      <svg id="pcl2-ratio-svg" viewBox="0 0 300 242" style="width:100%;height:auto;display:block;direction:ltr" aria-label="میله مقایسه کار پمپ مایع و کمپرسور بخار">
        <text x="20" y="24" fill="currentColor" font-size="10.5" font-weight="800">True Linear Scale (kJ/kg):</text>

