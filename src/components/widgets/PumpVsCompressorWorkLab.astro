      </svg>

      <!-- SVG حالت ۲: نمودار P-v خنک‌کن میانی -->
      <svg id="pcl2-ic-pv-svg" viewBox="0 0 350 242" style="width:100%;height:auto;display:none;direction:ltr" aria-label="نمودار P-v تراکم دومرحله‌ای با خنک‌کن میانی و سطح کار صرفه‌جویی شده">
        <g id="pcl2-ic-grid" stroke="currentColor" stroke-opacity="0.11" stroke-width="1"></g>
        <line x1="52" y1="16" x2="52" y2="208" stroke="currentColor" stroke-opacity="0.65" stroke-width="2" />
        <line x1="52" y1="208" x2="334" y2="208" stroke="currentColor" stroke-opacity="0.65" stroke-width="2" />
        <text x="12" y="24" fill="currentColor" font-size="10.5" font-weight="800">P (kPa)</text>
        <text x="332" y="229" text-anchor="end" fill="currentColor" font-size="10.5" font-weight="800">v (m³/kg)</text>
        <g id="pcl2-ic-yticks" fill="currentColor" fill-opacity="0.65" font-size="9" text-anchor="end"></g>
        <g id="pcl2-ic-xticks" fill="currentColor" fill-opacity="0.65" font-size="9" text-anchor="middle"></g>

        <!-- سطح کار صرفه‌جویی‌شده -->
