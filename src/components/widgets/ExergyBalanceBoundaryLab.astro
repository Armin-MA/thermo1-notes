            <circle id="ebb-ts-p0" cx="228" cy="192" r="2.6" fill="#0284c7" />
            <circle id="ebb-ts-p1" cx="292" cy="140" r="3.2" fill="#ef4444" />
            <circle id="ebb-ts-p2s" cx="292" cy="180" r="2.6" fill="#059669" />
            <circle id="ebb-ts-p2" cx="298" cy="176" r="3.2" fill="#0284c7" />
            <text id="ebb-ts-l1" x="285" y="136" text-anchor="end" fill="#ef4444" font-size="8" font-weight="800">1</text>
            <text id="ebb-ts-l2" x="303" y="180" text-anchor="start" fill="#0284c7" font-size="8" font-weight="800">2</text>
            <text x="271" y="216" text-anchor="middle" fill="currentColor" fill-opacity="0.72" font-size="8.4" font-weight="700">T-s Dome (s_gen)</text>
          </g>
        </g>
      </svg>
