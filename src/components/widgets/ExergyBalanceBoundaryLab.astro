</div>

<script>
import { createAnimController, createViewport, setDialNeedle } from '../../lib/liveSimKit';
import { getWaterDome, waterPH, waterPS, waterPT } from '../../lib/thermoProps';

(() => {
  const root = document.getElementById('exergy-boundary-lab');
  if (!root) return;

  type Mode = 'wall-ex87' | 'steam-flow';
  type BoundMode = 'wall' | 'extended';

  let mode: Mode = 'wall-ex87';
  let bound: BoundMode = 'wall';
  let boundAnim = 0; // 0 = tight wall, 1 = extended
  let qDot = 1035;
  let t0C = 0;

  let p1 = 3000;
  let t1 = 450;
  let p2 = 200;
  let etaT = 88;
  let mDot = 8;

  let isFlowPlaying = false;
  let flowPhase = 0;
  let rotorAngle = 0;

  const wallCtrls = root.querySelector<HTMLElement>('#ebb-wall-ctrls')!;
  const steamCtrls = root.querySelector<HTMLElement>('#ebb-steam-ctrls')!;
  const qdotEl = root.querySelector<HTMLInputElement>('#ebb-qdot')!;
  const t0cEl = root.querySelector<HTMLInputElement>('#ebb-t0c')!;
  const p1El = root.querySelector<HTMLInputElement>('#ebb-p1')!;
  const t1El = root.querySelector<HTMLInputElement>('#ebb-t1')!;
  const p2El = root.querySelector<HTMLInputElement>('#ebb-p2')!;
  const etatEl = root.querySelector<HTMLInputElement>('#ebb-etat')!;

  const qdotLbl = root.querySelector('#ebb-qdot-lbl')!;
  const t0cLbl = root.querySelector('#ebb-t0c-lbl')!;
  const p1Lbl = root.querySelector('#ebb-p1-lbl')!;
  const t1Lbl = root.querySelector('#ebb-t1-lbl')!;
  const p2Lbl = root.querySelector('#ebb-p2-lbl')!;
  const etatLbl = root.querySelector('#ebb-etat-lbl')!;

  const playBtn = root.querySelector<HTMLButtonElement>('#ebb-play')!;
  const resetBtn = root.querySelector<HTMLButtonElement>('#ebb-reset')!;
  const flowNote = root.querySelector('#ebb-flow-note')!;

  const sysTitle = root.querySelector('#ebb-sys-title')!;
  const sysTag = root.querySelector<HTMLElement>('#ebb-sys-tag')!;
  const chartTitle = root.querySelector('#ebb-chart-title')!;
  const chartTag = root.querySelector<HTMLElement>('#ebb-chart-tag')!;

  const sceneWall = root.querySelector<SVGGElement>('#ebb-scene-wall')!;
  const sceneSteam = root.querySelector<SVGGElement>('#ebb-scene-steam')!;
  const chartWall = root.querySelector<SVGGElement>('#ebb-chart-wall')!;
  const chartSteam = root.querySelector<SVGGElement>('#ebb-chart-steam')!;

  // Wall SVG elements
  const wT0Top = root.querySelector('#ebb-w-t0top')!;
  const wTline = root.querySelector('#ebb-w-tline')!;
  const wN1 = root.querySelector('#ebb-w-n1')!;
  const wN2 = root.querySelector('#ebb-w-n2')!;
  const wN3 = root.querySelector('#ebb-w-n3')!;
  const wN4 = root.querySelector('#ebb-w-n4')!;
  const wQpkt = root.querySelector('#ebb-w-qpkt')!;
  const wQlbl = root.querySelector('#ebb-w-qlbl')!;
  const cvBox = root.querySelector('#ebb-cv-box')!;
  const cvTag = root.querySelector('#ebb-cv-tag')!;
  const cvDotIn = root.querySelector('#ebb-cv-dot-in')!;
  const cvDotOut = root.querySelector('#ebb-cv-dot-out')!;
  const wXin = root.querySelector('#ebb-w-xin')!;
  const wXdest = root.querySelector('#ebb-w-xdest')!;
  const wXout = root.querySelector('#ebb-w-xout')!;

  const wbEq = root.querySelector('#ebb-wb-eq')!;
  const wbYmax = root.querySelector('#ebb-wb-ymax')!;
  const wb1 = root.querySelector<SVGRectElement>('#ebb-wb-1')!;
  const wb2 = root.querySelector<SVGRectElement>('#ebb-wb-2')!;
  const wb3 = root.querySelector<SVGRectElement>('#ebb-wb-3')!;
  const wb4 = root.querySelector<SVGRectElement>('#ebb-wb-4')!;
  const wbV1 = root.querySelector('#ebb-wb-v1')!;
  const wbV2 = root.querySelector('#ebb-wb-v2')!;
  const wbV3 = root.querySelector('#ebb-wb-v3')!;
  const wbV4 = root.querySelector('#ebb-wb-v4')!;
  const wbL4Sub = root.querySelector('#ebb-wb-l4sub')!;

  // Steam SVG elements
  const tPkt1 = root.querySelector('#ebb-t-pkt1')!;
  const tPkt2 = root.querySelector('#ebb-t-pkt2')!;
  const tRotor = root.querySelector('#ebb-t-rotor')!;
  const tWout = root.querySelector('#ebb-t-wout')!;
  const tXdlbl = root.querySelector('#ebb-t-xdlbl')!;
  const tS1a = root.querySelector('#ebb-t-s1a')!;
  const tS1b = root.querySelector('#ebb-t-s1b')!;
  const tS2a = root.querySelector('#ebb-t-s2a')!;
  const tS2b = root.querySelector('#ebb-t-s2b')!;
  const tS2c = root.querySelector('#ebb-t-s2c')!;

  const stYmax = root.querySelector('#ebb-st-ymax')!;
  const stB1 = root.querySelector<SVGRectElement>('#ebb-st-b1')!;
  const stB1v = root.querySelector('#ebb-st-b1v')!;
  const stPsi2 = root.querySelector<SVGRectElement>('#ebb-st-psi2')!;
  const stXd = root.querySelector<SVGRectElement>('#ebb-st-xd')!;
  const stWu = root.querySelector<SVGRectElement>('#ebb-st-wu')!;
  const stTpsi2 = root.querySelector<SVGTextElement>('#ebb-st-tpsi2')!;
  const stTwu = root.querySelector<SVGTextElement>('#ebb-st-twu')!;
  const stBr = root.querySelector<SVGPathElement>('#ebb-st-br')!;
  const stBrlbl = root.querySelector<SVGTextElement>('#ebb-st-brlbl')!;
  const gArc = root.querySelector('#ebb-g-arc')!;
  const gNeedle = root.querySelector('#ebb-g-needle')!;
  const gVal = root.querySelector('#ebb-g-val')!;

  const tsDomeEl = root.querySelector('#ebb-ts-dome')!;
  const tsIsen = root.querySelector('#ebb-ts-isen')!;
  const tsAct = root.querySelector('#ebb-ts-act')!;
  const tsP0 = root.querySelector('#ebb-ts-p0')!;
  const tsP1 = root.querySelector('#ebb-ts-p1')!;
  const tsP2s = root.querySelector('#ebb-ts-p2s')!;
  const tsP2 = root.querySelector('#ebb-ts-p2')!;
  const tsL1 = root.querySelector('#ebb-ts-l1')!;
  const tsL2 = root.querySelector('#ebb-ts-l2')!;

  const m1Lbl = root.querySelector('#ebb-m1-lbl')!;
  const m2Lbl = root.querySelector('#ebb-m2-lbl')!;
  const m3Lbl = root.querySelector('#ebb-m3-lbl')!;
  const m4Lbl = root.querySelector('#ebb-m4-lbl')!;
  const m1Val = root.querySelector('#ebb-m1-val')!;
  const m2Val = root.querySelector('#ebb-m2-val')!;
  const m3Val = root.querySelector('#ebb-m3-val')!;
  const m4Val = root.querySelector('#ebb-m4-val')!;
  const explainEl = root.querySelector('#ebb-explain')!;

  // Prebuild real IAPWS-IF97 saturation dome on T-s mini chart
  const tsVp = createViewport(0, 9.6, 0, 650, 224, 317, 196, 124);
  const domePts = getWaterDome();
  const domeLeft = domePts.map((d) => [d.sf, d.tC] as const);
  const domeRight = [...domePts].reverse().map((d) => [d.sg, d.tC] as const);
  tsDomeEl.setAttribute('d', tsVp.path([...domeLeft, ...domeRight], true));

  // Precompute dead state once via IAPWS-IF97 (P0 = 100 kPa, T0 = 25 °C)
  const deadState = waterPT(100, 25);

  function setBar(el: SVGRectElement, yBase: number, h: number) {
    const ch = Math.max(0, h);
    el.setAttribute('y', (yBase - ch).toFixed(1));
    el.setAttribute('height', ch.toFixed(1));
    el.style.display = ch > 0.5 ? '' : 'none';
  }

  function renderWall() {
    sceneWall.style.display = '';
    sceneSteam.style.display = 'none';
    chartWall.style.display = '';
    chartSteam.style.display = 'none';

    const T0K = t0C + 273; // Ex 8-7 convention: 0 °C = 273 K, 27 °C = 300 K
    const TroomK = 300;
    const TinK = 293;
    const ToutK = 278;

    qdotLbl.textContent = `${qDot} W`;
    t0cLbl.textContent = `${t0C} °C (${T0K} K)`;
    flowNote.innerHTML = `حالت مرده دیوار: <span dir="ltr">T₀ = ${t0C} °C (${T0K} K)</span>`;

    sysTitle.textContent = 'برش دیواره آجری و مرز متحرک سیستم';
    sysTag.textContent = bound === 'wall' ? 'CV: Wall Only' : 'CV: Extended to T₀';
    sysTag.style.color = bound === 'wall' ? '#0284c7' : '#d97706';
    chartTitle.textContent = 'مقایسهٔ اگزرژی عبوری و انهدام در مرز';

    // Exact rates
    const xInWall = qDot * (1 - T0K / TinK);
    const xOutWall = qDot * (1 - T0K / ToutK);
    const sGenWall = qDot * (1 / ToutK - 1 / TinK);
    const xDestWall = T0K * sGenWall;

    const xInExt = qDot * (1 - T0K / TroomK);
    const xOutExt = 0;
    const sGenExt = qDot * (1 / T0K - 1 / TroomK);
    const xDestExt = T0K * sGenExt;
    const xDestLayers = Math.max(0, xDestExt - xDestWall);

    const activeXin = bound === 'wall' ? xInWall : xInExt;
    const activeXout = bound === 'wall' ? xOutWall : xOutExt;
    const activeSgen = bound === 'wall' ? sGenWall : sGenExt;
    const activeXdest = bound === 'wall' ? xDestWall : xDestExt;

    // Temperature curve mapping [-20..32 °C] -> [148..74]
    const yOfT = (tc: number) => 74 + ((32 - tc) / 52) * 74;
    const y27 = yOfT(27);
    const y20 = yOfT(20);
    const y5 = yOfT(5);
    const y0 = yOfT(t0C);

    wT0Top.textContent = `Out ${t0C}°C`;
    wTline.setAttribute('points', `22,${y27.toFixed(1)} 56,${y27.toFixed(1)} 106,${y20.toFixed(1)} 214,${y5.toFixed(1)} 264,${y0.toFixed(1)} 298,${y0.toFixed(1)}`);
    wN1.setAttribute('cy', y27.toFixed(1));
    wN2.setAttribute('cy', y20.toFixed(1));
    wN3.setAttribute('cy', y5.toFixed(1));
    wN4.setAttribute('cy', y0.toFixed(1));

    wQlbl.textContent = `Q̇ = ${qDot} W`;
    wQpkt.setAttribute('cx', (76 + flowPhase * 168).toFixed(1));

    // Smooth boundary box shift
    const cvX = 104 - 56 * boundAnim;
    const cvW = 112 + 112 * boundAnim;
    cvBox.setAttribute('x', cvX.toFixed(1));
    cvBox.setAttribute('width', cvW.toFixed(1));
    cvBox.setAttribute('stroke', bound === 'wall' ? '#0284c7' : '#d97706');
    cvBox.setAttribute('stroke-dashoffset', (-flowPhase * 22).toFixed(1));
    cvDotIn.setAttribute('cx', cvX.toFixed(1));
    cvDotOut.setAttribute('cx', (cvX + cvW).toFixed(1));

    cvTag.textContent =
      bound === 'wall'
        ? 'CV Boundary: 293 K → 278 K (Wall Only)'
        : `CV Boundary: 300 K → ${T0K} K (Extended)`;
    cvTag.setAttribute('fill', bound === 'wall' ? '#0284c7' : '#d97706');

    wXin.textContent = `Ẋ_in: ${activeXin.toFixed(1)} W`;
    wXdest.textContent = `Ẋ_dest: ${activeXdest.toFixed(1)} W`;
    wXout.textContent = `Ẋ_out: ${activeXout.toFixed(1)} W`;

    // Bar chart update
    const scaleMax = Math.max(80, Math.ceil((Math.max(xInExt, xDestExt) * 1.15) / 20) * 20);
    wbYmax.textContent = scaleMax.toFixed(0);
    const baseY = 182;
    const maxH = 136;

    const h1 = (activeXin / scaleMax) * maxH;
    const h2 = (activeXout / scaleMax) * maxH;
    const h3 = (xDestWall / scaleMax) * maxH;
    const h4 = (xDestLayers / scaleMax) * maxH;

    setBar(wb1, baseY, h1);
    setBar(wb2, baseY, Math.max(activeXout > 0.2 ? 3 : 0, h2));
    setBar(wb3, baseY, h3);
    setBar(wb4, baseY, h4);

    wbV1.setAttribute('y', (baseY - h1 - 6).toFixed(1));
    wbV1.textContent = `${activeXin.toFixed(1)} W`;
    wbV2.setAttribute('y', (baseY - Math.max(4, h2) - 6).toFixed(1));
    wbV2.textContent = `${activeXout.toFixed(1)} W`;
    wbV3.setAttribute('y', (baseY - h3 - 6).toFixed(1));
    wbV3.textContent = `${xDestWall.toFixed(1)} W`;
    wbV4.setAttribute('y', (baseY - h4 - 6).toFixed(1));
    wbV4.textContent = `${xDestLayers.toFixed(1)} W`;

    if (bound === 'wall') {
      wb4.setAttribute('fill-opacity', '0.20');
      wb4.setAttribute('stroke', '#ef4444');
      wb4.setAttribute('stroke-dasharray', '4 3');
      wbL4Sub.textContent = '(outside CV)';
    } else {
      wb4.setAttribute('fill-opacity', '0.88');
      wb4.setAttribute('stroke', 'none');
      wbL4Sub.textContent = '(inside CV!)';
    }

    wbEq.textContent = `Ẋ_in (${activeXin.toFixed(1)}) − Ẋ_out (${activeXout.toFixed(1)}) = Ẋ_dest,CV (${activeXdest.toFixed(1)} W)`;
    chartTag.textContent = `Ẋ_dest,CV = ${activeXdest.toFixed(1)} W`;
    chartTag.style.color = bound === 'wall' ? '#d97706' : '#ef4444';

    // Metrics
    m1Lbl.innerHTML = 'اگزرژی ورودی به مرز <span dir="ltr">(Ẋ_in)</span>';
    m2Lbl.innerHTML = 'اگزرژی خروجی از مرز <span dir="ltr">(Ẋ_out)</span>';
    m3Lbl.innerHTML = 'تولید آنتروپی در مرز <span dir="ltr">(Ṡ_gen)</span>';
    m4Lbl.innerHTML = 'انهدام اگزرژی در مرز <span dir="ltr">(Ẋ_dest = T₀ Ṡ_gen)</span>';

    m1Val.textContent = `${activeXin.toFixed(1)} W`;
    m2Val.textContent = `${activeXout.toFixed(1)} W`;
    m3Val.textContent = `${activeSgen.toFixed(4)} W/K`;
    m4Val.textContent = `${activeXdest.toFixed(1)} W`;

    if (bound === 'wall') {
      explainEl.innerHTML = `<strong>حالت الف (فقط خود دیوار):</strong> مرز سیستم دقیقاً روی دو سطح دیوار <span dir="ltr">(20 °C → 5 °C)</span> بسته شده است. تولید آنتروپی فقط ناشی از رسانش داخل آجر است <span dir="ltr">(Ṡ_gen = ${sGenWall.toFixed(4)} W/K)</span> و تخریب اگزرژی برابر <strong><span dir="ltr">Ẋ_dest = ${xDestWall.toFixed(1)} W</span></strong> می‌شود. اما <strong><span dir="ltr">${xDestLayers.toFixed(1)} W</span></strong> دیگر در لایه‌های مرزی هوا بیرون از این مرز در حال تخریب شدن است!`;
    } else {
      explainEl.innerHTML = `<strong>حالت ب (مرز گسترش‌یافته تا <span dir="ltr">T₀</span>):</strong> مرز را به هوای اتاق <span dir="ltr">(27 °C = 300 K)</span> و هوای بیرون <span dir="ltr">(${t0C} °C = ${T0K} K)</span> گسترش دادیم؛ پس <span dir="ltr">Ẋ_out = 0</span> و کل تخریب اگزرژی برابر <strong><span dir="ltr">Ẋ_dest,total = ${xDestExt.toFixed(1)} W</span></strong> <span dir="ltr">(Ṡ_gen = ${sGenExt.toFixed(4)} W/K)</span> است که شامل <strong><span dir="ltr">${xDestWall.toFixed(1)} W</span></strong> درون دیوار + <strong><span dir="ltr">${xDestLayers.toFixed(1)} W</span></strong> در لایه‌های مرزی دو طرف است.`;
    }
  }

  function renderSteam() {
    sceneWall.style.display = 'none';
    sceneSteam.style.display = '';
    chartWall.style.display = 'none';
    chartSteam.style.display = '';

    p1Lbl.textContent = `${p1} kPa`;
    t1Lbl.textContent = `${t1} °C`;
    p2Lbl.textContent = `${p2} kPa`;
    etatLbl.textContent = `${etaT}%`;
    flowNote.innerHTML = `دبی بخار: <span dir="ltr">ṁ = ${mDot} kg/s · P₀ = 100 kPa, T₀ = 25 °C</span>`;

    sysTitle.innerHTML = 'توربین بخار آدیاباتیک <span dir="ltr">(IAPWS-IF97)</span>';
    sysTag.textContent = `ṁ = ${mDot} kg/s`;
    sysTag.style.color = '#0284c7';
    chartTitle.innerHTML = 'آبشار اگزرژی جریان <span dir="ltr">(ψ)</span> و نمودار <span dir="ltr">T-s</span>';

    const st1 = waterPT(p1, t1);
    const st2s = waterPS(p2, st1.s);
    const h2 = st1.h - (etaT / 100) * (st1.h - st2s.h);
    const st2 = waterPH(p2, h2);

    const T0K = deadState.tK;
    const psi1 = st1.h - deadState.h - T0K * (st1.s - deadState.s);
    const psi2 = st2.h - deadState.h - T0K * (st2.s - deadState.s);

    const mPsi1 = mDot * psi1;
    const mPsi2 = mDot * psi2;
    const wOut = mDot * (st1.h - st2.h);
    const wRev = mPsi1 - mPsi2;
    const sGen = mDot * (st2.s - st1.s);
    const xDest = T0K * sGen;
    const eta2 = wRev > 0.01 ? (wOut / wRev) * 100 : 100;

    // Schematic update
    tS1a.textContent = `1: ${(p1 / 1000).toFixed(1)} MPa, ${st1.tC.toFixed(0)}°C`;
    tS1b.textContent = `ψ₁ = ${psi1.toFixed(1)} kJ/kg`;
    tS2a.textContent = `2: ${p2} kPa, ${st2.tC.toFixed(1)}°C`;
    tS2b.textContent = `ψ₂ = ${psi2.toFixed(1)} kJ/kg`;
    tS2c.textContent = st2.x !== null ? `Wet x₂ = ${(st2.x * 100).toFixed(1)}%` : 'Superheated';
    tWout.textContent = `Ẇ_out = ${wOut.toFixed(0)} kW`;
    tXdlbl.textContent = `Ẋ_dest = ${xDest.toFixed(0)} kW`;

    tRotor.setAttribute('transform', `translate(152, 98) rotate(${rotorAngle.toFixed(1)})`);
    tPkt1.setAttribute('cx', (28 + flowPhase * 54).toFixed(1));
    tPkt2.setAttribute('cy', (154 + flowPhase * 40).toFixed(1));

    // Waterfall chart (mPsi1 vs mPsi2 + xDest + wOut)
    const maxVal = Math.max(100, mPsi1, mPsi2 + xDest + wOut);
    stYmax.textContent = maxVal.toFixed(0);
    const baseY = 188;
    const maxH = 150;

    const h1 = (mPsi1 / maxVal) * maxH;
    const hPsi2 = Math.max(0, (mPsi2 / maxVal) * maxH);
    const hXd = Math.max(0, (xDest / maxVal) * maxH);
    const hWu = Math.max(0, (wOut / maxVal) * maxH);

    setBar(stB1, baseY, h1);
    stB1v.setAttribute('y', (baseY - h1 / 2 + 3).toFixed(1));
    stB1v.textContent = mPsi1.toFixed(0);

    setBar(stPsi2, baseY, hPsi2);
    setBar(stXd, baseY - hPsi2, hXd);
    setBar(stWu, baseY - hPsi2 - hXd, hWu);

    stTpsi2.style.display = hPsi2 >= 15 ? '' : 'none';
    stTpsi2.setAttribute('y', (baseY - hPsi2 / 2 + 3).toFixed(1));
    stTpsi2.textContent = `ψ₂ ${mPsi2.toFixed(0)}`;

    stTwu.style.display = hWu >= 15 ? '' : 'none';
    stTwu.setAttribute('y', (baseY - hPsi2 - hXd - hWu / 2 + 3).toFixed(1));
    stTwu.textContent = `Ẇ ${wOut.toFixed(0)}`;

    const yWrevTop = baseY - hPsi2 - hXd - hWu;
    const yWrevBot = baseY - hPsi2;
    if (yWrevBot - yWrevTop > 10) {
      stBr.style.display = '';
      stBrlbl.style.display = '';
      stBr.setAttribute('d', `M 164 ${yWrevTop.toFixed(1)} L 171 ${yWrevTop.toFixed(1)} L 171 ${yWrevBot.toFixed(1)} L 164 ${yWrevBot.toFixed(1)}`);
      stBrlbl.setAttribute('y', ((yWrevTop + yWrevBot) / 2 + 3).toFixed(1));
      stBrlbl.textContent = `Ẇ_rev`;
    } else {
      stBr.style.display = 'none';
      stBrlbl.style.display = 'none';
    }

    // Gauge η_II
    const arcLen = 122.5; // 2 * pi * 26 * (270/360)
    const ratio = Math.max(0, Math.min(1, eta2 / 100));
    const gCol = eta2 >= 88 ? '#059669' : eta2 >= 72 ? '#d97706' : '#ef4444';
    gArc.setAttribute('stroke', gCol);
    gArc.setAttribute('stroke-dasharray', `${(ratio * arcLen).toFixed(1)} 130`);
    setDialNeedle(gNeedle, eta2, 0, 100, 19);
    gVal.textContent = `${eta2.toFixed(1)}%`;
    gVal.setAttribute('fill', gCol);
    chartTag.textContent = `η_II = ${eta2.toFixed(1)}%`;
    chartTag.style.color = gCol;

    // Mini T-s points
    const x0 = tsVp.x(deadState.s);
    const y0 = tsVp.y(deadState.tC);
    const x1 = tsVp.x(st1.s);
    const y1 = tsVp.y(st1.tC);
    const x2s = tsVp.x(st2s.s);
    const y2s = tsVp.y(st2s.tC);
    const x2 = tsVp.x(st2.s);
    const y2 = tsVp.y(st2.tC);

    tsP0.setAttribute('cx', x0.toFixed(1));
    tsP0.setAttribute('cy', y0.toFixed(1));
    tsP1.setAttribute('cx', x1.toFixed(1));
    tsP1.setAttribute('cy', y1.toFixed(1));
    tsP2s.setAttribute('cx', x2s.toFixed(1));
    tsP2s.setAttribute('cy', y2s.toFixed(1));
    tsP2.setAttribute('cx', x2.toFixed(1));
    tsP2.setAttribute('cy', y2.toFixed(1));
    tsIsen.setAttribute('x1', x1.toFixed(1));
    tsIsen.setAttribute('y1', y1.toFixed(1));
    tsIsen.setAttribute('x2', x2s.toFixed(1));
    tsIsen.setAttribute('y2', y2s.toFixed(1));
    tsAct.setAttribute('x1', x1.toFixed(1));
    tsAct.setAttribute('y1', y1.toFixed(1));
    tsAct.setAttribute('x2', x2.toFixed(1));
    tsAct.setAttribute('y2', y2.toFixed(1));

    tsL1.setAttribute('x', (x1 - 5).toFixed(1));
    tsL1.setAttribute('y', (y1 - 3).toFixed(1));
    if (x2 > 300) {
      tsL2.setAttribute('text-anchor', 'end');
      tsL2.setAttribute('x', (x2 - 5).toFixed(1));
    } else {
      tsL2.setAttribute('text-anchor', 'start');
      tsL2.setAttribute('x', (x2 + 5).toFixed(1));
    }
    tsL2.setAttribute('y', (y2 + 4).toFixed(1));

    // Metrics
    m1Lbl.innerHTML = 'اگزرژی جریان ورودی <span dir="ltr">(ṁψ₁ | ψ₁)</span>';
    m2Lbl.innerHTML = 'اگزرژی خروجی بخار <span dir="ltr">(ṁψ₂ | ψ₂)</span>';
    m3Lbl.innerHTML = 'توان واقعی و برگشت‌پذیر <span dir="ltr">(Ẇ_out | Ẇ_rev)</span>';
    m4Lbl.innerHTML = 'تخریب و بازده قانون دوم <span dir="ltr">(Ẋ_dest | η_II)</span>';

    m1Val.textContent = `${mPsi1.toFixed(0)} kW (${psi1.toFixed(1)} kJ/kg)`;
    m2Val.textContent = `${mPsi2.toFixed(0)} kW (${psi2.toFixed(1)} kJ/kg)`;
    m3Val.textContent = `${wOut.toFixed(0)} | ${wRev.toFixed(0)} kW`;
    m4Val.textContent = `${xDest.toFixed(0)} kW | ${eta2.toFixed(1)}%`;

    explainEl.innerHTML = `با خواص دقیق <span dir="ltr">IAPWS-IF97</span> نسبت به حالت مردهٔ <span dir="ltr">(100 kPa, 25 °C)</span>: اگزرژی ویژهٔ بخار ورودی <strong><span dir="ltr">ψ₁ = ${psi1.toFixed(1)} kJ/kg</span></strong> و خروجی <strong><span dir="ltr">ψ₂ = ${psi2.toFixed(1)} kJ/kg</span></strong> است. حداکثر توان قابل استحصال در این افت اگزرژی <strong><span dir="ltr">Ẇ_rev = ṁ(ψ₁ - ψ₂) = ${wRev.toFixed(0)} kW</span></strong> است که با بازده ایزنتروپیک <span dir="ltr">η_T = ${etaT}%</span>، توان واقعی <strong><span dir="ltr">Ẇ_out = ${wOut.toFixed(0)} kW</span></strong> تولید شده و <strong><span dir="ltr">Ẋ_dest = T₀ Ṡ_gen = ${xDest.toFixed(0)} kW</span></strong> <span dir="ltr">(η_II = ${eta2.toFixed(1)}%)</span> منهدم می‌گردد.`;
  }

  function render() {
    if (mode === 'wall-ex87') renderWall();
    else renderSteam();
  }

  const anim = createAnimController(root, (dt) => {
    let needsMore = false;
    const target = bound === 'wall' ? 0 : 1;
    if (Math.abs(boundAnim - target) > 0.005) {
      const dir = target > boundAnim ? 1 : -1;
      boundAnim += dir * dt * 2.5;
      if ((dir > 0 && boundAnim >= target) || (dir < 0 && boundAnim <= target)) {
        boundAnim = target;
      } else {
        needsMore = true;
      }
    } else {
      boundAnim = target;
    }

    if (isFlowPlaying) {
      flowPhase = (flowPhase + dt * 0.65) % 1;
      rotorAngle = (rotorAngle + dt * 150) % 360;
      needsMore = true;
    }

    render();
    if (!needsMore) {
      return false;
    }
    return true;
  });

  // Mode buttons
  root.querySelectorAll<HTMLButtonElement>('#ebb-modes button').forEach((btn) => {
    btn.addEventListener('click', () => {
      mode = (btn.getAttribute('data-mode') || 'wall-ex87') as Mode;
      root.querySelectorAll('#ebb-modes button').forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      wallCtrls.style.display = mode === 'wall-ex87' ? '' : 'none';
      steamCtrls.style.display = mode === 'steam-flow' ? '' : 'none';
      render();
    });
  });

  // Wall boundary toggle
  root.querySelectorAll<HTMLButtonElement>('#ebb-boundary-btns button').forEach((btn) => {
    btn.addEventListener('click', () => {
      bound = (btn.getAttribute('data-bound') || 'wall') as BoundMode;
      root.querySelectorAll('#ebb-boundary-btns button').forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      anim.start();
      render();
    });
  });

  // Steam presets
  root.querySelectorAll<HTMLButtonElement>('#ebb-steam-presets button').forEach((btn) => {
    btn.addEventListener('click', () => {
      const p = btn.getAttribute('data-preset') || 'ex811';
      root.querySelectorAll('#ebb-steam-presets button').forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      if (p === 'ex811') {
        mDot = 8;
        p1 = 3000;
        t1 = 450;
        p2 = 200;
        etaT = 88;
      } else if (p === 'vac') {
        mDot = 8;
        p1 = 3000;
        t1 = 450;
        p2 = 20;
        etaT = 88;
      } else {
        mDot = 1;
      }
      p1El.value = String(p1);
      t1El.value = String(t1);
      p2El.value = String(p2);
      etatEl.value = String(etaT);
      render();
    });
  });

  qdotEl.addEventListener('input', () => {
    qDot = parseFloat(qdotEl.value);
    render();
  });
  t0cEl.addEventListener('input', () => {
    t0C = parseFloat(t0cEl.value);
    render();
  });
  p1El.addEventListener('input', () => {
    p1 = parseFloat(p1El.value);
    render();
  });
  t1El.addEventListener('input', () => {
    t1 = parseFloat(t1El.value);
    render();
  });
  p2El.addEventListener('input', () => {
    p2 = parseFloat(p2El.value);
    render();
  });
  etatEl.addEventListener('input', () => {
    etaT = parseFloat(etatEl.value);
    render();
  });

  playBtn.addEventListener('click', () => {
    isFlowPlaying = !isFlowPlaying;
    if (isFlowPlaying) {
      playBtn.textContent = '⏸ توقف جریان';
      anim.start();
    } else {
      playBtn.textContent = '▶ پخش جریان زنده';
    }
  });

  resetBtn.addEventListener('click', () => {
    isFlowPlaying = false;
    playBtn.textContent = '▶ پخش جریان زنده';
    flowPhase = 0;
    if (mode === 'wall-ex87') {
      qDot = 1035;
      t0C = 0;
      bound = 'wall';
      boundAnim = 0;
      qdotEl.value = '1035';
      t0cEl.value = '0';
      root.querySelectorAll('#ebb-boundary-btns button').forEach((b) => {
        b.classList.toggle('is-active', b.getAttribute('data-bound') === 'wall');
      });
    } else {
      mDot = 8;
      p1 = 3000;
      t1 = 450;
      p2 = 200;
      etaT = 88;
      p1El.value = '3000';
      t1El.value = '450';
      p2El.value = '200';
      etatEl.value = '88';
      root.querySelectorAll('#ebb-steam-presets button').forEach((b) => {
        b.classList.toggle('is-active', b.getAttribute('data-preset') === 'ex811');
      });
    }
    render();
  });

  render();
})();
</script>
