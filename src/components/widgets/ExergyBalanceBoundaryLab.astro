---
// آزمایشگر زنده موازنه اگزرژی، تله انتخاب مرز (مثال ۸-۷) و اگزرژی جریان بخار واقعی با IAPWS-IF97 (فصل ۸)
---

<div class="jh-widget not-content" id="exergy-boundary-lab">
  <div class="jh-widget__head">
    <span class="jh-widget__title">آزمایشگر زندهٔ تراز اگزرژی: تلهٔ انتخاب مرز و توربین بخار واقعی</span>
    <span class="jh-widget__badge">شبیه‌سازی زنده</span>
  </div>
  <div class="jh-widget__sub" style="margin-bottom:0.65rem">
    مقایسهٔ تغییر <span dir="ltr">Ẋ_dest = T₀ Ṡ_gen</span> هنگام جابه‌جایی مرز دیوار <span dir="ltr">(مثال ۸-۷)</span> و تحلیل اگزرژی جریان <span dir="ltr">(ψ)</span> با خواص واقعی <span dir="ltr">IAPWS-IF97</span>
  </div>

  <div class="jh-widget__btns" id="ebb-modes">
    <button type="button" class="jh-widget__btn is-active" data-mode="wall-ex87">۱) مثال ۸-۷: تلهٔ انتخاب مرز در دیواره آجری <span dir="ltr">(Q̇ = 1035 W)</span></button>
    <button type="button" class="jh-widget__btn" data-mode="steam-flow">۲) اگزرژی جریان پایا <span dir="ltr">(ψ)</span> و توربین بخار <span dir="ltr">(IAPWS-IF97)</span></button>
  </div>

  <!-- کنترل‌های حالت ۱: دیوار آجری مثال ۸-۷ -->
  <div id="ebb-wall-ctrls">
    <div class="jh-widget__btns" id="ebb-boundary-btns">
      <button type="button" class="jh-widget__btn is-active" data-bound="wall">مرز الف: فقط خود دیوار <span dir="ltr">(20 °C → 5 °C)</span></button>
      <button type="button" class="jh-widget__btn" data-bound="extended">مرز ب: مرز گسترش‌یافته <span dir="ltr">(اتاق 27 °C → هوای بیرون T₀)</span></button>
    </div>
    <div class="jh-widget__grid">
      <label class="jh-widget__ctrl">
        <span>نرخ انتقال حرارت <span dir="ltr">(Q̇)</span>: <strong id="ebb-qdot-lbl" dir="ltr">1035 W</strong></span>
        <input id="ebb-qdot" type="range" min="400" max="2000" step="15" value="1035" />
      </label>
      <label class="jh-widget__ctrl">
        <span>دمای هوای بیرون / حالت مرده <span dir="ltr">(T₀)</span>: <strong id="ebb-t0c-lbl" dir="ltr">0 °C (273 K)</strong></span>
        <input id="ebb-t0c" type="range" min="-15" max="4" step="1" value="0" />
      </label>
    </div>
  </div>

  <!-- کنترل‌های حالت ۲: توربین بخار جریان پایا -->
  <div id="ebb-steam-ctrls" style="display:none">
    <div class="jh-widget__btns" id="ebb-steam-presets">
      <button type="button" class="jh-widget__btn is-active" data-preset="ex811">مثال ۸-۱۱ <span dir="ltr">(3 MPa, 450°C → 200 kPa, ṁ=8 kg/s)</span></button>
      <button type="button" class="jh-widget__btn" data-preset="vac">توربین خلأ کندانسور <span dir="ltr">(P₂ = 20 kPa, ṁ=8 kg/s)</span></button>
      <button type="button" class="jh-widget__btn" data-preset="unit">بر واحد جرم <span dir="ltr">(ṁ = 1 kg/s)</span></button>
    </div>
    <div class="jh-widget__grid">
      <label class="jh-widget__ctrl">
        <span>فشار ورودی بخار <span dir="ltr">(P₁)</span>: <strong id="ebb-p1-lbl" dir="ltr">3000 kPa</strong></span>
        <input id="ebb-p1" type="range" min="1000" max="8000" step="200" value="3000" />
      </label>
      <label class="jh-widget__ctrl">
        <span>دمای ورودی بخار <span dir="ltr">(T₁)</span>: <strong id="ebb-t1-lbl" dir="ltr">450 °C</strong></span>
        <input id="ebb-t1" type="range" min="320" max="600" step="10" value="450" />
      </label>
      <label class="jh-widget__ctrl">
        <span>فشار خروجی توربین <span dir="ltr">(P₂)</span>: <strong id="ebb-p2-lbl" dir="ltr">200 kPa</strong></span>
        <input id="ebb-p2" type="range" min="10" max="400" step="10" value="200" />
      </label>
      <label class="jh-widget__ctrl">
        <span>بازده ایزنتروپیک <span dir="ltr">(η_T)</span>: <strong id="ebb-etat-lbl" dir="ltr">88%</strong></span>
        <input id="ebb-etat" type="range" min="55" max="100" step="1" value="88" />
      </label>
    </div>
  </div>

  <div class="jh-widget__toolbar">
    <button type="button" class="jh-widget__btn jh-widget__btn--primary" id="ebb-play">▶ پخش جریان زنده</button>
    <button type="button" class="jh-widget__btn" id="ebb-reset">↺ بازنشانی</button>
    <span class="jh-widget__sub" id="ebb-flow-note" style="margin-inline-start:auto">حالت مرده دیوار: <span dir="ltr">T₀ = 0 °C (273 K)</span></span>
  </div>

  <div class="jh-widget__split">
    <!-- پنل ۱: شماتیک فیزیکی (دیوار آجری با مرز متحرک یا توربین بخار) -->
    <div class="jh-widget__pane">
      <div class="jh-widget__pane-title">
        <span id="ebb-sys-title">برش دیواره آجری و پروفیل دما</span>
        <span dir="ltr" id="ebb-sys-tag" style="color:#0284c7">CV: Wall Only</span>
      </div>
      <svg id="ebb-sys-svg" viewBox="0 0 320 230" style="width:100%;height:auto;display:block;direction:ltr" aria-label="برش دیواره آجری و توربین بخار جریان پایا">
        <defs>
          <pattern id="ebb-brick-pat" width="22" height="12" patternUnits="userSpaceOnUse">
            <rect width="22" height="12" fill="#d97706" fill-opacity="0.09" />
            <path d="M 0 6 L 22 6 M 11 0 L 11 6 M 0 6 L 0 12 M 22 6 L 22 12" stroke="#d97706" stroke-opacity="0.28" stroke-width="1" />
          </pattern>
          <marker id="ebb-arr-q" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M 1 2 L 8 5 L 1 8 z" fill="#ef4444" />
          </marker>
          <marker id="ebb-arr-em" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M 1 2 L 8 5 L 1 8 z" fill="#059669" />
          </marker>
          <marker id="ebb-arr-bl" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M 1 2 L 8 5 L 1 8 z" fill="#0284c7" />
          </marker>
        </defs>

        <!-- لایه ۱: دیواره آجری مثال ۸-۷ -->
        <g id="ebb-scene-wall">
          <!-- پس‌زمینه دماهای چپ (اتاق گرم) و راست (هوای سرد بیرون) -->
          <rect x="18" y="38" width="88" height="148" fill="#ef4444" fill-opacity="0.07" rx="4" />
          <rect x="106" y="38" width="108" height="148" fill="url(#ebb-brick-pat)" stroke="currentColor" stroke-opacity="0.55" stroke-width="2.2" />
          <rect x="214" y="38" width="88" height="148" fill="#0284c7" fill-opacity="0.08" rx="4" />

          <!-- خط‌چین لایه‌های مرزی همرفت -->
          <line x1="56" y1="38" x2="56" y2="186" stroke="#ef4444" stroke-opacity="0.24" stroke-dasharray="3 3" />
          <line x1="264" y1="38" x2="264" y2="186" stroke="#0284c7" stroke-opacity="0.24" stroke-dasharray="3 3" />

          <!-- برچسب بالای نواحی -->
          <text x="40" y="54" text-anchor="middle" fill="#ef4444" font-size="8.8" font-weight="800">Room 27°C</text>
          <text x="160" y="54" text-anchor="middle" fill="#d97706" font-size="9" font-weight="800">Brick Wall (30 cm)</text>
          <text id="ebb-w-t0top" x="280" y="54" text-anchor="middle" fill="#0284c7" font-size="8.8" font-weight="800">Out 0°C</text>

          <!-- منحنی زنده پروفیل دما 27 -> 20 -> 5 -> T0 -->
          <polyline id="ebb-w-tline" points="22,82 56,82 106,92 214,115 264,122 298,122" fill="none" stroke="#ef4444" stroke-width="2.5" stroke-linejoin="round" />
          <circle id="ebb-w-n1" cx="56" cy="82" r="3.2" fill="#ef4444" />
          <circle id="ebb-w-n2" cx="106" cy="92" r="3.4" fill="#d97706" />
          <circle id="ebb-w-n3" cx="214" cy="115" r="3.4" fill="#0284c7" />
          <circle id="ebb-w-n4" cx="264" cy="122" r="3.2" fill="#0284c7" />

          <!-- برچسب دماها کنار سطوح -->
          <text x="102" y="106" text-anchor="end" fill="currentColor" font-size="8.5" font-weight="700">20°C</text>
          <text x="218" y="108" text-anchor="start" fill="currentColor" font-size="8.5" font-weight="700">5°C</text>

          <!-- فلش انتقال حرارت Q̇ -->
          <line x1="72" y1="168" x2="248" y2="168" stroke="#ef4444" stroke-width="2.4" marker-end="url(#ebb-arr-q)" />
          <circle id="ebb-w-qpkt" cx="130" cy="168" r="3.5" fill="#ef4444" />
          <text id="ebb-w-qlbl" x="160" y="159" text-anchor="middle" fill="#ef4444" font-size="9.5" font-weight="800">Q̇ = 1035 W</text>

          <!-- جعبه خط‌چین متحرک مرز سیستم (CV Boundary) -->
          <rect id="ebb-cv-box" x="104" y="32" width="112" height="158" rx="6" fill="none" stroke="#0284c7" stroke-width="2.6" stroke-dasharray="7 4" />
          <text id="ebb-cv-tag" x="160" y="21" text-anchor="middle" fill="#0284c7" font-size="9.5" font-weight="800">CV Boundary: 293 K → 278 K</text>

          <!-- نقاط عبور اگزرژی روی مرز چپ و راست -->
          <circle id="ebb-cv-dot-in" cx="104" cy="168" r="4" fill="#0284c7" stroke="#ffffff" stroke-width="1.2" />
          <circle id="ebb-cv-dot-out" cx="216" cy="168" r="4" fill="#059669" stroke="#ffffff" stroke-width="1.2" />

          <!-- کادر خلاصه عبور از مرز در پایین -->
          <rect x="18" y="196" width="284" height="28" rx="7" fill="currentColor" fill-opacity="0.04" stroke="currentColor" stroke-opacity="0.16" />
          <text id="ebb-w-xin" x="68" y="214" text-anchor="middle" fill="#0284c7" font-size="9.2" font-weight="800">Ẋ_in: 70.6 W</text>
          <text id="ebb-w-xdest" x="160" y="214" text-anchor="middle" fill="#d97706" font-size="9.2" font-weight="800">Ẋ_dest: 52.0 W</text>
          <text id="ebb-w-xout" x="252" y="214" text-anchor="middle" fill="#059669" font-size="9.2" font-weight="800">Ẋ_out: 18.6 W</text>
        </g>

        <!-- لایه ۲: توربین بخار جریان پایا (IAPWS-IF97) -->
        <g id="ebb-scene-steam" style="display:none">
          <!-- لوله ورودی بخار داغ (State 1) -->
          <rect x="16" y="76" width="76" height="36" rx="3" fill="#ef4444" fill-opacity="0.18" stroke="currentColor" stroke-opacity="0.65" stroke-width="2" />
          <line x1="28" y1="94" x2="82" y2="94" stroke="#ef4444" stroke-width="2.4" marker-end="url(#ebb-arr-q)" />
          <circle id="ebb-t-pkt1" cx="46" cy="94" r="3.4" fill="#ef4444" />

          <!-- بدنه واگرای توربین -->
          <path d="M 92 66 L 210 40 L 210 156 L 92 122 Z" fill="currentColor" fill-opacity="0.06" stroke="currentColor" stroke-opacity="0.74" stroke-width="3" stroke-linejoin="round" />

          <!-- روتور و پره‌های توربین -->
          <g id="ebb-t-rotor" transform="translate(152, 98)">
            <circle cx="0" cy="0" r="22" fill="#0284c7" fill-opacity="0.14" stroke="#0284c7" stroke-width="1.8" />
            <line x1="-18" y1="0" x2="18" y2="0" stroke="currentColor" stroke-opacity="0.75" stroke-width="2.4" />
            <line x1="0" y1="-18" x2="0" y2="18" stroke="currentColor" stroke-opacity="0.75" stroke-width="2.4" />
            <line x1="-13" y1="-13" x2="13" y2="13" stroke="currentColor" stroke-opacity="0.45" stroke-width="1.8" />
            <line x1="-13" y1="13" x2="13" y2="-13" stroke="currentColor" stroke-opacity="0.45" stroke-width="1.8" />
          </g>

          <!-- شفت خروجی کار به سمت راست -->
          <rect x="210" y="93" width="66" height="10" rx="3" fill="#64748b" stroke="currentColor" stroke-opacity="0.5" />
          <line x1="232" y1="74" x2="292" y2="74" stroke="#059669" stroke-width="3" marker-end="url(#ebb-arr-em)" />
          <text id="ebb-t-wout" x="262" y="64" text-anchor="middle" fill="#059669" font-size="9.5" font-weight="800">Ẇ_out = 4610 kW</text>
          <text id="ebb-t-xdlbl" x="262" y="122" text-anchor="middle" fill="#ef4444" font-size="8.8" font-weight="800">Ẋ_dest = 461 kW</text>

          <!-- لوله خروجی بخار رو به پایین (State 2) -->
          <rect x="174" y="148" width="36" height="54" rx="3" fill="#0284c7" fill-opacity="0.16" stroke="currentColor" stroke-opacity="0.65" stroke-width="2" />
          <line x1="192" y1="154" x2="192" y2="194" stroke="#0284c7" stroke-width="2.4" marker-end="url(#ebb-arr-bl)" />
          <circle id="ebb-t-pkt2" cx="192" cy="172" r="3.4" fill="#0284c7" />

          <!-- کارت برچسب حالت ۱ (بالا چپ) -->
          <rect x="14" y="16" width="118" height="44" rx="7" fill="currentColor" fill-opacity="0.04" stroke="#ef4444" stroke-opacity="0.45" />
          <text id="ebb-t-s1a" x="73" y="33" text-anchor="middle" fill="currentColor" font-size="8.8" font-weight="800">1: 3000 kPa, 450°C</text>
          <text id="ebb-t-s1b" x="73" y="49" text-anchor="middle" fill="#ef4444" font-size="9.2" font-weight="800">ψ₁ = 1236.7 kJ/kg</text>

          <!-- کارت برچسب حالت ۲ (پایین راست) -->
          <rect x="216" y="144" width="96" height="62" rx="7" fill="currentColor" fill-opacity="0.04" stroke="#0284c7" stroke-opacity="0.45" />
          <text id="ebb-t-s2a" x="264" y="162" text-anchor="middle" fill="currentColor" font-size="8.5" font-weight="800">2: 200 kPa, 150°C</text>
          <text id="ebb-t-s2b" x="264" y="178" text-anchor="middle" fill="#0284c7" font-size="9" font-weight="800">ψ₂ = 602.6 kJ/kg</text>
          <text id="ebb-t-s2c" x="264" y="195" text-anchor="middle" fill="#d97706" font-size="8.2" font-weight="700">Superheated</text>

          <!-- باکس حالت مرده (پایین چپ) -->
          <rect x="14" y="176" width="144" height="40" rx="7" fill="#0284c7" fill-opacity="0.08" stroke="#0284c7" stroke-opacity="0.35" />
          <text x="86" y="193" text-anchor="middle" fill="#0284c7" font-size="8.6" font-weight="800">Dead State 0 (IAPWS-IF97)</text>
          <text x="86" y="208" text-anchor="middle" fill="currentColor" fill-opacity="0.75" font-size="8.3" font-weight="700">100 kPa, 25°C → ψ₀ = 0</text>
        </g>
      </svg>
    </div>

    <!-- پنل ۲: نمودار میله‌ای تراز دیوار یا آبشار بخار + T-s و عقربه η_II -->
    <div class="jh-widget__pane">
      <div class="jh-widget__pane-title">
        <span id="ebb-chart-title">تراز نرخ اگزرژی در مرز انتخابی</span>
        <span dir="ltr" id="ebb-chart-tag" style="color:#d97706">Ẋ_dest = 52.0 W</span>
      </div>
      <svg id="ebb-chart-svg" viewBox="0 0 330 230" style="width:100%;height:auto;display:block;direction:ltr" aria-label="نمودار میله‌ای تخریب اگزرژی دیواره و آبشار اگزرژی توربین بخار">
        <!-- لایه A: نمودار میله‌ای دیواره آجری مثال ۸-۷ -->
        <g id="ebb-chart-wall">
          <text id="ebb-wb-eq" x="168" y="20" text-anchor="middle" fill="currentColor" font-size="9.8" font-weight="800">Ẋ_in (70.6) − Ẋ_out (18.6) = Ẋ_dest,CV (52.0 W)</text>
          <g stroke="currentColor" stroke-opacity="0.1" stroke-width="1">
            <line x1="40" y1="44" x2="306" y2="44" />
            <line x1="40" y1="90" x2="306" y2="90" />
            <line x1="40" y1="136" x2="306" y2="136" />
          </g>
          <line x1="40" y1="34" x2="40" y2="182" stroke="currentColor" stroke-opacity="0.45" stroke-width="1.5" />
          <line x1="40" y1="182" x2="308" y2="182" stroke="currentColor" stroke-opacity="0.55" stroke-width="1.8" />
          <text x="34" y="185" text-anchor="end" fill="currentColor" fill-opacity="0.65" font-size="9">0</text>
          <text id="ebb-wb-ymax" x="34" y="48" text-anchor="end" fill="currentColor" fill-opacity="0.65" font-size="9">100</text>

          <!-- ۴ ستون: X_in, X_out, X_dest (wall), X_dest (layers) -->
          <rect id="ebb-wb-1" x="56" y="70" width="44" height="112" rx="4" fill="#0284c7" fill-opacity="0.88" />
          <rect id="ebb-wb-2" x="118" y="152" width="44" height="30" rx="4" fill="#059669" fill-opacity="0.88" />
          <rect id="ebb-wb-3" x="180" y="98" width="44" height="84" rx="4" fill="#d97706" fill-opacity="0.9" />
          <rect id="ebb-wb-4" x="242" y="116" width="44" height="66" rx="4" fill="#ef4444" fill-opacity="0.22" stroke="#ef4444" stroke-dasharray="4 3" stroke-width="1.6" />

          <text id="ebb-wb-v1" x="78" y="63" text-anchor="middle" fill="#0284c7" font-size="9.8" font-weight="800">70.6 W</text>
          <text id="ebb-wb-v2" x="140" y="145" text-anchor="middle" fill="#059669" font-size="9.8" font-weight="800">18.6 W</text>
          <text id="ebb-wb-v3" x="202" y="91" text-anchor="middle" fill="#d97706" font-size="9.8" font-weight="800">52.0 W</text>
          <text id="ebb-wb-v4" x="264" y="109" text-anchor="middle" fill="#ef4444" font-size="9.8" font-weight="800">41.1 W</text>

          <text x="78" y="198" text-anchor="middle" fill="currentColor" font-size="9.5" font-weight="700">Ẋ_in</text>
          <text x="140" y="198" text-anchor="middle" fill="currentColor" font-size="9.5" font-weight="700">Ẋ_out</text>
          <text x="202" y="198" text-anchor="middle" fill="currentColor" font-size="9.2" font-weight="700">Ẋ_dest</text>
          <text x="202" y="211" text-anchor="middle" fill="currentColor" fill-opacity="0.7" font-size="8.2">(wall)</text>
          <text x="264" y="198" text-anchor="middle" fill="currentColor" font-size="9.2" font-weight="700">Ẋ_dest</text>
          <text id="ebb-wb-l4sub" x="264" y="211" text-anchor="middle" fill="#ef4444" font-size="8.2" font-weight="700">(outside CV)</text>
        </g>

        <!-- لایه B: آبشار اگزرژی جریان بخار + گیج η_II + مینی نمودار T-s واقعی -->
        <g id="ebb-chart-steam" style="display:none">
          <!-- محورهای آبشار سمت چپ -->
          <line x1="36" y1="28" x2="36" y2="188" stroke="currentColor" stroke-opacity="0.45" stroke-width="1.5" />
          <line x1="36" y1="188" x2="206" y2="188" stroke="currentColor" stroke-opacity="0.55" stroke-width="1.8" />
          <text x="30" y="191" text-anchor="end" fill="currentColor" fill-opacity="0.65" font-size="8.5">0</text>
          <text id="ebb-st-ymax" x="30" y="42" text-anchor="end" fill="currentColor" fill-opacity="0.65" font-size="8.5">9894</text>

          <!-- ستون ۱: اگزرژی ورودی جریان m_dot * psi_1 -->
          <rect id="ebb-st-b1" x="48" y="38" width="46" height="150" rx="4" fill="#0284c7" fill-opacity="0.2" stroke="#0284c7" stroke-width="1.5" />
          <text id="ebb-st-b1v" x="71" y="116" text-anchor="middle" fill="currentColor" font-size="9" font-weight="800">9894</text>
          <text x="71" y="29" text-anchor="middle" fill="#0284c7" font-size="9.2" font-weight="800">ṁψ₁</text>
          <text x="71" y="202" text-anchor="middle" fill="currentColor" font-size="8.8" font-weight="700">Inlet</text>

          <!-- ستون ۲: تفکیک خروجی (m_dot*psi_2 + X_dest + W_out) -->
          <rect id="ebb-st-psi2" x="114" y="115" width="46" height="73" rx="3" fill="#0284c7" fill-opacity="0.86" />
          <rect id="ebb-st-xd" x="114" y="108" width="46" height="7" rx="2" fill="#ef4444" fill-opacity="0.9" />
          <rect id="ebb-st-wu" x="114" y="38" width="46" height="70" rx="3" fill="#059669" fill-opacity="0.9" />

          <text id="ebb-st-tpsi2" x="137" y="155" text-anchor="middle" fill="#ffffff" font-size="8.6" font-weight="800">ṁψ₂</text>
