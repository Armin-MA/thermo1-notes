  <div class="jh-widget__metrics">
    <div class="jh-metric">
      <span class="jh-metric__label" id="ebb-m1-lbl">اگزرژی ورودی به مرز <span dir="ltr">(Ẋ_in)</span></span>
      <span class="jh-metric__val" id="ebb-m1-val">70.6 W</span>
    </div>
    <div class="jh-metric">
      <span class="jh-metric__label" id="ebb-m2-lbl">اگزرژی خروجی از مرز <span dir="ltr">(Ẋ_out)</span></span>
      <span class="jh-metric__val" id="ebb-m2-val">18.6 W</span>
    </div>
    <div class="jh-metric">
      <span class="jh-metric__label" id="ebb-m3-lbl">تولید آنتروپی در مرز <span dir="ltr">(Ṡ_gen)</span></span>
      <span class="jh-metric__val" id="ebb-m3-val">0.1906 W/K</span>
    </div>
    <div class="jh-metric">
      <span class="jh-metric__label" id="ebb-m4-lbl">انهدام اگزرژی در مرز <span dir="ltr">(Ẋ_dest)</span></span>
