        <text x="172" y="37" text-anchor="middle" fill="#059669" font-size="9.5" font-weight="800">Ideal Gas (Z = 1.0)</text>

        <!-- منحنی‌های T_R = 1.0, 1.1, 1.3, 2.0 -->
        <path id="pz-tr-10" d="" fill="none" stroke="#ef4444" stroke-opacity="0.72" stroke-width="1.7" stroke-dasharray="4 3" />
        <path id="pz-tr-11" d="" fill="none" stroke="#d97706" stroke-opacity="0.78" stroke-width="1.7" stroke-dasharray="4 3" />
        <path id="pz-tr-13" d="" fill="none" stroke="#0284c7" stroke-opacity="0.78" stroke-width="1.7" stroke-dasharray="4 3" />
        <path id="pz-tr-20" d="" fill="none" stroke="#64748b" stroke-opacity="0.78" stroke-width="1.7" stroke-dasharray="4 3" />

        <!-- برچسب منحنی‌های T_R -->
        <text id="pz-lbl-10" x="285" y="176" fill="#ef4444" font-size="8.8" font-weight="700">T_R=1.0</text>
        <text id="pz-lbl-11" x="285" y="148" fill="#d97706" font-size="8.8" font-weight="700">T_R=1.1</text>
        <text id="pz-lbl-13" x="285" y="96" fill="#0284c7" font-size="8.8" font-weight="700">T_R=1.3</text>
        <text id="pz-lbl-20" x="285" y="61" fill="#64748b" font-size="8.8" font-weight="700">T_R=2.0</text>

        <!-- خط‌چین راهنما و نقطه کار زنده -->
        <line id="pz-gx" x1="48" y1="46" x2="48" y2="194" stroke="#d97706" stroke-dasharray="3 3" stroke-width="1.2" />
        <line id="pz-gy" x1="48" y1="46" x2="48" y2="46" stroke="#d97706" stroke-dasharray="3 3" stroke-width="1.2" />
        <circle id="pz-dot" cx="48" cy="46" r="6.5" fill="#d97706" stroke="#ffffff" stroke-width="2" />
        <text id="pz-dot-lbl" x="58" y="34" fill="#d97706" font-size="9.5" font-weight="800">Z = 0.999</text>
      </svg>
    </div>

    <div class="jh-widget__pane">
      <div class="jh-widget__pane-title">
        <span>مقایسهٔ حجم مخصوص (<span dir="ltr">v_ideal</span> در برابر <span dir="ltr">v_actual</span>)</span>
        <span dir="ltr" id="pz-err-tag">Error = 0.1%</span>
      </div>
      <svg id="pz-bar-svg" viewBox="0 0 305 230" style="width:100%;height:auto;display:block;direction:ltr" aria-label="مقایسه حجم مخصوص گاز ایده آل در برابر گاز واقعی و درصد خطا">
        <!-- بخش مقایسه حجم مخصوص -->
        <text x="14" y="24" fill="currentColor" fill-opacity="0.72" font-size="9.5" font-weight="700">SPECIFIC VOLUME (m³/kg)</text>

        <!-- میله v_ideal -->
        <text x="14" y="46" fill="currentColor" font-size="10" font-weight="700">v_ideal = RT/P</text>
        <text id="pz-txt-vid" x="291" y="46" text-anchor="end" fill="#64748b" font-size="10" font-weight="800">68.801</text>
        <rect x="14" y="52" width="277" height="16" rx="5" fill="currentColor" fill-opacity="0.08" />
        <rect id="pz-bar-vid" x="14" y="52" width="277" height="16" rx="5" fill="#64748b" fill-opacity="0.72" />

        <!-- میله v_actual -->
        <text id="pz-lbl-vact" x="14" y="88" fill="currentColor" font-size="10" font-weight="700">v_actual (IAPWS-IF97)</text>
        <text id="pz-txt-vact" x="291" y="88" text-anchor="end" fill="#059669" font-size="10" font-weight="800">68.733</text>
        <rect x="14" y="94" width="277" height="16" rx="5" fill="currentColor" fill-opacity="0.08" />
        <rect id="pz-bar-vact" x="14" y="94" width="276" height="16" rx="5" fill="#059669" fill-opacity="0.86" />

        <!-- میله v_vdw -->
        <text x="14" y="130" fill="currentColor" font-size="10" font-weight="700">v_VdW (Van der Waals EOS)</text>
        <text id="pz-txt-vvdw" x="291" y="130" text-anchor="end" fill="#0284c7" font-size="10" font-weight="800">68.750</text>
        <rect x="14" y="136" width="277" height="16" rx="5" fill="currentColor" fill-opacity="0.08" />
        <rect id="pz-bar-vvdw" x="14" y="136" width="276" height="16" rx="5" fill="#0284c7" fill-opacity="0.78" />

        <!-- خط جداکننده -->
        <line x1="14" y1="164" x2="291" y2="164" stroke="currentColor" stroke-opacity="0.16" stroke-dasharray="4 3" />

        <!-- نوار درصد خطا -->
        <text x="14" y="183" fill="currentColor" font-size="10.5" font-weight="800">IDEAL-GAS ERROR (%)</text>
        <text id="pz-err-pct" x="291" y="183" text-anchor="end" fill="#059669" font-size="12" font-weight="800">0.10%</text>
        <rect x="14" y="191" width="277" height="18" rx="6" fill="currentColor" fill-opacity="0.1" />
        <rect id="pz-err-bar" x="14" y="191" width="4" height="18" rx="6" fill="#059669" />
        <text x="14" y="222" fill="currentColor" fill-opacity="0.6" font-size="8.5">0% (Exact)</text>
        <text x="152" y="222" text-anchor="middle" fill="currentColor" fill-opacity="0.6" font-size="8.5">50%</text>
        <text x="291" y="222" text-anchor="end" fill="currentColor" fill-opacity="0.6" font-size="8.5">100%+</text>
      </svg>
    </div>
  </div>

  <div class="jh-widget__metrics">
    <div class="jh-metric">
      <span class="jh-metric__label">دمای کاهیده (<span dir="ltr">T_R = T/T_cr</span>)</span>
      <span class="jh-metric__val" id="pz-tr">0.461</span>
    </div>
    <div class="jh-metric">
      <span class="jh-metric__label">فشار کاهیده (<span dir="ltr">P_R = P/P_cr</span>)</span>
      <span class="jh-metric__val" id="pz-pr">0.0001</span>
    </div>
    <div class="jh-metric">
      <span class="jh-metric__label">ضریب تراکم‌پذیری (<span dir="ltr">Z</span>)</span>
      <span class="jh-metric__val" id="pz-zval">0.9990</span>
    </div>
    <div class="jh-metric" id="pz-m-err-card">
      <span class="jh-metric__label">اعتبار تقریب گاز ایده‌آل</span>
      <span class="jh-metric__val" id="pz-status" style="direction:rtl;text-align:right">دقیق (خطا 0.1%)</span>
    </div>
  </div>

  <div class="jh-widget__explain" id="pz-explain"></div>
</div>

<script>
import { waterPT, WATER_CRIT, IDEAL_GASES } from '../../lib/thermoProps';
import { createViewport } from '../../lib/liveSimKit';

const root = document.getElementById('phase-z-widget');
if (root) {
  type FluidKey = 'water' | 'r134a' | 'co2' | 'n2';

  interface FluidDef {
    key: FluidKey;
    nameFa: string;
    R: number;
    Tcr: number;
    PcrKpa: number;
    omega: number;
  }

  const FLUIDS: Record<FluidKey, FluidDef> = {
    water: {
      key: 'water',
      nameFa: 'بخار آب (H₂O)',
      R: 0.46152,
      Tcr: WATER_CRIT.T_K,
      PcrKpa: WATER_CRIT.P_KPA,
      omega: 0.344,
    },
    r134a: {
      key: 'r134a',
      nameFa: 'مبرد R-134a',
      R: 0.0815,
      Tcr: 374.2,
      PcrKpa: 4059,
      omega: 0.326,
    },
    co2: {
      key: 'co2',
      nameFa: IDEAL_GASES.co2.nameFa + ' (CO₂)',
      R: IDEAL_GASES.co2.R,
      Tcr: IDEAL_GASES.co2.Tcr,
      PcrKpa: IDEAL_GASES.co2.PcrKpa,
      omega: 0.225,
    },
    n2: {
      key: 'n2',
      nameFa: IDEAL_GASES.n2.nameFa + ' (N₂)',
      R: IDEAL_GASES.n2.R,
      Tcr: IDEAL_GASES.n2.Tcr,
      PcrKpa: IDEAL_GASES.n2.PcrKpa,
      omega: 0.037,
    },
  };

  const P_MIN = 2;
  const P_MAX = 30000;
  const LOG_P_RATIO = Math.log(P_MAX / P_MIN);

  let fluidKey: FluidKey = 'water';
  let tempK = 298.15;
  let pressKpa = 2.0;

  const tSlider = root.querySelector('#pz-t') as HTMLInputElement;
  const pSlider = root.querySelector('#pz-p') as HTMLInputElement;
  const tLbl = root.querySelector('#pz-t-lbl')!;
  const pLbl = root.querySelector('#pz-p-lbl')!;
  const chartTag = root.querySelector('#pz-chart-tag')!;
  const errTag = root.querySelector('#pz-err-tag')!;

  const tr10 = root.querySelector('#pz-tr-10')!;
  const tr11 = root.querySelector('#pz-tr-11')!;
  const tr13 = root.querySelector('#pz-tr-13')!;
  const tr20 = root.querySelector('#pz-tr-20')!;
  const gx = root.querySelector('#pz-gx')!;
  const gy = root.querySelector('#pz-gy')!;
  const dot = root.querySelector('#pz-dot')!;
  const dotLbl = root.querySelector('#pz-dot-lbl')!;

  const txtVid = root.querySelector('#pz-txt-vid')!;
  const barVid = root.querySelector('#pz-bar-vid')!;
  const lblVact = root.querySelector('#pz-lbl-vact')!;
  const txtVact = root.querySelector('#pz-txt-vact')!;
  const barVact = root.querySelector('#pz-bar-vact')!;
  const txtVvdw = root.querySelector('#pz-txt-vvdw')!;
  const barVvdw = root.querySelector('#pz-bar-vvdw')!;
  const errPct = root.querySelector('#pz-err-pct')!;
  const errBar = root.querySelector('#pz-err-bar')!;

  const trEl = root.querySelector('#pz-tr')!;
  const prEl = root.querySelector('#pz-pr')!;
  const zEl = root.querySelector('#pz-zval')!;
  const mErrCard = root.querySelector('#pz-m-err-card')!;
  const statusEl = root.querySelector('#pz-status')!;
  const explainEl = root.querySelector('#pz-explain')!;

  const vp = createViewport(0, 2.0, 0.2, 1.15, 48, 344, 194, 18);

  /** محاسبه Z عمومی از معادله پنگ-رابینسون برای رسم منحنی‌های مرجع T_R */
  function pengRobinsonZ(Tr: number, Pr: number, omega = 0.04, pickMax = false): number {
    if (Pr < 1e-4) return 1.0;
    const kappa = 0.37464 + 1.54226 * omega - 0.26992 * omega * omega;
    const alpha = Math.pow(1 + kappa * (1 - Math.sqrt(Tr)), 2);
    const A = (0.45724 * alpha * Pr) / (Tr * Tr);
    const B = (0.0778 * Pr) / Tr;
    const c2 = -(1 - B);
    const c1 = A - 3 * B * B - 2 * B;
    const c0 = -(A * B - B * B - B * B * B);
    const p = c1 - (c2 * c2) / 3;
    const q = (2 * c2 * c2 * c2) / 27 - (c2 * c1) / 3 + c0;
    const D = (q * q) / 4 + (p * p * p) / 27;
    if (D >= 0) {
      const u = Math.cbrt(-q / 2 + Math.sqrt(D));
      const v = Math.cbrt(-q / 2 - Math.sqrt(D));
      return Math.max(B + 0.01, u + v - c2 / 3);
    }
    const r = Math.sqrt((-p * p * p) / 27);
    const phi = Math.acos(Math.max(-1, Math.min(1, -q / (2 * r))));
    const m = 2 * Math.cbrt(r);
    const roots = [
      m * Math.cos(phi / 3) - c2 / 3,
      m * Math.cos((phi + 2 * Math.PI) / 3) - c2 / 3,
      m * Math.cos((phi + 4 * Math.PI) / 3) - c2 / 3,
    ].filter((z) => z > B);
    if (!roots.length) return 1.0;
    if (pickMax) return Math.max(...roots);
    return Pr > 1.0 ? Math.min(...roots) : Math.max(...roots);
  }

  /** حل معادله حالت وان‌دروالس بر حسب ضریب Z بی‌بعد */
  function vdwZ(Tr: number, Pr: number): number {
    if (Pr < 1e-4) return 1.0;
    const A = (27 / 64) * (Pr / (Tr * Tr));
    const B = (1 / 8) * (Pr / Tr);
    const c2 = -(1 + B);
    const c1 = A;
    const c0 = -A * B;
    const p = c1 - (c2 * c2) / 3;
    const q = (2 * c2 * c2 * c2) / 27 - (c2 * c1) / 3 + c0;
    const D = (q * q) / 4 + (p * p * p) / 27;
    if (D >= 0) {
      const u = Math.cbrt(-q / 2 + Math.sqrt(D));
      const v = Math.cbrt(-q / 2 - Math.sqrt(D));
      return Math.max(B + 0.01, u + v - c2 / 3);
    }
    const r = Math.sqrt((-p * p * p) / 27);
    const phi = Math.acos(Math.max(-1, Math.min(1, -q / (2 * r))));
    const m = 2 * Math.cbrt(r);
    const roots = [
      m * Math.cos(phi / 3) - c2 / 3,
      m * Math.cos((phi + 2 * Math.PI) / 3) - c2 / 3,
      m * Math.cos((phi + 4 * Math.PI) / 3) - c2 / 3,
    ].filter((z) => z > B);
    return roots.length ? Math.max(...roots) : 1.0;
  }

  function buildTrCurve(Tr: number): string {
    const pts: Array<[number, number]> = [];
    for (let i = 0; i <= 40; i++) {
      const Pr = (i / 40) * 2.0;
      const Z = pengRobinsonZ(Tr, Pr, 0.04, false);
      pts.push([Pr, Math.max(0.21, Math.min(1.13, Z))]);
    }
    return vp.path(pts);
  }

  function pToSlider(p: number): number {
    return Math.round((Math.log(Math.max(P_MIN, Math.min(P_MAX, p)) / P_MIN) / LOG_P_RATIO) * 1000);
  }

  function sliderToP(val: number): number {
    const raw = P_MIN * Math.pow(P_MAX / P_MIN, val / 1000);
    if (raw < 20) return Math.round(raw * 2) / 2;
    if (raw < 200) return Math.round(raw);
    if (raw < 2000) return Math.round(raw / 10) * 10;
    return Math.round(raw / 100) * 100;
  }

  function fmtV(v: number): string {
    if (v >= 10) return v.toFixed(2);
    if (v >= 1) return v.toFixed(3);
    if (v >= 0.05) return v.toFixed(4);
    return v.toFixed(5);
  }

  function fmtP(p: number): string {
    if (p >= 1000) return `${(p / 1000).toFixed(p >= 10000 ? 1 : 2)} MPa`;
    return `${p.toFixed(p < 20 ? 1 : 0)} kPa`;
  }

  function renderReferenceCurves() {
    tr10.setAttribute('d', buildTrCurve(1.0));
    tr11.setAttribute('d', buildTrCurve(1.1));
    tr13.setAttribute('d', buildTrCurve(1.3));
    tr20.setAttribute('d', buildTrCurve(2.0));
  }

  function update() {
    const fl = FLUIDS[fluidKey];
    const tC = tempK - 273.15;
    tLbl.textContent = `${tempK.toFixed(1)} K (${tC.toFixed(1)} °C)`;
    pLbl.textContent = fmtP(pressKpa);
    tSlider.value = String(Math.round(tempK));
    pSlider.value = String(pToSlider(pressKpa));

    const Tr = tempK / fl.Tcr;
    const Pr = pressKpa / fl.PcrKpa;
    const vIdeal = (fl.R * tempK) / pressKpa;
    const zVdw = vdwZ(Tr, Pr);
    const vVdw = zVdw * vIdeal;

    let vActual = vVdw;
    let srcLabel = 'v_actual (Peng-Robinson / Chart)';
    let extraTag = '';
    let isLiquid = false;

    if (fluidKey === 'water') {
      const w = waterPT(pressKpa, tC);
      vActual = w.v;
      srcLabel = 'v_actual (IAPWS-IF97)';
      isLiquid = w.phase === 'مایع متراکم';
    } else if (
      fluidKey === 'r134a' &&
      Math.abs(pressKpa - 1000) < 15 &&
      Math.abs(tC - 50) < 1.5
    ) {
      vActual = 0.021796;
      srcLabel = 'v_actual (Table A-13)';
      extraTag = ' | A-15 Chart Z = 0.84';
    } else {
      const zPr = pengRobinsonZ(Tr, Pr, fl.omega, true);
      vActual = zPr * vIdeal;
      srcLabel = 'v_actual (Real EOS)';
    }

    const Z = vActual / vIdeal;
    const errVal = (Math.abs(vIdeal - vActual) / Math.max(1e-7, vActual)) * 100;

    trEl.textContent = Tr.toFixed(3);
    prEl.textContent = Pr < 0.01 ? Pr.toFixed(4) : Pr.toFixed(3);
    zEl.textContent = Z.toFixed(4);
    chartTag.textContent = `P_R = ${Pr < 0.01 ? Pr.toFixed(4) : Pr.toFixed(3)} | Z = ${Z.toFixed(3)}`;
    errTag.textContent = `Error = ${errVal < 1 ? errVal.toFixed(2) : errVal.toFixed(1)}%`;

    // موقعیت نقطه روی نمودار Z
    const clampedPr = Math.min(1.98, Math.max(0.005, Pr));
    const clampedZ = Math.min(1.13, Math.max(0.21, Z));
    const cx = vp.x(clampedPr);
    const cy = vp.y(clampedZ);
    dot.setAttribute('cx', cx.toFixed(1));
    dot.setAttribute('cy', cy.toFixed(1));

    let dotColor = '#059669';
    if (errVal > 15 || isLiquid) dotColor = '#ef4444';
    else if (errVal > 2) dotColor = '#d97706';

    dot.setAttribute('fill', dotColor);
    gx.setAttribute('x1', cx.toFixed(1));
    gx.setAttribute('x2', cx.toFixed(1));
    gx.setAttribute('y1', cy.toFixed(1));
    gy.setAttribute('y1', cy.toFixed(1));
    gy.setAttribute('y2', cy.toFixed(1));
    gy.setAttribute('x2', cx.toFixed(1));

    const rightSide = cx > 240;
    const lblX = rightSide ? cx - 10 : cx + 10;
    const lblY = cy < 36 ? 26 : cy - 10;
    dotLbl.setAttribute('text-anchor', rightSide ? 'end' : 'start');
    dotLbl.setAttribute('x', lblX.toFixed(1));
    dotLbl.setAttribute('y', lblY.toFixed(1));
    dotLbl.setAttribute('fill', dotColor);
    dotLbl.textContent = `Z = ${Z.toFixed(3)}`;

    // مقایسه میله‌ای حجم مخصوص
    const maxV = Math.max(vIdeal, vActual, vVdw, 1e-6);
    const wMax = 277;
    barVid.setAttribute('width', Math.max(4, (vIdeal / maxV) * wMax).toFixed(1));
    barVact.setAttribute('width', Math.max(4, (vActual / maxV) * wMax).toFixed(1));
    barVvdw.setAttribute('width', Math.max(4, (vVdw / maxV) * wMax).toFixed(1));
    barVact.setAttribute('fill', dotColor);

    lblVact.textContent = srcLabel;
    txtVid.textContent = `${fmtV(vIdeal)} m³/kg`;
    txtVact.textContent = `${fmtV(vActual)} m³/kg`;
    txtVact.setAttribute('fill', dotColor);
    txtVvdw.textContent = `${fmtV(vVdw)} m³/kg`;

    errPct.textContent = `${errVal < 1 ? errVal.toFixed(2) : errVal.toFixed(1)}%`;
    errPct.setAttribute('fill', dotColor);
    errBar.setAttribute('fill', dotColor);
    errBar.setAttribute('width', Math.max(4, Math.min(1, errVal / 100) * wMax).toFixed(1));

    // کارت وضعیت
    mErrCard.classList.toggle('jh-metric--warn', errVal >= 10 || isLiquid);
    if (isLiquid) {
      statusEl.textContent = 'مایع متراکم! (گاز ایده‌آل بی‌معنا)';
    } else if (errVal < 1.5) {
      statusEl.textContent = `دقیق (خطا ${errVal.toFixed(2)}% — Z ≈ 1)`;
    } else if (errVal < 10) {
      statusEl.textContent = `خطای متوسط (${errVal.toFixed(1)}% — نمودار Z بهتر است)`;
    } else {
      statusEl.textContent = `خطای شدید (${errVal.toFixed(1)}% — نیازمند Z یا جدول!)`;
    }

    if (isLiquid) {
      explainEl.innerHTML = `در شرایط <span dir="ltr">${fl.nameFa}</span> (<span dir="ltr">T = ${tC.toFixed(1)} °C, P = ${fmtP(pressKpa)}</span>)، سیال اصلاً گاز نیست و در ناحیهٔ <strong>مایع متراکم</strong> قرار دارد (<span dir="ltr">v = ${fmtV(vActual)} m³/kg</span>)؛ استفاده از معادلهٔ گاز ایده‌آل در این ناحیه کاملاً غلط است!`;
    } else if (errVal < 1.0) {
      explainEl.innerHTML = `با وجود آنکه دمای کاهیده پایین است (<span dir="ltr">T_R = ${Tr.toFixed(2)}</span>)، چون فشار کاهیده بسیار ناچیز است (<span dir="ltr">P_R = ${Pr.toFixed(4)} &lt;&lt; 1</span>)، ضریب تراکم‌پذیری <strong><span dir="ltr">Z = ${Z.toFixed(4)}</span></strong> و خطای فرض گاز ایده‌آل تنها <strong><span dir="ltr">${errVal.toFixed(2)}%</span></strong> است! (توجیه علمی اسلاید ۲۹ برای بخار آب در هوای اتاق).`;
    } else if (Z >= 1.0) {
      explainEl.innerHTML = `در این حالت <span dir="ltr">P_R = ${Pr.toFixed(3)}</span> و <span dir="ltr">T_R = ${Tr.toFixed(3)}</span>، دافعهٔ بین‌مولکولی و حجم محدود مولکول‌ها حجم واقعی (<span dir="ltr">${fmtV(vActual)}</span>) را نسبت به پیش‌بینی گاز ایده‌آل (<span dir="ltr">${fmtV(vIdeal)}</span>) بزرگ‌تر کرده است (<span dir="ltr">Z = ${Z.toFixed(3)}${extraTag}</span>). فرض گاز ایده‌آل <strong><span dir="ltr">${errVal.toFixed(1)}%</span></strong> خطا ایجاد می‌کند!`;
    } else {
      explainEl.innerHTML = `در این حالت <span dir="ltr">P_R = ${Pr.toFixed(3)}</span> و <span dir="ltr">T_R = ${Tr.toFixed(3)}</span>، جاذبهٔ بین‌مولکولی حجم واقعی (<span dir="ltr">${fmtV(vActual)}</span>) را نسبت به پیش‌بینی گاز ایده‌آل (<span dir="ltr">${fmtV(vIdeal)}</span>) فشرده‌تر کرده است (<span dir="ltr">Z = ${Z.toFixed(3)}${extraTag}</span>). فرض گاز ایده‌آل <strong><span dir="ltr">${errVal.toFixed(1)}%</span></strong> خطا ایجاد می‌کند!`;
    }
  }

  function syncButtons() {
    root.querySelectorAll('#pz-fluids button').forEach((b) => {
      b.classList.toggle('is-active', b.getAttribute('data-fluid') === fluidKey);
    });
  }

  root.querySelectorAll('#pz-presets button').forEach((btn) => {
    btn.addEventListener('click', () => {
      root.querySelectorAll('#pz-presets button').forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      const key = btn.getAttribute('data-preset');
      if (key === 'room') {
        fluidKey = 'water';
        tempK = 298.15;
        pressKpa = 2;
      } else if (key === 'ex37') {
        fluidKey = 'r134a';
        tempK = 323.15;
        pressKpa = 1000;
      } else if (key === 'ex382') {
        fluidKey = 'water';
        tempK = 623.15;
        pressKpa = 15000;
      } else if (key === 'supercrit') {
        fluidKey = 'water';
        tempK = 693.15;
        pressKpa = 25000;
      }
      syncButtons();
      update();
    });
  });

  root.querySelectorAll('#pz-fluids button').forEach((btn) => {
    btn.addEventListener('click', () => {
      fluidKey = (btn.getAttribute('data-fluid') as FluidKey) || 'water';
      root.querySelectorAll('#pz-presets button').forEach((b) => b.classList.remove('is-active'));
      syncButtons();
      update();
    });
  });

  tSlider.addEventListener('input', () => {
    root.querySelectorAll('#pz-presets button').forEach((b) => b.classList.remove('is-active'));
    tempK = parseFloat(tSlider.value);
    update();
  });

  pSlider.addEventListener('input', () => {
    root.querySelectorAll('#pz-presets button').forEach((b) => b.classList.remove('is-active'));
    pressKpa = sliderToP(parseFloat(pSlider.value));
    update();
  });

  renderReferenceCurves();
  update();
}
</script>
