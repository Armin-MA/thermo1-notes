---
// آزمایشگر جامع چرخه کارنو، برگشت‌پذیری پیستون (اسلاید ۲۸) و دو موتور متوالی (فصل ۶)
---

<div class="jh-widget not-content" id="carnot-ts-widget">
  <div class="jh-widget__head">
    <span class="jh-widget__title">آزمایشگر زندهٔ چرخهٔ کارنو، برگشت‌پذیری پیستون و موتورهای متوالی</span>
    <span class="jh-widget__badge">شبیه‌سازی زنده</span>
  </div>
  <div class="jh-widget__sub" style="margin-bottom:0.65rem">
    بازپخش ۴ مرحلهٔ سیلندر–پیستون کارنو روی نمودار <span dir="ltr">T-s</span>، شبیه‌سازی مولکولی پیستون آهسته در برابر سریع و بهینه‌سازی دمای میانی <span dir="ltr">T₂</span>
  </div>

  <div class="jh-widget__btns" id="ct-tabs">
    <button type="button" class="jh-widget__btn is-active" data-tab="carnot">۱) چرخهٔ کارنو (۴ مرحله + <span dir="ltr">T-s</span>)</button>
    <button type="button" class="jh-widget__btn" data-tab="reversibility">۲) پیستون آهسته در برابر سریع (اسلاید ۲۸)</button>
    <button type="button" class="jh-widget__btn" data-tab="series">۳) دو موتور متوالی (<span dir="ltr">W</span> برابر <span dir="ltr">vs</span> <span dir="ltr">η</span> برابر)</button>
  </div>

  <!-- کنترل‌های تب ۱: کارنو -->
  <div id="ct-panel-carnot">
    <div class="jh-widget__grid">
      <label class="jh-widget__ctrl">
        <span>دمای منبع گرم (<span dir="ltr">T_H</span>): <strong id="ct-th-lbl" dir="ltr">800 K</strong></span>
        <input id="ct-th" type="range" min="400" max="1500" step="20" value="800" />
      </label>
      <label class="jh-widget__ctrl">
        <span>دمای منبع سرد (<span dir="ltr">T_L</span>): <strong id="ct-tl-lbl" dir="ltr">300 K</strong></span>
        <input id="ct-tl" type="range" min="200" max="380" step="10" value="300" />
      </label>
    </div>
    <div class="jh-widget__toolbar">
      <button type="button" class="jh-widget__btn jh-widget__btn--primary" id="ct-c-play">⏸ توقف چرخه</button>
      <button type="button" class="jh-widget__btn" id="ct-c-reset">↺ شروع از نقطهٔ ۱</button>
      <label class="jh-widget__ctrl" style="flex:1;min-width:170px">
        <span>فاز چرخه (<span dir="ltr">1→2→3→4→1</span>): <strong id="ct-c-phase-lbl" dir="ltr">1→2 Isothermal (T_H)</strong></span>
        <input id="ct-c-scrub" type="range" min="0" max="100" step="0.5" value="12" />
      </label>
    </div>
  </div>

  <!-- کنترل‌های تب ۲: پیستون آهسته در برابر سریع -->
  <div id="ct-panel-rev" style="display:none">
    <div class="jh-widget__grid">
      <label class="jh-widget__ctrl">
        <span>شدت سرعت پیستون سریع (ضریب موج شوک): <strong id="ct-r-spd-lbl" dir="ltr">5.0×</strong></span>
        <input id="ct-r-spd" type="range" min="2" max="8" step="0.5" value="5" />
      </label>
      <label class="jh-widget__ctrl">
        <span>موقعیت کورس رفت‌وبرگشت (<span dir="ltr">0→100%</span>): <strong id="ct-r-pos-lbl" dir="ltr">Compression</strong></span>
        <input id="ct-r-scrub" type="range" min="0" max="100" step="1" value="25" />
      </label>
    </div>
    <div class="jh-widget__toolbar">
      <button type="button" class="jh-widget__btn jh-widget__btn--primary" id="ct-r-play">⏸ توقف رفت‌وبرگشت</button>
      <button type="button" class="jh-widget__btn" id="ct-r-reset">↺ بازنشانی</button>
    </div>
  </div>

  <!-- کنترل‌های تب ۳: دو موتور متوالی -->
  <div id="ct-panel-series" style="display:none">
    <div class="jh-widget__grid">
      <label class="jh-widget__ctrl">
        <span>دمای منبع اول (<span dir="ltr">T₁</span>): <strong id="ct-s-t1-lbl" dir="ltr">1000 K</strong></span>
        <input id="ct-s-t1" type="range" min="700" max="1500" step="20" value="1000" />
      </label>
      <label class="jh-widget__ctrl">
        <span>دمای میانی (<span dir="ltr">T₂</span>): <strong id="ct-s-t2-lbl" dir="ltr">650 K</strong></span>
        <input id="ct-s-t2" type="range" min="330" max="970" step="5" value="650" />
      </label>
      <label class="jh-widget__ctrl">
        <span>دمای چاه آخر (<span dir="ltr">T₃</span>): <strong id="ct-s-t3-lbl" dir="ltr">300 K</strong></span>
        <input id="ct-s-t3" type="range" min="200" max="500" step="10" value="300" />
      </label>
    </div>
    <div class="jh-widget__toolbar">
      <button type="button" class="jh-widget__btn jh-widget__btn--primary" id="ct-s-eqw">🎯 کار مساوی: <span dir="ltr">T₂ = (T₁+T₃)/2</span></button>
      <button type="button" class="jh-widget__btn" id="ct-s-eqeta">🎯 بازده مساوی: <span dir="ltr">T₂ = √(T₁·T₃)</span></button>
    </div>
  </div>

  <!-- نمایشگر دوگانه -->
  <div class="jh-widget__split">
    <!-- پنل ۱ -->
    <div class="jh-widget__pane">
      <div class="jh-widget__pane-title">
        <span id="ct-p1-title">سیلندر–پیستون کارنو (اتصال به مخازن و عایق)</span>
        <span dir="ltr" id="ct-p1-tag">T = 800 K</span>
      </div>

      <!-- SVG تب ۱: سیلندر کارنو -->
      <svg id="ct-svg-carnot-cyl" viewBox="0 0 280 236" style="width:100%;height:auto;display:block;direction:ltr" aria-label="انیمیشن ۴ مرحله ای سیلندر پیستون کارنو">
        <defs>
          <marker id="ct-arr-q" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5" markerHeight="5" orient="auto">
            <path d="M 1 1.5 L 8.5 5 L 1 8.5 z" fill="currentColor" />
          </marker>
        </defs>
        <!-- برچسب مرحله -->
        <text id="ct-cyl-stage" x="120" y="16" text-anchor="middle" fill="currentColor" font-size="11" font-weight="800">1 → 2 : Isothermal Expansion (T_H)</text>

        <!-- دیواره سیلندر -->
        <rect id="ct-cyl-gas" x="62" y="100" width="116" height="80" fill="#ef4444" fill-opacity="0.22" rx="2" />
        <g id="ct-cyl-particles"></g>
        <path d="M 58 30 L 58 182 L 182 182 L 182 30" fill="none" stroke="currentColor" stroke-opacity="0.72" stroke-width="5" stroke-linejoin="round" />

        <!-- پیستون و میله -->
        <g id="ct-cyl-piston">
          <rect id="ct-cyl-rod" x="114" y="18" width="12" height="72" rx="3" fill="currentColor" fill-opacity="0.4" />
          <rect id="ct-cyl-head" x="60" y="88" width="120" height="14" rx="3" fill="#64748b" stroke="currentColor" stroke-opacity="0.65" stroke-width="1.5" />
        </g>

        <!-- کف سیلندر: مخزن گرم / عایق / مخزن سرد -->
        <g id="ct-dock-hot">
          <rect x="54" y="188" width="132" height="36" rx="7" fill="#ef4444" fill-opacity="0.2" stroke="#ef4444" stroke-width="2" />
          <text id="ct-dock-hot-txt" x="120" y="212" text-anchor="middle" fill="#ef4444" font-size="11" font-weight="800">Hot Reservoir (T_H)</text>
          <path d="M 94 192 L 94 172 M 120 192 L 120 172 M 146 192 L 146 172" stroke="#ef4444" stroke-width="2.2" stroke-linecap="round" />
          <path d="M 90 176 L 94 170 L 98 176 M 116 176 L 120 170 L 124 176 M 142 176 L 146 170 L 150 176" fill="none" stroke="#ef4444" stroke-width="2" />
        </g>
        <g id="ct-dock-cold" style="display:none">
          <rect x="54" y="188" width="132" height="36" rx="7" fill="#0284c7" fill-opacity="0.2" stroke="#0284c7" stroke-width="2" />
          <text id="ct-dock-cold-txt" x="120" y="212" text-anchor="middle" fill="#0284c7" font-size="11" font-weight="800">Cold Reservoir (T_L)</text>
          <path d="M 94 172 L 94 192 M 120 172 L 120 192 M 146 172 L 146 192" stroke="#0284c7" stroke-width="2.2" stroke-linecap="round" />
          <path d="M 90 187 L 94 193 L 98 187 M 116 187 L 120 193 L 124 187 M 142 187 L 146 193 L 150 187" fill="none" stroke="#0284c7" stroke-width="2" />
        </g>
        <g id="ct-dock-ins" style="display:none">
          <rect x="54" y="188" width="132" height="36" rx="7" fill="currentColor" fill-opacity="0.14" stroke="#d97706" stroke-width="2" stroke-dasharray="5 3" />
          <text x="120" y="210" text-anchor="middle" fill="#d97706" font-size="11" font-weight="800">Adiabatic Insulator (Q = 0)</text>
        </g>

        <!-- دماسنج جیوه ای -->
        <g transform="translate(232, 34)">
          <rect x="-7" y="4" width="14" height="104" rx="7" fill="currentColor" fill-opacity="0.08" stroke="currentColor" stroke-opacity="0.45" stroke-width="1.5" />
          <circle id="ct-cyl-bulb" cx="0" cy="116" r="11" fill="#ef4444" stroke="currentColor" stroke-opacity="0.45" stroke-width="1.5" />
          <rect id="ct-cyl-merc" x="-3.5" y="24" width="7" height="86" rx="3" fill="#ef4444" />
          <text id="ct-cyl-tlbl" x="0" y="144" text-anchor="middle" fill="#ef4444" font-size="11.5" font-weight="800">800 K</text>
          <text x="0" y="-4" text-anchor="middle" fill="currentColor" fill-opacity="0.65" font-size="9" font-weight="700">T_gas</text>
        </g>
      </svg>

      <!-- SVG تب ۲: پیستون آهسته -->
      <svg id="ct-svg-rev-slow" viewBox="0 0 300 220" style="width:100%;height:auto;display:none;direction:ltr" aria-label="پیستون آهسته شبه‌تعادلی با توزیع فشار یکنواخت">
        <text x="150" y="18" text-anchor="middle" fill="#059669" font-size="11.5" font-weight="800">Slow Quasi-Equilibrium (S_gen = 0)</text>
        <!-- سیلندر افقی -->
        <rect id="ct-rs-gas" x="26" y="34" width="170" height="92" fill="#059669" fill-opacity="0.16" rx="2" />
        <g id="ct-rs-particles"></g>
        <path d="M 272 32 L 24 32 L 24 128 L 272 128" fill="none" stroke="currentColor" stroke-opacity="0.72" stroke-width="4" stroke-linejoin="round" />
        <g id="ct-rs-piston">
          <rect id="ct-rs-head" x="196" y="34" width="12" height="92" rx="2" fill="#64748b" stroke="currentColor" stroke-opacity="0.65" stroke-width="1.5" />
          <rect id="ct-rs-rod" x="208" y="74" width="72" height="12" rx="3" fill="currentColor" fill-opacity="0.4" />
        </g>
        <!-- پروفیل فشار یکنواخت P(x) -->
        <text x="24" y="150" fill="currentColor" fill-opacity="0.7" font-size="9.5" font-weight="700">Pressure Profile P(x):</text>
        <line x1="24" y1="200" x2="272" y2="200" stroke="currentColor" stroke-opacity="0.35" stroke-width="1.5" />
        <line x1="24" y1="156" x2="24" y2="200" stroke="currentColor" stroke-opacity="0.35" stroke-width="1.5" />
        <path id="ct-rs-pcurve" d="M 24 176 L 196 176" fill="none" stroke="#059669" stroke-width="3" stroke-linecap="round" />
        <text id="ct-rs-plbl" x="150" y="214" text-anchor="middle" fill="#059669" font-size="10.5" font-weight="800">Uniform P_face = P_avg (Reversible)</text>
      </svg>

      <!-- SVG تب ۳: دو موتور متوالی -->
      <svg id="ct-svg-ser-diag" viewBox="0 0 280 236" style="width:100%;height:auto;display:none;direction:ltr" aria-label="دو موتور حرارتی کارنو به صورت سری بین دماهای T1 و T2 و T3">
        <defs>
          <marker id="ct-ser-arr" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5" markerHeight="5" orient="auto">
            <path d="M 1 1.5 L 8.5 5 L 1 8.5 z" fill="currentColor" />
          </marker>
        </defs>
        <!-- T1 -->
        <rect x="44" y="8" width="132" height="30" rx="6" fill="#ef4444" fill-opacity="0.18" stroke="#ef4444" stroke-width="1.8" />
        <text id="ct-sd-t1" x="110" y="27" text-anchor="middle" fill="#ef4444" font-size="11" font-weight="800">T₁ = 1000 K</text>
        <line x1="110" y1="38" x2="110" y2="56" stroke="#ef4444" stroke-width="4" marker-end="url(#ct-ser-arr)" />
        <text x="122" y="51" fill="#ef4444" font-size="9.5" font-weight="800">Q₁</text>

        <!-- موتور ۱ -->
        <circle cx="110" cy="76" r="19" fill="currentColor" fill-opacity="0.06" stroke="#0284c7" stroke-width="2" />
        <text x="110" y="80" text-anchor="middle" fill="currentColor" font-size="10.5" font-weight="800">HE₁</text>
        <line id="ct-sd-w1-line" x1="129" y1="76" x2="190" y2="76" stroke="#059669" stroke-width="4" />
        <text id="ct-sd-w1" x="195" y="74" fill="#059669" font-size="10.5" font-weight="800">W₁ = 35.0%</text>
        <text id="ct-sd-e1" x="195" y="86" fill="currentColor" fill-opacity="0.7" font-size="9.5" font-weight="700">η₁ = 35.0%</text>

        <!-- مخزن میانی T2 -->
        <line x1="110" y1="95" x2="110" y2="110" stroke="#d97706" stroke-width="3.2" />
        <rect x="44" y="110" width="132" height="28" rx="6" fill="#d97706" fill-opacity="0.18" stroke="#d97706" stroke-width="1.8" />
        <text id="ct-sd-t2" x="110" y="128" text-anchor="middle" fill="#d97706" font-size="11" font-weight="800">T₂ = 650 K</text>
        <line x1="110" y1="138" x2="110" y2="154" stroke="#d97706" stroke-width="3.2" />
        <text id="ct-sd-q2" x="122" y="149" fill="#d97706" font-size="9.5" font-weight="800">Q₂ = 0.65 Q₁</text>

        <!-- موتور ۲ -->
        <circle cx="110" cy="173" r="19" fill="currentColor" fill-opacity="0.06" stroke="#0284c7" stroke-width="2" />
        <text x="110" y="177" text-anchor="middle" fill="currentColor" font-size="10.5" font-weight="800">HE₂</text>
        <line id="ct-sd-w2-line" x1="129" y1="173" x2="190" y2="173" stroke="#0284c7" stroke-width="4" />
        <text id="ct-sd-w2" x="195" y="171" fill="#0284c7" font-size="10.5" font-weight="800">W₂ = 35.0%</text>
        <text id="ct-sd-e2" x="195" y="183" fill="currentColor" fill-opacity="0.7" font-size="9.5" font-weight="700">η₂ = 53.8%</text>

        <!-- T3 -->
        <line x1="110" y1="192" x2="110" y2="205" stroke="#0284c7" stroke-width="2.6" />
        <rect x="44" y="205" width="132" height="28" rx="6" fill="#0284c7" fill-opacity="0.18" stroke="#0284c7" stroke-width="1.8" />
        <text id="ct-sd-t3" x="110" y="223" text-anchor="middle" fill="#0284c7" font-size="11" font-weight="800">T₃ = 300 K</text>
      </svg>
    </div>

    <!-- پنل ۲ -->
    <div class="jh-widget__pane">
      <div class="jh-widget__pane-title">
        <span id="ct-p2-title">نمودار <span dir="ltr">T-s</span> کارنو و حساسیت به دما</span>
        <span dir="ltr" id="ct-p2-tag">W_net = (T_H - T_L)Δs</span>
      </div>

      <!-- SVG تب ۱: نمودار T-s کارنو -->
      <svg id="ct-svg-carnot-ts" viewBox="0 0 330 236" style="width:100%;height:auto;display:block;direction:ltr" aria-label="نمودار T-s چرخه کارنو">
        <defs>
          <marker id="ct-ts-arr" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5" markerHeight="5" orient="auto">
            <path d="M 1 1.5 L 8.5 5 L 1 8.5 z" fill="#059669" />
          </marker>
        </defs>
        <!-- شبکه -->
        <g stroke="currentColor" stroke-opacity="0.11" stroke-width="1">
          <line x1="48" y1="44" x2="310" y2="44" />
          <line x1="48" y1="86" x2="310" y2="86" />
          <line x1="48" y1="128" x2="310" y2="128" />
          <line x1="48" y1="170" x2="310" y2="170" />
        </g>
        <!-- محورها -->
        <line x1="48" y1="14" x2="48" y2="176" stroke="currentColor" stroke-opacity="0.65" stroke-width="2" />
        <line x1="48" y1="176" x2="314" y2="176" stroke="currentColor" stroke-opacity="0.65" stroke-width="2" />
        <text x="10" y="22" fill="currentColor" font-size="11" font-weight="800">T(K)</text>
        <text x="304" y="191" text-anchor="end" fill="currentColor" font-size="11" font-weight="800">s (kJ/kg·K)</text>
        <text x="42" y="179" text-anchor="end" fill="currentColor" fill-opacity="0.65" font-size="9.5">0</text>
        <text x="42" y="132" text-anchor="end" fill="currentColor" fill-opacity="0.65" font-size="9.5">500</text>
        <text x="42" y="90" text-anchor="end" fill="currentColor" fill-opacity="0.65" font-size="9.5">1000</text>
        <text x="42" y="48" text-anchor="end" fill="currentColor" fill-opacity="0.65" font-size="9.5">1500</text>

        <!-- مساحت Q_L و W_net -->
        <rect id="ct-ts-ql-rect" x="108" y="146" width="144" height="30" fill="#0284c7" fill-opacity="0.18" />
        <rect id="ct-ts-w-rect" x="108" y="96" width="144" height="50" fill="#059669" fill-opacity="0.24" stroke="#059669" stroke-width="2.4" />
        <text id="ct-ts-w-lbl" x="180" y="125" text-anchor="middle" fill="#059669" font-size="11" font-weight="800">W_net</text>
        <text id="ct-ts-ql-lbl" x="180" y="164" text-anchor="middle" fill="#0284c7" font-size="10" font-weight="800">Q_L</text>

        <!-- خط های T_H و T_L -->
        <line id="ct-ts-th-line" x1="48" y1="96" x2="108" y2="96" stroke="#ef4444" stroke-dasharray="3 3" stroke-width="1.2" />
        <line id="ct-ts-tl-line" x1="48" y1="146" x2="108" y2="146" stroke="#0284c7" stroke-dasharray="3 3" stroke-width="1.2" />
        <text id="ct-ts-th-tag" x="54" y="91" fill="#ef4444" font-size="9.5" font-weight="800">T_H=800</text>
        <text id="ct-ts-tl-tag" x="54" y="142" fill="#0284c7" font-size="9.5" font-weight="800">T_L=300</text>

        <!-- رئوس 1..4 و نقطه متحرک -->
        <circle id="ct-ts-p1" cx="108" cy="96" r="3.8" fill="#ef4444" />
        <circle id="ct-ts-p2" cx="252" cy="96" r="3.8" fill="#ef4444" />
        <circle id="ct-ts-p3" cx="252" cy="146" r="3.8" fill="#0284c7" />
        <circle id="ct-ts-p4" cx="108" cy="146" r="3.8" fill="#0284c7" />
        <text id="ct-ts-l1" x="98" y="92" fill="currentColor" font-size="10.5" font-weight="800">1</text>
        <text id="ct-ts-l2" x="260" y="92" fill="currentColor" font-size="10.5" font-weight="800">2</text>
        <text id="ct-ts-l3" x="260" y="152" fill="currentColor" font-size="10.5" font-weight="800">3</text>
        <text id="ct-ts-l4" x="98" y="152" fill="currentColor" font-size="10.5" font-weight="800">4</text>
        <circle id="ct-ts-dot" cx="180" cy="96" r="6" fill="#d97706" stroke="#ffffff" stroke-width="2" />

        <!-- مقایسه حساسیت کاهش T_L vs افزایش T_H -->
        <rect x="48" y="200" width="266" height="30" rx="6" fill="currentColor" fill-opacity="0.06" stroke="currentColor" stroke-opacity="0.2" />
        <text id="ct-ts-sens" x="181" y="219" text-anchor="middle" fill="currentColor" font-size="10" font-weight="800">-50K T_L: +6.3%  &gt;  +50K T_H: +2.2%</text>
      </svg>

      <!-- SVG تب ۲: پیستون سریع -->
      <svg id="ct-svg-rev-fast" viewBox="0 0 300 220" style="width:100%;height:auto;display:none;direction:ltr" aria-label="پیستون سریع برگشت‌ناپذیر با موج شوک فشار">
        <text x="150" y="18" text-anchor="middle" fill="#ef4444" font-size="11.5" font-weight="800">Fast Irreversible Piston (S_gen &gt; 0)</text>
        <!-- سیلندر افقی -->
        <rect id="ct-rf-gas" x="26" y="34" width="170" height="92" fill="#0284c7" fill-opacity="0.14" rx="2" />
        <!-- نوار موج شوک / کمبود چگالی نزدیک پیستون -->
        <rect id="ct-rf-shock" x="166" y="34" width="30" height="92" fill="#ef4444" fill-opacity="0.32" rx="2" />
        <g id="ct-rf-particles"></g>
        <path d="M 272 32 L 24 32 L 24 128 L 272 128" fill="none" stroke="currentColor" stroke-opacity="0.72" stroke-width="4" stroke-linejoin="round" />
        <g id="ct-rf-piston">
          <rect id="ct-rf-head" x="196" y="34" width="12" height="92" rx="2" fill="#d97706" stroke="currentColor" stroke-opacity="0.65" stroke-width="1.5" />
          <rect id="ct-rf-rod" x="208" y="74" width="72" height="12" rx="3" fill="currentColor" fill-opacity="0.4" />
        </g>
        <!-- پروفیل فشار غیریکنواخت P(x) -->
