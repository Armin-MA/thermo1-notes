---
// آزمایشگر زنده شکل‌های کار مکانیکی: فنر پیش‌بارگذاری‌شده، شفت دوار و شتاب‌گیری خودرو (فصل ۲ - بخش ۴)
---

<div class="jh-widget not-content" id="mech-work-lab">
  <div class="jh-widget__head">
    <span class="jh-widget__title">آزمایشگر زندهٔ کارهای مکانیکی: فنر <span dir="ltr">(x₁ ≠ 0)</span>، شفت دوار و شتاب‌گیری</span>
    <span class="jh-widget__badge">شبیه‌سازی زنده</span>
  </div>
  <div class="jh-widget__sub" style="margin-bottom:0.65rem">
    مقایسهٔ سه شکل کلیدی کار در بخش ۴ فصل دوم و حل زندهٔ تلهٔ پیش‌بارگذاری فنر و مثال ۲-۳ (اسلاید ۱۹)
  </div>

  <div class="jh-widget__btns" id="mwl-modes">
    <button type="button" class="jh-widget__btn is-active" data-mode="spring-preload">۱) تلهٔ فنر <span dir="ltr">(x₁ ≠ 0)</span></button>
    <button type="button" class="jh-widget__btn" data-mode="shaft">۲) کار شفت دوار <span dir="ltr">(W_sh = 2π n τ)</span></button>
    <button type="button" class="jh-widget__btn" data-mode="accel">۳) شتاب‌گیری خودرو (مثال ۲-۳: <span dir="ltr">900 kg</span>)</button>
  </div>

  <!-- کنترل‌های حالت ۱: فنر پیش‌بارگذاری‌شده -->
  <div class="jh-widget__grid" id="mwl-spring-ctrls">
    <label class="jh-widget__ctrl">
      <span>ثابت فنر <span dir="ltr">(k)</span>: <strong id="mwl-k-lbl" dir="ltr">20 kN/m</strong></span>
      <input id="mwl-k" type="range" min="5" max="50" step="1" value="20" />
    </label>
    <label class="jh-widget__ctrl">
      <span>فشردگی اولیه (<span dir="ltr">x₁</span> از طول آزاد): <strong id="mwl-x1-lbl" dir="ltr">2.0 cm</strong></span>
      <input id="mwl-x1" type="range" min="0" max="5" step="0.5" value="2" />
    </label>
    <label class="jh-widget__ctrl">
      <span>فشردگی نهایی (<span dir="ltr">x₂</span> از طول آزاد): <strong id="mwl-x2-lbl" dir="ltr">5.0 cm</strong></span>
      <input id="mwl-x2" type="range" min="1" max="10" step="0.5" value="5" />
    </label>
  </div>

  <!-- کنترل‌های حالت ۲: کار شفت دوار -->
  <div class="jh-widget__grid" id="mwl-shaft-ctrls" style="display:none">
    <label class="jh-widget__ctrl">
      <span>سرعت دورانی <span dir="ltr">(ṅ)</span>: <strong id="mwl-rpm-lbl" dir="ltr">300 rpm (5.0 rev/s)</strong></span>
      <input id="mwl-rpm" type="range" min="60" max="1200" step="30" value="300" />
    </label>
    <label class="jh-widget__ctrl">
      <span>گشتاور محور <span dir="ltr">(τ)</span>: <strong id="mwl-tau-lbl" dir="ltr">50 N·m</strong></span>
      <input id="mwl-tau" type="range" min="10" max="200" step="5" value="50" />
    </label>
  </div>

  <!-- کنترل‌های حالت ۳: شتاب‌گیری خودرو -->
  <div id="mwl-accel-ctrls" style="display:none">
    <div class="jh-widget__btns" id="mwl-accel-presets">
      <button type="button" class="jh-widget__btn is-active" data-ap="ex23">🚗 مثال ۲-۳ (اسلاید ۱۹: <span dir="ltr">900 kg, 0 → 80 km/h</span>)</button>
      <button type="button" class="jh-widget__btn" data-ap="p235">🚙 تمرین ۲-۳۵ <span dir="ltr">(1500 kg, 0 → 100 km/h)</span></button>
    </div>
    <div class="jh-widget__grid">
      <label class="jh-widget__ctrl">
        <span>جرم خودرو <span dir="ltr">(m)</span>: <strong id="mwl-m-lbl" dir="ltr">900 kg</strong></span>
        <input id="mwl-m" type="range" min="500" max="2000" step="50" value="900" />
      </label>
      <label class="jh-widget__ctrl">
        <span>سرعت آغاز <span dir="ltr">(V₁)</span>: <strong id="mwl-v1-lbl" dir="ltr">0 km/h</strong></span>
        <input id="mwl-v1" type="range" min="0" max="60" step="5" value="0" />
      </label>
      <label class="jh-widget__ctrl">
        <span>سرعت پایان <span dir="ltr">(V₂)</span>: <strong id="mwl-v2-lbl" dir="ltr">80 km/h</strong></span>
        <input id="mwl-v2" type="range" min="20" max="140" step="5" value="80" />
      </label>
    </div>
  </div>

  <!-- نوار ابزار پخش مشترک -->
  <div class="jh-widget__toolbar">
    <button type="button" class="jh-widget__btn jh-widget__btn--primary" id="mwl-play">▶ پخش فرآیند</button>
    <button type="button" class="jh-widget__btn" id="mwl-reset">↺ بازنشانی</button>
    <label class="jh-widget__ctrl" style="flex:1;min-width:180px">
      <span>پیشرفت فرآیند <span dir="ltr">(t)</span>: <strong id="mwl-t-lbl" dir="ltr">100%</strong></span>
      <input id="mwl-t" type="range" min="0" max="100" step="1" value="100" />
    </label>
  </div>

  <!-- پنل دوگانه حالت ۱: فنر -->
  <div class="jh-widget__split" id="mwl-split-spring">
    <div class="jh-widget__pane">
      <div class="jh-widget__pane-title">
        <span>شماتیک زندهٔ فشرده‌سازی فنر نسبت به طول آزاد <span dir="ltr">(x = 0)</span></span>
        <span dir="ltr" id="mwl-sp-tag">x = 5.0 cm</span>
      </div>
      <svg id="mwl-spring-svg" viewBox="0 0 330 234" style="width:100%;height:auto;display:block;direction:ltr" aria-label="شماتیک زنده فشرده‌سازی فنر خطی">
        <defs>
          <marker id="mwl-arr-f" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="6" markerHeight="6" orient="auto">
            <path d="M 1 2 L 8 5 L 1 8 z" fill="#d97706" />
          </marker>
        </defs>
        <!-- دیواره صلب سمت چپ -->
        <rect x="16" y="46" width="14" height="122" rx="3" fill="currentColor" fill-opacity="0.5" />
        <!-- ناحیه جابجایی بین x1 و x2 -->
        <rect id="mwl-sp-band" x="186" y="54" width="42" height="106" fill="#059669" fill-opacity="0.1" />
        <!-- خط مرجع طول آزاد x = 0 -->
        <line x1="256" y1="36" x2="256" y2="186" stroke="currentColor" stroke-opacity="0.45" stroke-width="1.5" stroke-dasharray="4 3" />
        <text x="256" y="26" text-anchor="middle" fill="currentColor" fill-opacity="0.8" font-size="9.5" font-weight="800">x = 0 (Free)</text>

        <!-- خط‌چین x1 و x2 -->
        <line id="mwl-x1-line" x1="228" y1="44" x2="228" y2="186" stroke="#d97706" stroke-width="1.4" stroke-dasharray="4 3" />
        <line id="mwl-x2-line" x1="186" y1="44" x2="186" y2="186" stroke="#059669" stroke-width="1.4" stroke-dasharray="4 3" />

        <!-- فنر افقی مارپیچ -->
        <path id="mwl-spring-path" d="" fill="none" stroke="#0284c7" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />

        <!-- صفحه متحرک انتهای فنر و فلش نیرو -->
        <rect id="mwl-sp-plate" x="186" y="74" width="10" height="68" rx="2" fill="#64748b" stroke="currentColor" stroke-opacity="0.55" />
        <g id="mwl-sp-fgrp">
          <line id="mwl-sp-fline" x1="242" y1="108" x2="200" y2="108" stroke="#d97706" stroke-width="3" marker-end="url(#mwl-arr-f)" />
          <text id="mwl-sp-flbl" x="224" y="64" text-anchor="middle" fill="#d97706" font-size="10.5" font-weight="800">F = 1000 N</text>
        </g>

        <!-- محور خط‌کش پایینی -->
        <line x1="90" y1="186" x2="274" y2="186" stroke="currentColor" stroke-opacity="0.5" stroke-width="1.5" />
        <text x="256" y="199" text-anchor="middle" fill="currentColor" fill-opacity="0.7" font-size="9">0</text>
        <text id="mwl-x1-tick" x="228" y="212" text-anchor="middle" fill="#d97706" font-size="9" font-weight="800">x₁=2</text>
        <text id="mwl-x2-tick" x="186" y="224" text-anchor="middle" fill="#059669" font-size="9" font-weight="800">x₂=5 cm</text>

        <!-- برچسب اطلاعات بالا چپ -->
        <rect x="38" y="18" width="136" height="24" rx="6" fill="currentColor" fill-opacity="0.06" stroke="currentColor" stroke-opacity="0.2" />
        <text id="mwl-sp-info" x="106" y="34" text-anchor="middle" fill="currentColor" font-size="9.5" font-weight="800">k = 20 kN/m | Δx = 3.0 cm</text>
      </svg>
    </div>

    <div class="jh-widget__pane">
      <div class="jh-widget__pane-title">
        <span>نمودار <span dir="ltr">F-x</span>: ذوزنقهٔ صحیح در برابر مثلث غلط</span>
        <span dir="ltr" id="mwl-fx-tag" style="color:#059669">21.0 J vs 9.0 J</span>
      </div>
      <svg id="mwl-fx-svg" viewBox="0 0 330 230" style="width:100%;height:auto;display:block;direction:ltr" aria-label="نمودار نیرو جابجایی فنر و مقایسه ذوزنقه با مثلث غلط">
        <line x1="48" y1="24" x2="48" y2="186" stroke="currentColor" stroke-opacity="0.55" stroke-width="1.8" />
        <line x1="48" y1="186" x2="314" y2="186" stroke="currentColor" stroke-opacity="0.55" stroke-width="1.8" />
        <text x="14" y="24" fill="currentColor" font-size="10.5" font-weight="700">F(N)</text>
        <text x="292" y="216" fill="currentColor" font-size="10" font-weight="700">x(cm)</text>
        <text x="42" y="190" text-anchor="end" fill="currentColor" fill-opacity="0.65" font-size="9">0</text>
        <text id="mwl-fx-fmax" x="42" y="34" text-anchor="end" fill="currentColor" fill-opacity="0.65" font-size="9">1200</text>

        <!-- مستطیل پایینی پیش‌بارگذاری (حذف‌شده در فرمول غلط!) -->
        <path id="mwl-fx-rect" d="" fill="#059669" fill-opacity="0.24" />
        <!-- مثلث بالایی (فرمول غلط ½k(x2-x1)^2) -->
        <path id="mwl-fx-tri" d="" fill="#ef4444" fill-opacity="0.28" />
        <!-- حاشیه ذوزنقه صحیح کل -->
        <path id="mwl-fx-trap-stroke" d="" fill="none" stroke="#059669" stroke-width="2" />
        <!-- خط جداکننده افقی F1 -->
        <line id="mwl-fx-f1line" x1="48" y1="130" x2="250" y2="130" stroke="#d97706" stroke-dasharray="4 3" stroke-width="1.3" />

        <!-- خط کشسانی F = kx -->
        <line id="mwl-fx-hooke" x1="48" y1="186" x2="290" y2="42" stroke="#0284c7" stroke-width="2.6" />
        <circle id="mwl-fx-dot" cx="180" cy="100" r="5.5" fill="#d97706" stroke="#ffffff" stroke-width="2" />

        <!-- تیک‌های محور افقی -->
        <text id="mwl-fx-x1lbl" x="110" y="200" text-anchor="middle" fill="#d97706" font-size="9" font-weight="800">x₁</text>
        <text id="mwl-fx-x2lbl" x="210" y="213" text-anchor="middle" fill="#059669" font-size="9" font-weight="800">x₂</text>
        <text id="mwl-fx-f1lbl" x="42" y="133" text-anchor="end" fill="#d97706" font-size="8.5" font-weight="700">F₁</text>

        <!-- راهنمای گوشه بالا-چپ -->
        <rect x="56" y="22" width="168" height="44" rx="7" fill="currentColor" fill-opacity="0.05" stroke="currentColor" stroke-opacity="0.2" />
        <rect x="64" y="30" width="10" height="10" rx="2" fill="#059669" fill-opacity="0.55" stroke="#059669" />
        <text id="mwl-fx-leg1" x="79" y="39" fill="#059669" font-size="9" font-weight="800">Correct: 21.0 J (Trapezoid)</text>
        <rect x="64" y="48" width="10" height="10" rx="2" fill="#ef4444" fill-opacity="0.55" stroke="#ef4444" />
        <text id="mwl-fx-leg2" x="79" y="57" fill="#ef4444" font-size="9" font-weight="800">Wrong: 9.0 J (Top Triangle)</text>
      </svg>
    </div>
  </div>

  <!-- پنل دوگانه حالت ۲: شفت دوار -->
  <div class="jh-widget__split" id="mwl-split-shaft" style="display:none">
    <div class="jh-widget__pane">
      <div class="jh-widget__pane-title">
        <span>فلای‌ویل و محور دوار تحت گشتاور <span dir="ltr">τ</span></span>
        <span dir="ltr" id="mwl-sh-tag">n = 50.0 rev</span>
      </div>
      <svg id="mwl-shaft-svg" viewBox="0 0 330 230" style="width:100%;height:auto;display:block;direction:ltr" aria-label="شفت دوار و گشتاور محور">
        <defs>
          <marker id="mwl-arr-t" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="6" markerHeight="6" orient="auto">
            <path d="M 1 2 L 8 5 L 1 8 z" fill="#d97706" />
          </marker>
        </defs>
        <!-- فلای‌ویل چرخان -->
        <circle cx="116" cy="116" r="62" fill="#0284c7" fill-opacity="0.1" stroke="currentColor" stroke-opacity="0.65" stroke-width="4" />
        <g id="mwl-flywheel" transform="rotate(0, 116, 116)">
          <line x1="116" y1="56" x2="116" y2="176" stroke="#0284c7" stroke-width="3" />
          <line x1="64" y1="86" x2="168" y2="146" stroke="#0284c7" stroke-width="3" />
          <line x1="64" y1="146" x2="168" y2="86" stroke="#0284c7" stroke-width="3" />
          <circle cx="116" cy="70" r="4.5" fill="#d97706" />
        </g>
        <circle cx="116" cy="116" r="14" fill="#64748b" stroke="currentColor" stroke-opacity="0.6" stroke-width="2" />

        <!-- میله شفت -->
        <rect x="128" y="106" width="164" height="20" rx="4" fill="#64748b" fill-opacity="0.4" stroke="currentColor" stroke-opacity="0.6" stroke-width="2" />
        <line id="mwl-sh-stripe1" x1="170" y1="106" x2="180" y2="126" stroke="#0284c7" stroke-width="2.5" />
        <line id="mwl-sh-stripe2" x1="220" y1="106" x2="230" y2="126" stroke="#0284c7" stroke-width="2.5" />
        <line id="mwl-sh-stripe3" x1="265" y1="106" x2="275" y2="126" stroke="#0284c7" stroke-width="2.5" />

        <!-- فلش خمیده گشتاور τ -->
        <path d="M 218 82 A 34 34 0 0 1 258 100" fill="none" stroke="#d97706" stroke-width="3" marker-end="url(#mwl-arr-t)" />
        <text id="mwl-sh-tau-txt" x="236" y="72" text-anchor="middle" fill="#d97706" font-size="11" font-weight="800">τ = 50 N·m</text>

        <!-- برچسب‌های RPM و دور -->
        <rect x="168" y="152" width="144" height="48" rx="8" fill="currentColor" fill-opacity="0.05" stroke="currentColor" stroke-opacity="0.2" />
        <text id="mwl-sh-rpm-txt" x="240" y="172" text-anchor="middle" fill="#0284c7" font-size="10.5" font-weight="800">ṅ = 300 rpm (5.0 rev/s)</text>
        <text id="mwl-sh-rev-txt" x="240" y="190" text-anchor="middle" fill="#059669" font-size="10" font-weight="800">n = 50.0 rev (t = 10.0 s)</text>
      </svg>
    </div>

    <div class="jh-widget__pane">
      <div class="jh-widget__pane-title">
        <span>رشد خطی کار محور <span dir="ltr">W_sh(t) = Ẇ_sh · t</span></span>
        <span dir="ltr" id="mwl-sh-ptag" style="color:#059669">Ẇ_sh = 1.57 kW</span>
      </div>
      <svg id="mwl-shaft-plot" viewBox="0 0 330 230" style="width:100%;height:auto;display:block;direction:ltr" aria-label="نمودار کار شفت بر حسب زمان">
        <line x1="48" y1="24" x2="48" y2="186" stroke="currentColor" stroke-opacity="0.55" stroke-width="1.8" />
        <line x1="48" y1="186" x2="312" y2="186" stroke="currentColor" stroke-opacity="0.55" stroke-width="1.8" />
        <text x="12" y="24" fill="currentColor" font-size="10" font-weight="700">W_sh(kJ)</text>
        <text x="296" y="214" fill="currentColor" font-size="10" font-weight="700">t(s)</text>
        <text x="42" y="190" text-anchor="end" fill="currentColor" fill-opacity="0.65" font-size="9">0</text>
        <text id="mwl-sh-ymax" x="42" y="34" text-anchor="end" fill="currentColor" fill-opacity="0.65" font-size="9">18.0</text>
        <text x="308" y="201" text-anchor="middle" fill="currentColor" fill-opacity="0.65" font-size="9">10 s</text>

        <path id="mwl-sh-area" d="" fill="#0284c7" fill-opacity="0.22" />
        <line id="mwl-sh-full" x1="48" y1="186" x2="308" y2="42" stroke="currentColor" stroke-opacity="0.28" stroke-dasharray="4 4" stroke-width="1.8" />
        <line id="mwl-sh-cur" x1="48" y1="186" x2="308" y2="42" stroke="#0284c7" stroke-width="3" />
        <circle id="mwl-sh-dot" cx="308" cy="42" r="5.5" fill="#d97706" stroke="#ffffff" stroke-width="2" />
        <text id="mwl-sh-slope" x="126" y="48" text-anchor="middle" fill="#059669" font-size="10.5" font-weight="800">Slope = Ẇ_sh = 1.57 kW</text>
      </svg>
    </div>
  </div>

  <!-- پنل دوگانه حالت ۳: شتاب‌گیری خودرو -->
  <div class="jh-widget__split" id="mwl-split-accel" style="display:none">
    <div class="jh-widget__pane">
      <div class="jh-widget__pane-title">
        <span>حرکت خودرو در مسیر هموار <span dir="ltr" id="mwl-ac-mtag">(m = 900 kg)</span></span>
        <span dir="ltr" id="mwl-ac-vtag">V = 22.22 m/s</span>
      </div>
      <svg id="mwl-car-svg" viewBox="0 0 330 230" style="width:100%;height:auto;display:block;direction:ltr" aria-label="انیمیشن شتاب‌گیری خودرو">
        <defs>
          <marker id="mwl-arr-v" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="6" markerHeight="6" orient="auto">
            <path d="M 1 2 L 8 5 L 1 8 z" fill="#059669" />
          </marker>
        </defs>
        <!-- سرعت‌سنج بالا-راست -->
        <g transform="translate(278, 52)">
          <circle cx="0" cy="0" r="30" fill="currentColor" fill-opacity="0.05" stroke="currentColor" stroke-opacity="0.45" stroke-width="2" />
          <path d="M -20 14 A 24 24 0 1 1 20 14" fill="none" stroke="currentColor" stroke-opacity="0.22" stroke-width="2.6" stroke-linecap="round" />
          <circle cx="0" cy="0" r="3" fill="currentColor" />
          <line id="mwl-spdo-needle" x1="0" y1="0" x2="10" y2="-16" stroke="#ef4444" stroke-width="2.4" stroke-linecap="round" />
          <text x="0" y="-12" text-anchor="middle" fill="currentColor" fill-opacity="0.65" font-size="8" font-weight="700">km/h</text>
          <text id="mwl-spdo-val" x="0" y="21" text-anchor="middle" fill="#0284c7" font-size="10.5" font-weight="800">80</text>
        </g>

        <rect x="16" y="24" width="166" height="44" rx="8" fill="currentColor" fill-opacity="0.05" stroke="currentColor" stroke-opacity="0.2" />
        <text id="mwl-car-ms" x="99" y="42" text-anchor="middle" fill="#0284c7" font-size="10.5" font-weight="800">V = 22.22 m/s</text>
        <text id="mwl-car-wa" x="99" y="59" text-anchor="middle" fill="#d97706" font-size="10" font-weight="800">W_a = 222.2 kJ</text>

        <!-- جاده -->
        <rect x="10" y="168" width="310" height="28" rx="4" fill="currentColor" fill-opacity="0.1" />
        <line x1="10" y1="168" x2="320" y2="168" stroke="currentColor" stroke-opacity="0.55" stroke-width="2" />
        <line id="mwl-road-line" x1="14" y1="182" x2="316" y2="182" stroke="currentColor" stroke-opacity="0.35" stroke-width="2" stroke-dasharray="16 12" />

        <!-- خودروی متحرک -->
        <g id="mwl-car-grp" transform="translate(180, 0)">
          <!-- بدنه خودرو -->
          <path d="M 8 152 L 12 136 L 30 134 L 46 118 L 76 118 L 90 134 L 106 138 L 108 152 Z" fill="#0284c7" fill-opacity="0.85" stroke="currentColor" stroke-opacity="0.65" stroke-width="1.6" stroke-linejoin="round" />
          <path d="M 35 134 L 48 122 L 73 122 L 85 134 Z" fill="#e0f2fe" fill-opacity="0.85" />
          <!-- چرخ عقب و جلو -->
          <circle cx="30" cy="155" r="12" fill="#334155" stroke="#ffffff" stroke-width="1.5" />
          <g id="mwl-wheel-1" transform="rotate(0, 30, 155)">
            <line x1="22" y1="155" x2="38" y2="155" stroke="#e2e8f0" stroke-width="1.6" />
            <line x1="30" y1="147" x2="30" y2="163" stroke="#e2e8f0" stroke-width="1.6" />
          </g>
          <circle cx="86" cy="155" r="12" fill="#334155" stroke="#ffffff" stroke-width="1.5" />
          <g id="mwl-wheel-2" transform="rotate(0, 86, 155)">
            <line x1="78" y1="155" x2="94" y2="155" stroke="#e2e8f0" stroke-width="1.6" />
            <line x1="86" y1="147" x2="86" y2="163" stroke="#e2e8f0" stroke-width="1.6" />
