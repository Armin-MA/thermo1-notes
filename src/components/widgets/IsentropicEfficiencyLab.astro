    function renderCompressor() {
      etaCLbl.textContent = `${Math.round(etaC * 100)}%`;
      const air = IDEAL_GASES.air;
      const p1 = 100;
      const p2 = 800;
      const mDot = 0.2;

      const st1 = airPropsByT(285);
      const st2s = airPropsByT(513.5);
      const ws = st2s.h - st1.h; // 231.91 kJ/kg
      const wa = ws / etaC;
      const h2a = st1.h + wa;
      const st2a = airPropsByH(h2a);
      const sGen = st2a.s0 - st2s.s0; // چون P2s = P2a = 800 kPa، پس s2a - s2s = s0(2a) - s0(2s)!

      p1Title.innerHTML = 'نمودار <span dir="ltr">T-s</span> کمپرسور هوا (<span dir="ltr">Table A-17</span>)';
      p1Tag.textContent = '100 kPa, 285 K → 800 kPa';
      p2Title.innerHTML = 'شماتیک کمپرسور و توان مصرفی';
      p2Tag.textContent = `η_C = ${Math.round(etaC * 100)}%`;

      const vp = createViewport(-0.08, 0.30, 260, 720, 50, 334, 208, 18);
      drawAxes(vp, [300, 400, 500, 600, 700], [0.0, 0.1, 0.2, 0.3], 'T (K)');
      satCurve.style.display = 'none';

      // خطوط هم‌فشار s_rel(T) = s0(T) - s0(285) - R ln(P/100)
      const p1Pts: Array<[number, number]> = [];
      const p2Pts: Array<[number, number]> = [];
      for (let t = 270; t <= 700; t += 20) {
        const pr = airPropsByT(t);
        p1Pts.push([pr.s0 - st1.s0, t]);
        p2Pts.push([pr.s0 - st1.s0 - air.R * Math.log(p2 / p1), t]);
      }
      isoP1.setAttribute('d', vp.path(p1Pts));
      isoP2.setAttribute('d', vp.path(p2Pts));
      p1Lbl.setAttribute('x', vp.x(0.18).toFixed(1));
      p1Lbl.setAttribute('y', (vp.y(350) + 12).toFixed(1));
      p1Lbl.textContent = '100 kPa';
      p2Lbl.setAttribute('x', vp.x(0.08).toFixed(1));
      p2Lbl.setAttribute('y', (vp.y(640) - 6).toFixed(1));
      p2Lbl.textContent = '800 kPa';

      const s1 = 0;
      const s2s = 0;
      const s2a = sGen;

      const x1 = vp.x(s1);
      const y1 = vp.y(st1.T);
      const x2s = vp.x(s2s);
