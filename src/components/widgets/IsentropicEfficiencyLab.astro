      const maxW = ws / 0.6;
      bsLbl.textContent = `Ideal (Ẇ_s): ${(mDot * ws).toFixed(1)} kW (${ws.toFixed(1)} kJ/kg)`;
      baLbl.textContent = `Actual (Ẇ_a = Ẇ_s / η_C): ${(mDot * wa).toFixed(1)} kW (${wa.toFixed(1)} kJ/kg)`;
      bsBar.setAttribute('width', (250 * (ws / maxW)).toFixed(1));
