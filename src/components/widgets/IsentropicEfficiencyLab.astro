      sgenBarTxt.textContent = `T₂a = ${st2a.T.toFixed(1)} K > T₂s = ${st2s.T.toFixed(1)} K  |  s_gen = +${sGen.toFixed(3)} kJ/kg·K`;

      m1Lbl.innerHTML = 'توان ایده‌آل (<span dir="ltr">Ẇ_s</span>)';
