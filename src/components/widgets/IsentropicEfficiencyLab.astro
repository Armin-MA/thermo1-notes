      lineA.setAttribute('d', `M ${x1.toFixed(1)} ${y1.toFixed(1)} Q ${xm.toFixed(1)} ${ym.toFixed(1)} ${x2a.toFixed(1)} ${y2a.toFixed(1)}`);

      sgenLine.style.display = sGen > 0.005 ? '' : 'none';
      sgenLbl.style.display = sGen > 0.005 ? '' : 'none';
      sgenLine.setAttribute('x1', x2s.toFixed(1));
      sgenLine.setAttribute('x2', x2a.toFixed(1));
      sgenLine.setAttribute('y1', (y2s - 18).toFixed(1));
      sgenLine.setAttribute('y2', (y2s - 18).toFixed(1));
      sgenLbl.setAttribute('x', ((x2s + x2a) / 2).toFixed(1));
      sgenLbl.setAttribute('y', (y2s - 23).toFixed(1));
      sgenLbl.textContent = `s_gen=+${sGen.toFixed(3)}`;

      pt1El.setAttribute('cx', x1.toFixed(1));
      pt1El.setAttribute('cy', y1.toFixed(1));
