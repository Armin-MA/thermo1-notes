      pt2sEl.setAttribute('cy', y2s.toFixed(1));
      lbl2sEl.setAttribute('x', (x2s - 18).toFixed(1));
      lbl2sEl.setAttribute('y', (y2s + 4).toFixed(1));

      pt2aEl.setAttribute('cx', x2a.toFixed(1));
      pt2aEl.setAttribute('cy', y2a.toFixed(1));
      lbl2aEl.setAttribute('x', (x2a + 9).toFixed(1));
      lbl2aEl.setAttribute('y', (y2a - 4).toFixed(1));

      // شماتیک کمپرسور همگرا
      devPoly.setAttribute('points', '72,22 198,42 198,94 72,114');
      devShaft.style.display = '';
      rotorEl.style.display = '';
