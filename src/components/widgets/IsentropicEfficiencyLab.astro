      <span class="jh-metric__val" id="iel-m1-val">823.7 kJ/kg</span>
    </div>
    <div class="jh-metric">
      <span class="jh-metric__label" id="iel-m2-lbl">کار / سرعت واقعی (<span dir="ltr">2a</span>)</span>
      <span class="jh-metric__val" id="iel-m2-val">549.4 kJ/kg</span>
    </div>
