      m3Val.textContent = `${st2a.T.toFixed(1)} K (vs ${st2s.T.toFixed(1)} K)`;
      m4Val.textContent = `+${sGen.toFixed(3)} kJ/kg·K`;

      explainEl.innerHTML = `در <strong>کمپرسور هوا مثال ۷-۱۱</strong> با <span dir="ltr">η_C = ${Math.round(etaC * 100)}%</span>، کار واقعی <strong><span dir="ltr">${((1 / etaC - 1) * 100).toFixed(0)}%</span> بیشتر</strong> از حالت ایده‌آل است (<span dir="ltr">${(mDot * wa).toFixed(1)} kW</span> در برابر <span dir="ltr">${(mDot * ws).toFixed(1)} kW</span>) و اصطکاک باعث بالا رفتن دمای هوای خروجی از <span dir="ltr">513.5 K</span> به <strong><span dir="ltr">${st2a.T.toFixed(1)} K</span></strong> می‌شود.`;
    }

    function renderNozzle() {
      etaNLbl.textContent = `${Math.round(etaN * 100)}%`;
      const cp = 1.099;
      const k = 1.354;
      const R = 0.287;
      const T1 = 950;
      const p1 = 200;
      const p2 = 80;

      const T2s = T1 * Math.pow(p2 / p1, (k - 1) / k); // 747.8 K -> 748 K
      const V2s = Math.sqrt(2 * cp * 1000 * (T1 - T2s)); // ~666.7 m/s
      const T2a = T1 - etaN * (T1 - T2s); // 764.0 K at 92%
      const V2a = Math.sqrt(etaN) * V2s; // ~639.5 m/s
      const sGen = cp * Math.log(T2a / T2s);

      p1Title.innerHTML = 'نمودار <span dir="ltr">T-s</span> انبساط در شیپوره هوا';
      p1Tag.textContent = '200 kPa, 950 K → 80 kPa';
      p2Title.innerHTML = 'شماتیک شیپوره و سرعت خروجی';
      p2Tag.textContent = `η_N = ${Math.round(etaN * 100)}%`;

      const vp = createViewport(-0.08, 0.14, 700, 990, 50, 334, 208, 18);
      drawAxes(vp, [740, 800, 880, 950], [-0.05, 0.0, 0.05, 0.10], 'T (K)');
      satCurve.style.display = 'none';

      const p1Pts: Array<[number, number]> = [];
      const p2Pts: Array<[number, number]> = [];
      for (let t = 710; t <= 980; t += 20) {
        p1Pts.push([cp * Math.log(t / T1), t]);
        p2Pts.push([cp * Math.log(t / T1) - R * Math.log(p2 / p1), t]);
      }
      isoP1.setAttribute('d', vp.path(p1Pts));
      isoP2.setAttribute('d', vp.path(p2Pts));
      p1Lbl.setAttribute('x', vp.x(-0.06).toFixed(1));
      p1Lbl.setAttribute('y', (vp.y(890) - 6).toFixed(1));
      p1Lbl.textContent = '200 kPa';
      p2Lbl.setAttribute('x', vp.x(0.08).toFixed(1));
      p2Lbl.setAttribute('y', (vp.y(800) - 6).toFixed(1));
      p2Lbl.textContent = '80 kPa';

      const x1 = vp.x(0);
      const y1 = vp.y(T1);
      const x2s = vp.x(0);
      const y2s = vp.y(T2s);
      const x2a = vp.x(sGen);
      const y2a = vp.y(T2a);

      lineS.setAttribute('x1', x1.toFixed(1));
      lineS.setAttribute('y1', y1.toFixed(1));
      lineS.setAttribute('x2', x2s.toFixed(1));
      lineS.setAttribute('y2', y2s.toFixed(1));

      const xm = (x1 + x2a) / 2 - 4;
      const ym = (y1 + y2a) / 2 + 4;
      lineA.setAttribute('d', `M ${x1.toFixed(1)} ${y1.toFixed(1)} Q ${xm.toFixed(1)} ${ym.toFixed(1)} ${x2a.toFixed(1)} ${y2a.toFixed(1)}`);

      sgenLine.style.display = sGen > 0.002 ? '' : 'none';
      sgenLbl.style.display = sGen > 0.002 ? '' : 'none';
      sgenLine.setAttribute('x1', x2s.toFixed(1));
      sgenLine.setAttribute('x2', x2a.toFixed(1));
      sgenLine.setAttribute('y1', (y2s + 14).toFixed(1));
      sgenLine.setAttribute('y2', (y2s + 14).toFixed(1));
      sgenLbl.setAttribute('x', ((x2s + x2a) / 2).toFixed(1));
      sgenLbl.setAttribute('y', (y2s + 26).toFixed(1));
      sgenLbl.textContent = `s_gen=+${sGen.toFixed(4)}`;

      pt1El.setAttribute('cx', x1.toFixed(1));
      pt1El.setAttribute('cy', y1.toFixed(1));
      lbl1El.setAttribute('x', (x1 - 12).toFixed(1));
      lbl1El.setAttribute('y', (y1 - 4).toFixed(1));

      pt2sEl.setAttribute('cx', x2s.toFixed(1));
      pt2sEl.setAttribute('cy', y2s.toFixed(1));
      lbl2sEl.setAttribute('x', (x2s - 18).toFixed(1));
      lbl2sEl.setAttribute('y', (y2s + 4).toFixed(1));

      pt2aEl.setAttribute('cx', x2a.toFixed(1));
      pt2aEl.setAttribute('cy', y2a.toFixed(1));
      lbl2aEl.setAttribute('x', (x2a + 9).toFixed(1));
      lbl2aEl.setAttribute('y', (y2a - 4).toFixed(1));

      // شماتیک شیپوره همگرا
      devPoly.setAttribute('points', '72,22 198,48 198,88 72,114');
      devShaft.style.display = 'none';
      rotorEl.style.display = 'none';
      flowOut.style.display = '';
      devInLbl.textContent = '200 kPa, 950 K';
      devOutLbl.textContent = `V₂a = ${V2a.toFixed(0)} m/s`;

      barHead.textContent = 'Exit Velocity (V = √η_N · V_2s):';
      bsLbl.textContent = `Ideal Speed (V₂s): ${V2s.toFixed(0)} m/s (T₂s=${T2s.toFixed(0)} K)`;
      baLbl.textContent = `Actual Speed (V₂a): ${V2a.toFixed(0)} m/s (T₂a=${T2a.toFixed(0)} K)`;
      bsBar.setAttribute('width', '250');
      baBar.setAttribute('width', (250 * Math.sqrt(etaN)).toFixed(1));
      sgenBarTxt.textContent = `KE₂a / KE₂s = ${(etaN * 100).toFixed(0)}%  |  V₂a / V₂s = ${(Math.sqrt(etaN) * 100).toFixed(1)}%`;

      m1Lbl.innerHTML = 'سرعت بیشینه (<span dir="ltr">V₂s</span>)';
      m2Lbl.innerHTML = 'سرعت واقعی <span dir="ltr">(V₂a = √η_N · V₂s)</span>';
      m3Lbl.innerHTML = 'دمای واقعی خروجی (<span dir="ltr">T₂a</span>)';
      m4Lbl.innerHTML = 'تولید آنتروپی (<span dir="ltr">s_gen</span>)';

      m1Val.textContent = `${V2s.toFixed(0)} m/s`;
      m2Val.textContent = `${V2a.toFixed(0)} m/s (${(Math.sqrt(etaN) * 100).toFixed(1)}%)`;
      m3Val.textContent = `${T2a.toFixed(0)} K (vs ${T2s.toFixed(0)} K)`;
      m4Val.textContent = `+${sGen.toFixed(4)} kJ/kg·K`;

      explainEl.innerHTML = `در <strong>شیپوره هوا مثال ۷-۱۲</strong>، بازده ایزنتروپیک <span dir="ltr">η_N = ${Math.round(etaN * 100)}%</span> نسبت انرژی‌های جنبشی (<span dir="ltr">V²</span>) است؛ پس سرعت واقعی خروجی برابر <strong><span dir="ltr">√${etaN.toFixed(2)} = ${(Math.sqrt(etaN) * 100).toFixed(1)}%</span></strong> سرعت ایده‌آل یعنی <strong><span dir="ltr">${V2a.toFixed(0)} m/s</span></strong> (در برابر <span dir="ltr">${V2s.toFixed(0)} m/s</span>) است!`;
    }

    function renderExtended() {
      if (extTsurr >= extTsys - 10) {
        extTsurr = extTsys - 10;
        extTsurrSlider.value = String(extTsurr);
      }
      extTsysLbl.textContent = `${extTsys.toFixed(0)} K`;
      extTsurrLbl.textContent = `${extTsurr.toFixed(0)} K`;
      extQLbl.textContent = `${extQ.toFixed(0)} kJ`;

      const tWallOut = extTsurr + 0.5 * (extTsys - extTsurr);
      const Tb = extBnd === 'inner' ? extTsys : extBnd === 'wall' ? tWallOut : extTsurr;

      const dSsys = -extQ / extTsys;
      const sOut = extQ / Tb;
      const sGenIn = dSsys + sOut;
      const sGenTot = dSsys + extQ / extTsurr;

      p1Title.innerHTML = 'مکان فیزیکی مرز انتخابی و افت دما';
      p1Tag.textContent = `T_b = ${Tb.toFixed(0)} K`;
      p2Title.innerHTML = 'تراز آنتروپی درون مرز انتخابی';
      p2Tag.textContent = `S_gen,in = ${sGenIn.toFixed(2)} kJ/K`;

      extTsysSvg.textContent = `T_sys = ${extTsys} K`;
      extTsurrSvg.textContent = `T_surr = ${extTsurr} K`;

      if (extBnd === 'inner') {
        extBndBox.setAttribute('width', '106');
        extBndBox.setAttribute('stroke', '#059669');
        extBndLbl.setAttribute('fill', '#059669');
        extBndLbl.textContent = `Boundary (a): Inner Wall (T_b = ${extTsys} K)`;
      } else if (extBnd === 'wall') {
        extBndBox.setAttribute('width', '152');
        extBndBox.setAttribute('stroke', '#d97706');
        extBndLbl.setAttribute('fill', '#d97706');
        extBndLbl.textContent = `Boundary (b): Includes Wall (T_b = ${tWallOut.toFixed(0)} K)`;
      } else {
        extBndBox.setAttribute('width', '228');
        extBndBox.setAttribute('stroke', '#0284c7');
        extBndLbl.setAttribute('fill', '#0284c7');
        extBndLbl.textContent = `Boundary (c): Extended to Ambient (T_b = ${extTsurr} K)`;
      }
      extSub.textContent = `S_gen inside boundary = ${sGenIn.toFixed(2)} kJ/K (Total = ${sGenTot.toFixed(2)})`;

      const maxS = Math.max(4, extQ / extTsurr);
      const pxPerS = 84 / maxS;
      const zeroY = 126;

      const hSys = Math.min(72, Math.abs(dSsys) * pxPerS);
      ebDsys.setAttribute('y', String(zeroY));
      ebDsys.setAttribute('height', Math.max(2, hSys).toFixed(1));
      ebDsysV.setAttribute('y', (zeroY + hSys + 13).toFixed(1));
      ebDsysV.textContent = dSsys.toFixed(2);

      const hOut = Math.min(88, sOut * pxPerS);
      ebSout.setAttribute('y', (zeroY - hOut).toFixed(1));
      ebSout.setAttribute('height', Math.max(2, hOut).toFixed(1));
      ebSoutV.setAttribute('y', Math.max(36, zeroY - hOut - 6).toFixed(1));
      ebSoutV.textContent = `+${sOut.toFixed(2)}`;

      const hGen = Math.min(88, sGenIn * pxPerS);
      ebSgen.setAttribute('y', (zeroY - Math.max(2, hGen)).toFixed(1));
      ebSgen.setAttribute('height', Math.max(2, hGen).toFixed(1));
      ebSgenV.setAttribute('y', Math.max(36, zeroY - Math.max(2, hGen) - 6).toFixed(1));
      ebSgenV.textContent = `+${sGenIn.toFixed(2)}`;

      ebEq.textContent = `S_gen,in = ${dSsys.toFixed(2)} + ${sOut.toFixed(2)} = +${sGenIn.toFixed(2)} kJ/K`;

      m1Lbl.innerHTML = 'تغییر آنتروپی سیستم (<span dir="ltr">ΔS_sys</span>)';
      m2Lbl.innerHTML = 'آنتروپی خروجی با گرما <span dir="ltr">(Q / T_b)</span>';
      m3Lbl.innerHTML = 'آنتروپی تولیدی درون مرز (<span dir="ltr">S_gen,in</span>)';
      m4Lbl.innerHTML = 'آنتروپی تولیدی کل جهان (<span dir="ltr">S_gen,total</span>)';

      m1Val.textContent = `${dSsys.toFixed(2)} kJ/K`;
      m2Val.textContent = `+${sOut.toFixed(2)} kJ/K`;
      m3Val.textContent = `+${sGenIn.toFixed(2)} kJ/K`;
      m4Val.textContent = `+${sGenTot.toFixed(2)} kJ/K`;

      explainEl.innerHTML = extBnd === 'inner'
        ? `وقتی <strong>مرز روی دیوارهٔ داخلی</strong> است <span dir="ltr">(T_b = T_sys = ${extTsys} K)</span>، درون سیستم هیچ افت دمایی نیست و <strong><span dir="ltr">S_gen,in = 0.00 kJ/K</span></strong> می‌شود؛ یعنی تمام تولید آنتروپی بیرون از مرز (درون دیواره و لایهٔ مرزی هوا) رخ می‌دهد.`
        : extBnd === 'wall'
          ? `با گسترش مرز تا <strong>سطح بیرونی دیواره</strong> <span dir="ltr">(T_b = ${tWallOut.toFixed(0)} K)</span>، بخشی از تولید آنتروپی <span dir="ltr">(+${sGenIn.toFixed(2)} kJ/K)</span> داخل مرز دیده می‌شود، ولی تولید آنتروپی لایهٔ هوا هنوز بیرون مرز مانده است.`
          : `با <strong>ترفند مرز گسترش‌یافته تا دمای محیط</strong> <span dir="ltr">(T_b = T_surr = ${extTsurr} K)</span>، تمام افت دما درون مرز قرار می‌گیرد و کل آنتروپی تولیدی فرآیند یعنی <strong><span dir="ltr">S_gen,total = +${sGenTot.toFixed(2)} kJ/K</span></strong> یکجا محاسبه می‌شود!`;
    }

    function renderAll() {
      if (mode === 'turbine') renderTurbine();
      else if (mode === 'compressor') renderCompressor();
      else if (mode === 'nozzle') renderNozzle();
      else renderExtended();
    }

    const anim = createAnimController(root, (dt) => {
      if (mode === 'extended') return false;
      dashOffset = (dashOffset + dt * 30) % 22;
      flowIn.setAttribute('stroke-dashoffset', (-dashOffset).toFixed(1));
      flowOut.setAttribute('stroke-dashoffset', (-dashOffset).toFixed(1));
      if (mode === 'turbine' || mode === 'compressor') {
        const dir = mode === 'turbine' ? 1 : -1;
        animAngle = (animAngle + dir * dt * 160) % 360;
        rotorEl.setAttribute('transform', `translate(135, 68) rotate(${animAngle.toFixed(1)})`);
      }
    });

    root.querySelectorAll('#iel-modes button').forEach((btn) => {
      btn.addEventListener('click', () => {
        root.querySelectorAll('#iel-modes button').forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        mode = (btn.getAttribute('data-mode') as LabMode) || 'turbine';

        turbCtrls.style.display = mode === 'turbine' ? '' : 'none';
        compCtrls.style.display = mode === 'compressor' ? '' : 'none';
        nozCtrls.style.display = mode === 'nozzle' ? '' : 'none';
        extCtrls.style.display = mode === 'extended' ? '' : 'none';

        const isExt = mode === 'extended';
        diagSvg.style.display = isExt ? 'none' : 'block';
        devSvg.style.display = isExt ? 'none' : 'block';
        extSchemSvg.style.display = isExt ? 'block' : 'none';
        extBarsSvg.style.display = isExt ? 'block' : 'none';

        if (isExt) anim.stop();
        else anim.start();
        renderAll();
      });
    });

    root.querySelectorAll('#iel-turb-plots button').forEach((btn) => {
      btn.addEventListener('click', () => {
        root.querySelectorAll('#iel-turb-plots button').forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        turbPlot = (btn.getAttribute('data-plot') as TurbPlot) || 'hs';
        renderTurbine();
      });
    });

    root.querySelectorAll('#iel-boundaries button').forEach((btn) => {
      btn.addEventListener('click', () => {
        root.querySelectorAll('#iel-boundaries button').forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        extBnd = (btn.getAttribute('data-bnd') as BndType) || 'inner';
        renderExtended();
      });
    });

    etaTSlider.addEventListener('input', () => {
      etaT = parseFloat(etaTSlider.value) / 100;
      renderTurbine();
    });
    etaCSlider.addEventListener('input', () => {
      etaC = parseFloat(etaCSlider.value) / 100;
      renderCompressor();
    });
    etaNSlider.addEventListener('input', () => {
      etaN = parseFloat(etaNSlider.value) / 100;
      renderNozzle();
    });

    extTsysSlider.addEventListener('input', () => {
      extTsys = parseFloat(extTsysSlider.value);
      renderExtended();
    });
    extTsurrSlider.addEventListener('input', () => {
      extTsurr = parseFloat(extTsurrSlider.value);
      renderExtended();
    });
    extQSlider.addEventListener('input', () => {
      extQ = parseFloat(extQSlider.value);
      renderExtended();
    });

    renderAll();
    anim.start();
  })();
</script>
