      lineS.setAttribute('y1', y1.toFixed(1));
      lineS.setAttribute('x2', x2s.toFixed(1));
      lineS.setAttribute('y2', y2s.toFixed(1));

      const xm = (x1 + x2a) / 2 + 4;
