<script>
  import { createViewport, createAnimController } from '../../lib/liveSimKit';
  import { waterPT, waterPS, waterPH, getWaterDome, IDEAL_GASES } from '../../lib/thermoProps';

  (() => {
    const root = document.getElementById('isentropic-eff-lab');
    if (!root) return;

    type LabMode = 'turbine' | 'compressor' | 'nozzle' | 'extended';
    type TurbPlot = 'hs' | 'ts';
    type BndType = 'inner' | 'wall' | 'extended';

    let mode: LabMode = 'turbine';
    let turbPlot: TurbPlot = 'hs';
    let etaT = 0.667;
    let etaC = 0.80;
    let etaN = 0.92;

    let extBnd: BndType = 'inner';
    let extTsys = 400;
    let extTsurr = 300;
    let extQ = 1000;

    let animAngle = 0;
    let dashOffset = 0;

    // داده‌های ثابت مثال ۷-۱۰ (IAPWS-IF97)
    const dome = getWaterDome();
    const tSt1 = waterPT(3000, 400);
    const tSt2s = waterPS(50, tSt1.s);

    // جدول A-17 سنجل برای کمپرسور هوا (مثال ۷-۱۱)
    const AIR_A17: Array<{ T: number; h: number; s0: number }> = [
      { T: 270, h: 270.11, s0: 1.5963 },
      { T: 285, h: 285.14, s0: 1.6508 },
      { T: 300, h: 300.19, s0: 1.7020 },
      { T: 400, h: 400.98, s0: 1.9919 },
      { T: 500, h: 503.02, s0: 2.2195 },
      { T: 513.5, h: 517.05, s0: 2.2470 },
      { T: 569.5, h: 575.03, s0: 2.3540 },
      { T: 620, h: 628.07, s0: 2.4436 },
      { T: 680, h: 691.82, s0: 2.5410 },
      { T: 760, h: 778.18, s0: 2.6601 },
    ];

    function airPropsByT(T: number): { T: number; h: number; s0: number } {
      if (T <= AIR_A17[0].T) return AIR_A17[0];
      for (let i = 0; i < AIR_A17.length - 1; i++) {
        const a = AIR_A17[i];
        const b = AIR_A17[i + 1];
        if (T >= a.T && T <= b.T) {
          const f = (T - a.T) / (b.T - a.T);
          return { T, h: a.h + f * (b.h - a.h), s0: a.s0 + f * (b.s0 - a.s0) };
        }
      }
      return AIR_A17[AIR_A17.length - 1];
    }

    function airPropsByH(h: number): { T: number; h: number; s0: number } {
      if (h <= AIR_A17[0].h) return AIR_A17[0];
      for (let i = 0; i < AIR_A17.length - 1; i++) {
        const a = AIR_A17[i];
        const b = AIR_A17[i + 1];
        if (h >= a.h && h <= b.h) {
          const f = (h - a.h) / (b.h - a.h);
          return { T: a.T + f * (b.T - a.T), h, s0: a.s0 + f * (b.s0 - a.s0) };
        }
      }
      return AIR_A17[AIR_A17.length - 1];
    }

    // پیش‌محاسبه ایزوبارهای توربین 3 MPa و 50 kPa
    function buildWaterIsobar(pKpa: number, sMin: number, sMax: number): Array<{ s: number; h: number; tC: number }> {
      const pts: Array<{ s: number; h: number; tC: number }> = [];
      for (let i = 0; i <= 18; i++) {
        const s = sMin + (i / 18) * (sMax - sMin);
        const st = waterPS(pKpa, s);
        pts.push({ s: st.s, h: st.h, tC: st.tC });
      }
      return pts;
