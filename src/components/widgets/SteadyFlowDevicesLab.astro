---
// آزمایشگر زنده پنج دستگاه جریان پایا با موتور IAPWS-IF97 و داده‌های سنجل (فصل ۵)
---

<div class="jh-widget not-content" id="steady-flow-lab">
  <div class="jh-widget__head">
    <span class="jh-widget__title">آزمایشگر زندهٔ دستگاه‌های جریان پایا (<span dir="ltr">SFEE</span> و تله‌های امتحانی فصل ۵)</span>
    <span class="jh-widget__badge">شبیه‌سازی زنده</span>
  </div>
  <div class="jh-widget__sub" style="margin-bottom:0.65rem">
    مقایسهٔ دبی جرمی و حجمی، تبدیل انرژی در شیپوره و توربین، اختناق <span dir="ltr">(h₁ = h₂)</span> و تلهٔ تغییر مرز مبدل حرارتی
  </div>

  <!-- ۵ تب دستگاه‌های بخش ۴ -->
  <div class="jh-widget__btns" id="sfd-tabs">
    <button type="button" class="jh-widget__btn is-active" data-tab="compressor">۱) کمپرسور (<span dir="ltr">ṁ</span> در برابر <span dir="ltr">V̇</span>)</button>
    <button type="button" class="jh-widget__btn" data-tab="turbine">۲) توربین بخار (<span dir="ltr">5 MW</span>)</button>
    <button type="button" class="jh-widget__btn" data-tab="nozzle">۳) شیپوره (نازل) و دیفیوزر</button>
    <button type="button" class="jh-widget__btn" data-tab="throttling">۴) دریچهٔ اختناق (<span dir="ltr">h₁ = h₂</span>)</button>
    <button type="button" class="jh-widget__btn" data-tab="hx">۵) مبدل حرارتی / اختلاط</button>
  </div>

  <!-- زیرحالت‌های هر دستگاه -->
  <div class="jh-widget__btns" id="sfd-subtabs"></div>

  <!-- کنترل‌های عددی پویا -->
  <div class="jh-widget__grid" id="sfd-sliders">
    <label class="jh-widget__ctrl">
      <span id="sfd-s1-title">نسبت تراکم فشار (<span dir="ltr">P₂ / P₁</span>): <strong id="sfd-s1-lbl" dir="ltr">2.50</strong></span>
      <input id="sfd-s1" type="range" min="1.2" max="6.0" step="0.05" value="2.5" />
    </label>
    <label class="jh-widget__ctrl" id="sfd-s2-wrap">
      <span id="sfd-s2-title">گرمای دفع‌شده (<span dir="ltr">q_out</span>): <strong id="sfd-s2-lbl" dir="ltr">16 kJ/kg</strong></span>
      <input id="sfd-s2" type="range" min="0" max="60" step="1" value="16" />
    </label>
  </div>

  <div class="jh-widget__toolbar">
    <button type="button" class="jh-widget__btn jh-widget__btn--primary" id="sfd-play">▶ پخش جریان</button>
    <button type="button" class="jh-widget__btn" id="sfd-reset">↺ بازنشانی مثال کتاب</button>
    <span class="jh-widget__sub" id="sfd-eq-badge" style="margin-inline-start:auto" dir="ltr">ṁ₁ = ṁ₂ = 2.00 kg/s</span>
  </div>

  <div class="jh-widget__split">
    <!-- پنل ۱: شماتیک زنده جریان -->
    <div class="jh-widget__pane">
      <div class="jh-widget__pane-title">
        <span>شماتیک زندهٔ جریان در دستگاه</span>
        <span dir="ltr" id="sfd-flow-tag">ṁ₁ = ṁ₂ | V̇₂ &lt; V̇₁</span>
      </div>
      <svg id="sfd-flow-svg" viewBox="0 0 320 220" style="width:100%;height:auto;display:block;direction:ltr" aria-label="شماتیک متحرک جریان پایا در دستگاه مهندسی">
        <defs>
          <marker id="sfd-arr-b" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="6" markerHeight="6" orient="auto">
            <path d="M 1 2 L 8 5 L 1 8 z" fill="#0284c7" />
          </marker>
          <marker id="sfd-arr-a" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="6" markerHeight="6" orient="auto">
            <path d="M 1 2 L 8 5 L 1 8 z" fill="#d97706" />
          </marker>
          <marker id="sfd-arr-g" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="6" markerHeight="6" orient="auto">
            <path d="M 1 2 L 8 5 L 1 8 z" fill="#059669" />
          </marker>
          <marker id="sfd-arr-r" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="6" markerHeight="6" orient="auto">
            <path d="M 1 2 L 8 5 L 1 8 z" fill="#ef4444" />
          </marker>
        </defs>

        <!-- پس‌زمینه هندسی دستگاه‌ها -->
        <g id="sfd-bg-layer"></g>

        <!-- ذرات متحرک جریان -->
        <g id="sfd-particles"></g>

        <!-- برچسب‌ها و فلش‌های کار/گرما/مرز کنترل -->
        <g id="sfd-fg-layer"></g>
      </svg>
    </div>

    <!-- پنل ۲: تراز زنده انرژی یا دبی -->
    <div class="jh-widget__pane">
      <div class="jh-widget__pane-title">
        <span id="sfd-bar-title">تراز انرژی <span dir="ltr">(Ė_in = Ė_out)</span></span>
        <span dir="ltr" id="sfd-bar-unit">kJ/kg</span>
      </div>
      <svg id="sfd-bar-svg" viewBox="0 0 320 220" style="width:100%;height:auto;display:block;direction:ltr" aria-label="نمودار میله‌ای تراز انرژی جریان پایا">
        <g id="sfd-bars-layer"></g>
      </svg>
    </div>
  </div>

  <div class="jh-widget__metrics">
    <div class="jh-metric">
      <span class="jh-metric__label" id="sfd-m1-l">وضعیت ورودی (۱)</span>
      <span class="jh-metric__val" id="sfd-m1-v">—</span>
    </div>
    <div class="jh-metric">
      <span class="jh-metric__label" id="sfd-m2-l">وضعیت خروجی (۲)</span>
      <span class="jh-metric__val" id="sfd-m2-v">—</span>
    </div>
    <div class="jh-metric">
      <span class="jh-metric__label" id="sfd-m3-l">مقدار کلیدی / توان</span>
      <span class="jh-metric__val" id="sfd-m3-v">—</span>
    </div>
    <div class="jh-metric" id="sfd-m4-card">
      <span class="jh-metric__label" id="sfd-m4-l">نکتهٔ کلیدی</span>
      <span class="jh-metric__val" id="sfd-m4-v">—</span>
    </div>
  </div>

  <div class="jh-widget__explain" id="sfd-explain"></div>
</div>

<script>
import {
  waterPT,
  waterPH,
  waterPS,
  waterSatByP,
  r134aSatByP,
  IDEAL_GASES,
} from '../../lib/thermoProps';
import { createAnimController } from '../../lib/liveSimKit';

const root = document.getElementById('steady-flow-lab');
if (root) {
  const SVG_NS = 'http://www.w3.org/2000/svg';

  type TabKey = 'compressor' | 'turbine' | 'nozzle' | 'throttling' | 'hx';

  let tab: TabKey = 'compressor';
  let subKey = 'slide7';
  let s1Val = 2.5;
  let s2Val = 16;
  let flowClock = 0;

  const subtabsEl = root.querySelector('#sfd-subtabs')!;
  const s1Slider = root.querySelector('#sfd-s1') as HTMLInputElement;
  const s2Slider = root.querySelector('#sfd-s2') as HTMLInputElement;
  const s2Wrap = root.querySelector('#sfd-s2-wrap') as HTMLElement;
  const s1Title = root.querySelector('#sfd-s1-title')!;
  const s2Title = root.querySelector('#sfd-s2-title')!;
  const playBtn = root.querySelector('#sfd-play') as HTMLButtonElement;
  const resetBtn = root.querySelector('#sfd-reset') as HTMLButtonElement;

  const eqBadge = root.querySelector('#sfd-eq-badge')!;
  const flowTag = root.querySelector('#sfd-flow-tag')!;
  const bgLayer = root.querySelector('#sfd-bg-layer')!;
  const particlesLayer = root.querySelector('#sfd-particles')!;
  const fgLayer = root.querySelector('#sfd-fg-layer')!;
  const barTitle = root.querySelector('#sfd-bar-title')!;
  const barUnit = root.querySelector('#sfd-bar-unit')!;
  const barsLayer = root.querySelector('#sfd-bars-layer')!;

  const m1L = root.querySelector('#sfd-m1-l')!;
  const m1V = root.querySelector('#sfd-m1-v')!;
  const m2L = root.querySelector('#sfd-m2-l')!;
  const m2V = root.querySelector('#sfd-m2-v')!;
  const m3L = root.querySelector('#sfd-m3-l')!;
  const m3V = root.querySelector('#sfd-m3-v')!;
  const m4Card = root.querySelector('#sfd-m4-card')!;
  const m4L = root.querySelector('#sfd-m4-l')!;
  const m4V = root.querySelector('#sfd-m4-v')!;
  const explainEl = root.querySelector('#sfd-explain')!;

  interface Particle {
    u: number;
    lane: number; // -1..+1
    stream: number; // 0 = main/hot, 1 = cold
    el: SVGCircleElement;
  }

  const particles: Particle[] = [];
  for (let i = 0; i < 24; i++) {
    const el = document.createElementNS(SVG_NS, 'circle');
    el.setAttribute('r', '3.1');
    particlesLayer.appendChild(el);
    particles.push({
      u: (i % 12) / 12,
      lane: ((i * 7) % 5) / 2 - 1, // -1, -0.5, 0, 0.5, 1
      stream: i < 12 ? 0 : 1,
      el,
    });
  }

  function svgEl(tag: string, attrs: Record<string, string | number>, text?: string): SVGElement {
    const el = document.createElementNS(SVG_NS, tag);
    for (const [k, v] of Object.entries(attrs)) {
      el.setAttribute(k, String(v));
    }
    if (text !== undefined) el.textContent = text;
    return el;
  }

  interface SubTabDef {
    key: string;
    label: string;
  }

  const SUBTABS: Record<TabKey, SubTabDef[]> = {
    compressor: [
      { key: 'slide7', label: 'تلهٔ اسلاید ۷ (ṁ ثابت، V̇ کوچک‌شونده)' },
      { key: 'ex54', label: 'مثال ۵-۴: کمپرسور هوا (280 → 400 K)' },
    ],
    turbine: [{ key: 'ex55', label: 'مثال ۵-۵: توربین بخار آدیاباتیک ۵ MW (IAPWS-IF97)' }],
    nozzle: [
      { key: 'ex53', label: 'مثال ۵-۳: دیفیوزر موتور جت (200 m/s → 0)' },
      { key: 'noz-steam', label: 'نازل همگرا بخار (شتاب‌دهنده IAPWS-IF97)' },
    ],
    throttling: [
      { key: 'ex56', label: 'مثال ۵-۶: مبرد R-134a (0.8 MPa → 0.12 MPa)' },
      { key: 'throt-steam', label: 'بخار/آب واقعی (IAPWS-IF97 solvePH)' },
    ],
    hx: [
      { key: 'ex57-whole', label: 'مرز ۱: دور کل مبدل (Q̇_CV = 0)' },
      { key: 'ex57-cold', label: 'مرز ۲: فقط دور لوله آب سرد (Q̇ ≠ 0!)' },
      { key: 'mix', label: 'محفظهٔ اختلاط عایق (آب سرد + بخار گرم)' },
    ],
  };

  function configureControls(resetDefaults: boolean) {
    const list = SUBTABS[tab];
    if (!list.some((x) => x.key === subKey)) subKey = list[0].key;

    subtabsEl.innerHTML = '';
    for (const item of list) {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = `jh-widget__btn${item.key === subKey ? ' is-active' : ''}`;
      btn.textContent = item.label;
      btn.addEventListener('click', () => {
        subKey = item.key;
        configureControls(true);
        render();
      });
      subtabsEl.appendChild(btn);
    }

    if (tab === 'compressor' && subKey === 'slide7') {
      s1Slider.min = '1.2';
      s1Slider.max = '4.0';
      s1Slider.step = '0.05';
      if (resetDefaults) s1Val = 1.75; // Vdot1=1.4 -> Vdot2=0.8 (rV = 1.75)
      s2Wrap.style.display = 'none';
    } else if (tab === 'compressor' && subKey === 'ex54') {
      s1Slider.min = '340';
      s1Slider.max = '520';
      s1Slider.step = '5';
      if (resetDefaults) s1Val = 400;
      s2Wrap.style.display = '';
      s2Slider.min = '0';
      s2Slider.max = '45';
      s2Slider.step = '1';
      if (resetDefaults) s2Val = 16;
    } else if (tab === 'turbine') {
      s1Slider.min = '0.84';
      s1Slider.max = '1.00';
      s1Slider.step = '0.01';
      if (resetDefaults) s1Val = 0.9;
      s2Wrap.style.display = '';
      s2Slider.min = '50';
      s2Slider.max = '260';
      s2Slider.step = '10';
      if (resetDefaults) s2Val = 180;
    } else if (tab === 'nozzle' && subKey === 'ex53') {
      s1Slider.min = '100';
      s1Slider.max = '320';
      s1Slider.step = '10';
      if (resetDefaults) s1Val = 200;
      s2Wrap.style.display = 'none';
    } else if (tab === 'nozzle' && subKey === 'noz-steam') {
      s1Slider.min = '100';
      s1Slider.max = '480';
      s1Slider.step = '10';
      if (resetDefaults) s1Val = 200;
      s2Wrap.style.display = 'none';
    } else if (tab === 'throttling' && subKey === 'ex56') {
      s1Slider.min = '60';
      s1Slider.max = '600';
      s1Slider.step = '10';
      if (resetDefaults) s1Val = 120;
      s2Wrap.style.display = 'none';
    } else if (tab === 'throttling' && subKey === 'throt-steam') {
      s1Slider.min = '20';
      s1Slider.max = '800';
      s1Slider.step = '10';
      if (resetDefaults) s1Val = 100;
      s2Wrap.style.display = 'none';
    } else if (tab === 'hx' && (subKey === 'ex57-whole' || subKey === 'ex57-cold')) {
      s1Slider.min = '2';
      s1Slider.max = '12';
      s1Slider.step = '0.5';
      if (resetDefaults) s1Val = 6; // kg/min R-134a
      s2Wrap.style.display = '';
      s2Slider.min = '20';
      s2Slider.max = '35';
      s2Slider.step = '1';
      if (resetDefaults) s2Val = 25; // water exit C
    } else if (tab === 'hx' && subKey === 'mix') {
      s1Slider.min = '0.1';
      s1Slider.max = '1.0';
      s1Slider.step = '0.05';
      if (resetDefaults) s1Val = 0.25; // m_steam / m_cold
      s2Wrap.style.display = 'none';
    }

    s1Slider.value = String(s1Val);
    s2Slider.value = String(s2Val);
  }

  function drawStackedBars(
    leftTitle: string,
    rightTitle: string,
    leftSegs: Array<{ label: string; val: number; color: string }>,
    rightSegs: Array<{ label: string; val: number; color: string }>,
    unitStr: string
  ) {
    barsLayer.innerHTML = '';
    const leftSum = leftSegs.reduce((a, b) => a + Math.max(0, b.val), 0);
    const rightSum = rightSegs.reduce((a, b) => a + Math.max(0, b.val), 0);
    const maxTotal = Math.max(leftSum, rightSum, 1e-3);
    const baseY = 186;
    const maxH = 148;

    barsLayer.appendChild(svgEl('line', { x1: 24, y1: baseY, x2: 296, y2: baseY, stroke: 'currentColor', 'stroke-opacity': 0.5, 'stroke-width': 1.8 }));
    barsLayer.appendChild(svgEl('text', { x: 86, y: 204, 'text-anchor': 'middle', fill: 'currentColor', 'font-size': 10.5, 'font-weight': 800 }, leftTitle));
    barsLayer.appendChild(svgEl('text', { x: 234, y: 204, 'text-anchor': 'middle', fill: 'currentColor', 'font-size': 10.5, 'font-weight': 800 }, rightTitle));

    const drawCol = (cx: number, segs: typeof leftSegs, total: number) => {
      let curY = baseY;
      for (const seg of segs) {
        if (seg.val <= 0) continue;
        const h = Math.max(2, (seg.val / maxTotal) * maxH);
        const yTop = curY - h;
        barsLayer.appendChild(
          svgEl('rect', {
            x: cx - 36,
            y: yTop.toFixed(1),
            width: 72,
            height: h.toFixed(1),
            rx: 4,
            fill: seg.color,
            'fill-opacity': 0.85,
            stroke: '#ffffff',
            'stroke-opacity': 0.35,
            'stroke-width': 1,
          })
        );
        if (h >= 16) {
          barsLayer.appendChild(
            svgEl(
              'text',
              {
                x: cx,
                y: (yTop + h / 2 + 3.5).toFixed(1),
                'text-anchor': 'middle',
                fill: '#ffffff',
                'font-size': 9.2,
                'font-weight': 800,
              },
              `${seg.label}: ${seg.val >= 100 ? seg.val.toFixed(0) : seg.val.toFixed(1)}`
            )
          );
        }
        curY = yTop;
      }
      barsLayer.appendChild(
        svgEl(
          'text',
          {
            x: cx,
            y: Math.max(16, curY - 6).toFixed(1),
            'text-anchor': 'middle',
            fill: 'currentColor',
            'font-size': 9.5,
            'font-weight': 800,
          },
          `Σ = ${total >= 100 ? total.toFixed(1) : total.toFixed(2)} ${unitStr}`
        )
      );
    };

    drawCol(86, leftSegs, leftSum);
    drawCol(234, rightSegs, rightSum);
  }

  function render() {
    bgLayer.innerHTML = '';
    fgLayer.innerHTML = '';
    m4Card.classList.remove('jh-metric--warn');

    if (tab === 'compressor' && subKey === 'slide7') {
      const mdot = 2.0; // kg/s
      const vdot1 = 1.4; // m3/s
      const vdot2 = vdot1 / s1Val; // shrink by compression ratio
      s1Title.innerHTML = `نسبت کاهش حجم (<span dir="ltr">V̇₁ / V̇₂</span>): <strong dir="ltr">${s1Val.toFixed(2)}×</strong>`;
      eqBadge.textContent = `ṁ₁ = ṁ₂ = ${mdot.toFixed(2)} kg/s`;
      flowTag.textContent = `V̇₁=${vdot1.toFixed(2)} → V̇₂=${vdot2.toFixed(2)} m³/s`;
      barTitle.innerHTML = 'تلهٔ امتحانی: بقای جرم (<span dir="ltr">ṁ</span>) در برابر <span dir="ltr">V̇</span>';
      barUnit.textContent = 'kg/s vs m³/s';

      // بدنه کمپرسور (ورودی پهن چپ -> خروجی تنگ راست)
      bgLayer.appendChild(
        svgEl('path', {
          d: 'M 18 54 L 94 54 L 226 78 L 302 78 L 302 142 L 226 142 L 94 166 L 18 166 Z',
          fill: 'currentColor',
          'fill-opacity': 0.05,
          stroke: 'currentColor',
          'stroke-opacity': 0.68,
          'stroke-width': 2.5,
        })
      );
      // پره‌های کمپرسور
      for (const rx of [125, 155, 185]) {
        bgLayer.appendChild(svgEl('line', { x1: rx, y1: 68, x2: rx, y2: 152, stroke: '#64748b', 'stroke-width': 3, 'stroke-dasharray': '7 4' }));
      }
      // فلش کار ورودی
      fgLayer.appendChild(svgEl('line', { x1: 160, y1: 196, x2: 160, y2: 162, stroke: '#d97706', 'stroke-width': 2.8, 'marker-end': 'url(#sfd-arr-a)' }));
      fgLayer.appendChild(svgEl('text', { x: 160, y: 211, 'text-anchor': 'middle', fill: '#d97706', 'font-size': 10.5, 'font-weight': 800 }, 'W_in (+)'));
      fgLayer.appendChild(svgEl('text', { x: 52, y: 42, 'text-anchor': 'middle', fill: '#0284c7', 'font-size': 9.5, 'font-weight': 800 }, `ṁ₁=2.0 | V̇₁=1.40`));
      fgLayer.appendChild(svgEl('text', { x: 266, y: 66, 'text-anchor': 'middle', fill: '#ef4444', 'font-size': 9.5, 'font-weight': 800 }, `ṁ₂=2.0 | V̇₂=${vdot2.toFixed(2)}`));

      // ذرات فشرده‌شونده: سرعت کمتر در خروجی متراکم‌تر
      particles.forEach((p, idx) => {
        if (idx >= 18) { p.el.style.display = 'none'; return; }
        p.el.style.display = '';
        const u = (p.u + flowClock * 0.25) % 1;
        const x = 22 + u * 276;
        const halfH = u < 0.27 ? 44 : u > 0.72 ? 23 : 44 - ((u - 0.27) / 0.45) * 21;
        const y = 110 + p.lane * halfH * 0.75;
        p.el.setAttribute('cx', x.toFixed(1));
        p.el.setAttribute('cy', y.toFixed(1));
        p.el.setAttribute('fill', u > 0.55 ? '#d97706' : '#0284c7');
      });

      // نمودار مقایسه ṁ ثابت و V̇ متغیر
      barsLayer.innerHTML = '';
      barsLayer.appendChild(svgEl('line', { x1: 24, y1: 184, x2: 296, y2: 184, stroke: 'currentColor', 'stroke-opacity': 0.5, 'stroke-width': 1.8 }));
      const items = [
        { x: 56, h: 120, col: '#059669', lbl: 'ṁ₁', val: '2.00 kg/s' },
        { x: 112, h: 120, col: '#059669', lbl: 'ṁ₂', val: '2.00 kg/s' },
        { x: 204, h: 112, col: '#0284c7', lbl: 'V̇₁', val: '1.40 m³/s' },
        { x: 260, h: Math.max(22, (vdot2 / 1.4) * 112), col: '#ef4444', lbl: 'V̇₂', val: `${vdot2.toFixed(2)} m³/s` },
      ];
      for (const it of items) {
        const yTop = 184 - it.h;
        barsLayer.appendChild(svgEl('rect', { x: it.x - 19, y: yTop.toFixed(1), width: 38, height: it.h.toFixed(1), rx: 4, fill: it.col, 'fill-opacity': 0.85 }));
        barsLayer.appendChild(svgEl('text', { x: it.x, y: (yTop - 6).toFixed(1), 'text-anchor': 'middle', fill: it.col, 'font-size': 9.2, 'font-weight': 800 }, it.val));
        barsLayer.appendChild(svgEl('text', { x: it.x, y: 202, 'text-anchor': 'middle', fill: 'currentColor', 'font-size': 10.5, 'font-weight': 800 }, it.lbl));
      }
      barsLayer.appendChild(svgEl('text', { x: 84, y: 24, 'text-anchor': 'middle', fill: '#059669', 'font-size': 10, 'font-weight': 800 }, 'ṁ₁ = ṁ₂ (Conserved!)'));
      barsLayer.appendChild(svgEl('text', { x: 232, y: 24, 'text-anchor': 'middle', fill: '#ef4444', 'font-size': 10, 'font-weight': 800 }, 'V̇₁ ≠ V̇₂ (Compresses!)'));

