      fgLayer.appendChild(svgEl('text', { x: 64, y: 62, 'text-anchor': 'middle', fill: '#ef4444', 'font-size': 9.5, 'font-weight': 800 }, `P₁=${subKey === 'ex56' ? '800' : '1000'} kPa (${T1C.toFixed(1)}°C)`));
      fgLayer.appendChild(svgEl('text', { x: 252, y: 62, 'text-anchor': 'middle', fill: '#0284c7', 'font-size': 9.5, 'font-weight': 800 }, `P₂=${P2} kPa (${T2C.toFixed(1)}°C)`));
      fgLayer.appendChild(svgEl('text', { x: 252, y: 164, 'text-anchor': 'middle', fill: '#059669', 'font-size': 9.5, 'font-weight': 800 }, `Flash Vapor x₂=${x2 !== null ? (x2 * 100).toFixed(1) + '%' : '0%'}`));

      particles.forEach((p, idx) => {
        if (idx >= 20) { p.el.style.display = 'none'; return; }
        p.el.style.display = '';
        const u = (p.u + flowClock * 0.3) % 1;
        const x = 22 + u * 276;
        const halfH = Math.abs(u - 0.5) < 0.09 ? 10 : 28;
        p.el.setAttribute('cx', x.toFixed(1));
        p.el.setAttribute('cy', (110 + p.lane * halfH * 0.8).toFixed(1));
        if (u < 0.48) {
          p.el.setAttribute('fill', '#ef4444');
          p.el.setAttribute('r', '3.3');
        } else {
          // پس از شیر، بخشی قطره مایع و بخشی حباب بخار
          const isVap = idx % 3 === 0;
          p.el.setAttribute('fill', isVap ? '#38bdf8' : '#0284c7');
          p.el.setAttribute('r', isVap ? '2.2' : '3.4');
        }
      });

      const liqPart = x2 !== null ? (1 - x2) * hf2 : h1;
      const vapPart = x2 !== null ? x2 * hg2 : 0;
      drawStackedBars(
        'Inlet h₁',
        'Outlet h₂',
        [{ label: 'h₁ (sat liq)', val: h1, color: '#ef4444' }],
        [
          { label: '(1-x₂)h_f', val: liqPart, color: '#0284c7' },
          { label: 'x₂·h_g', val: vapPart, color: '#38bdf8' },
        ],
        'kJ/kg'
      );

      m1L.textContent = 'ورودی اشباع (۱)';
      m1V.textContent = `${T1C.toFixed(2)} °C | h₁=${h1.toFixed(1)}`;
      m2L.textContent = 'خروجی دوفازی (۲)';
      m2V.textContent = `${T2C.toFixed(2)} °C | h₂=${h1.toFixed(1)}`;
      m3L.textContent = 'کیفیت بخار ناگهانی (x₂)';
      m3V.textContent = x2 !== null ? `${x2.toFixed(3)} (${(x2 * 100).toFixed(1)}%)` : '—';
      m4L.textContent = 'افت دما (ΔT)';
      m4V.textContent = `${dT.toFixed(2)} °C`;
      explainEl.innerHTML = `در <strong>${fluidName}</strong>، فرآیند اختناق <strong>هم‌آنتالپی (<span dir="ltr">h₁ = h₂ = ${h1.toFixed(2)} kJ/kg</span>)</strong> است. افت فشار ناگهانی باعث می‌شود بخشی از مایع داغ با جذب گرمای نهان از بقیهٔ سیال بخار شود (<span dir="ltr">x₂ = ${x2?.toFixed(3)}</span>) و دمای کل جریان <span dir="ltr">${Math.abs(dT).toFixed(2)} °C</span> سقوط کند!`;
    } else if (tab === 'hx' && (subKey === 'ex57-whole' || subKey === 'ex57-cold')) {
      const mR_min = s1Val; // kg/min
      const Tw2 = s2Val; // C
      const hR3 = 303.85; // Table A-13 1MPa, 70C
      const hR4 = 100.87; // sat liq 35C
      const wIn = waterPT(300, 15);
      const wOut = waterPT(300, Tw2);
      const qTransferMin = mR_min * (hR3 - hR4); // kJ/min
      const qKw = qTransferMin / 60;
      const mW_min = qTransferMin / (wOut.h - wIn.h);
      const isColdOnly = subKey === 'ex57-cold';

      s1Title.innerHTML = `دبی مبرد <span dir="ltr">R-134a (ṁ_R)</span>: <strong dir="ltr">${mR_min.toFixed(1)} kg/min</strong>`;
      s2Title.innerHTML = `دمای خروجی آب سرد (<span dir="ltr">T_w2</span>): <strong dir="ltr">${Tw2.toFixed(0)} °C</strong>`;
      eqBadge.textContent = isColdOnly ? `Q̇_CS = +${qKw.toFixed(1)} kW (≠ 0)` : 'Q̇_CS = 0 (کل مبدل عایق)';
      flowTag.textContent = isColdOnly ? 'Boundary: Cold Tube Only' : 'Boundary: Whole HX Shell';
      barTitle.innerHTML = isColdOnly ? 'تراز روی لوله آب (<span dir="ltr">Q̇_in ≠ 0</span>)' : 'تراز کل مبدل (<span dir="ltr">Q̇ = 0</span>)';
      barUnit.textContent = 'kW';

      // پوسته مبدل و لوله آب داخلی
      bgLayer.appendChild(svgEl('rect', { x: 46, y: 40, width: 228, height: 140, rx: 14, fill: 'currentColor', 'fill-opacity': 0.04, stroke: 'currentColor', 'stroke-opacity': 0.6, 'stroke-width': 2.2 }));
      bgLayer.appendChild(svgEl('rect', { x: 16, y: 120, width: 288, height: 34, rx: 4, fill: '#0284c7', 'fill-opacity': 0.14, stroke: '#0284c7', 'stroke-width': 2 }));
      bgLayer.appendChild(svgEl('path', { d: 'M 16 64 L 296 64', stroke: '#ef4444', 'stroke-width': 1.5, 'stroke-dasharray': '3 3', 'stroke-opacity': 0.4 }));

      // فلش‌های انتقال حرارت داخلی از R-134a به آب
      for (const hxX of [100, 160, 220]) {
        fgLayer.appendChild(svgEl('line', { x1: hxX, y1: 88, x2: hxX, y2: 117, stroke: '#d97706', 'stroke-width': 2.2, 'marker-end': 'url(#sfd-arr-a)' }));
      }
      fgLayer.appendChild(svgEl('text', { x: 160, y: 100, 'text-anchor': 'middle', fill: '#d97706', 'font-size': 9.2, 'font-weight': 800 }, `Q̇ = ${qKw.toFixed(1)} kW`));

      // مرز حجم کنترل انتخابی (کل مبدل یا فقط لوله آب)
      if (!isColdOnly) {
        fgLayer.appendChild(svgEl('rect', { x: 34, y: 28, width: 252, height: 164, rx: 16, fill: 'none', stroke: '#059669', 'stroke-width': 2.6, 'stroke-dasharray': '6 4' }));
        fgLayer.appendChild(svgEl('text', { x: 160, y: 20, 'text-anchor': 'middle', fill: '#059669', 'font-size': 10, 'font-weight': 800 }, 'CS: Whole HX → Q̇_CV = 0'));
      } else {
        fgLayer.appendChild(svgEl('rect', { x: 38, y: 112, width: 244, height: 50, rx: 8, fill: 'none', stroke: '#ef4444', 'stroke-width': 2.6, 'stroke-dasharray': '6 4' }));
        fgLayer.appendChild(svgEl('text', { x: 160, y: 20, 'text-anchor': 'middle', fill: '#ef4444', 'font-size': 10, 'font-weight': 800 }, `CS: Cold Tube → Q̇_in = +${qKw.toFixed(1)} kW`));
      }
      fgLayer.appendChild(svgEl('text', { x: 64, y: 56, 'text-anchor': 'middle', fill: '#ef4444', 'font-size': 9, 'font-weight': 700 }, 'R-134a: 70→35°C'));
      fgLayer.appendChild(svgEl('text', { x: 256, y: 173, 'text-anchor': 'middle', fill: '#0284c7', 'font-size': 9, 'font-weight': 700 }, `Water: 15→${Tw2}°C`));

      particles.forEach((p, idx) => {
        p.el.style.display = '';
        const u = (p.u + flowClock * 0.25) % 1;
        const x = 20 + u * 280;
        p.el.setAttribute('cx', x.toFixed(1));
        if (p.stream === 0) {
          p.el.setAttribute('cy', (64 + p.lane * 8).toFixed(1));
          p.el.setAttribute('fill', u > 0.55 ? '#d97706' : '#ef4444');
        } else {
          p.el.setAttribute('cy', (137 + p.lane * 7).toFixed(1));
          p.el.setAttribute('fill', u > 0.55 ? '#059669' : '#0284c7');
        }
      });

      const eR3 = (mR_min / 60) * hR3;
      const eR4 = (mR_min / 60) * hR4;
      const eW1 = (mW_min / 60) * wIn.h;
      const eW2 = (mW_min / 60) * wOut.h;

      if (!isColdOnly) {
        drawStackedBars(
          'Inlet Streams',
          'Outlet Streams',
          [
            { label: 'ṁ_R h₃', val: eR3, color: '#ef4444' },
            { label: 'ṁ_w h₁', val: eW1, color: '#0284c7' },
          ],
          [
            { label: 'ṁ_R h₄', val: eR4, color: '#d97706' },
            { label: 'ṁ_w h₂', val: eW2, color: '#059669' },
          ],
          'kW'
        );
      } else {
        drawStackedBars(
          'Water IN + Q̇',
          'Water OUT',
          [
            { label: 'ṁ_w h₁', val: eW1, color: '#0284c7' },
            { label: 'Q̇_in', val: qKw, color: '#ef4444' },
          ],
          [{ label: 'ṁ_w h₂', val: eW2, color: '#059669' }],
          'kW'
        );
      }

      m1L.textContent = 'دبی آب خنک‌کننده (ṁ_w)';
      m1V.textContent = `${mW_min.toFixed(1)} kg/min`;
      m2L.textContent = 'گرمای منتقل‌شده بین دو سیال';
      m2V.textContent = `${qTransferMin.toFixed(0)} kJ/min (${qKw.toFixed(1)} kW)`;
      m3L.textContent = 'گرمای عبوری از مرز انتخابی';
      m3V.textContent = isColdOnly ? `+${qKw.toFixed(1)} kW` : '0.0 kW (عایق)';
      if (isColdOnly) m4Card.classList.add('jh-metric--warn');
      m4L.textContent = 'تفسیر مرز کنترل';
      m4V.textContent = isColdOnly ? 'مرز بین ۲ سیال → Q ≠ 0' : 'مرز کل مبدل → Q = 0';
      explainEl.innerHTML = isColdOnly
        ? `با تنگ‌کردن مرز کنترل فقط به دور <strong>لولهٔ آب سرد</strong>، شار حرارتی از میان خط‌چین مرز عبور می‌کند؛ پس دیگر <span dir="ltr">Q̇ = 0</span> نیست و مستقیماً برابر <strong><span dir="ltr">Q̇_in = ṁ_w(h₂ - h₁) = +${qKw.toFixed(1)} kW</span></strong> محاسبه می‌شود!`
        : `وقتی مرز کنترل را دور <strong>کل مبدل عایق</strong> می‌کشید (<span dir="ltr">Q̇_CV = 0</span>)، گرمای داخلی میان <span dir="ltr">R-134a</span> و آب دیده نمی‌شود و تراز انرژی دبی آب را دقیقاً <strong><span dir="ltr">${mW_min.toFixed(1)} kg/min</span></strong> می‌دهد.`;
    } else if (tab === 'hx' && subKey === 'mix') {
      const ratio = s1Val; // m_hot / m_cold
      const mCold = 2.0; // kg/s at 20 C, 200 kPa
      const mHot = mCold * ratio; // steam at 180 C, 200 kPa
      const stC = waterPT(200, 20);
      const stH = waterPT(200, 180);
      const mMix = mCold + mHot;
      const hMix = (mCold * stC.h + mHot * stH.h) / mMix;
      const stMix = waterPH(200, hMix);

      s1Title.innerHTML = `نسبت جرم بخار گرم به آب سرد (<span dir="ltr">ṁ_hot / ṁ_cold</span>): <strong dir="ltr">${ratio.toFixed(2)}</strong>`;
      eqBadge.textContent = `T_mix = ${stMix.tC.toFixed(1)} °C`;
      flowTag.textContent = `20°C + 180°C → ${stMix.tC.toFixed(1)}°C`;
      barTitle.innerHTML = 'تراز اختلاط عایق (<span dir="ltr">ṁ₁h₁ + ṁ₂h₂ = ṁ₃h₃</span>)';
      barUnit.textContent = 'kW';

      // محفظه اختلاط Y شکل
      bgLayer.appendChild(svgEl('path', { d: 'M 18 44 L 116 44 L 154 78 L 302 78 L 302 142 L 154 142 L 116 176 L 18 176 L 18 134 L 90 134 L 106 110 L 90 86 L 18 86 Z', fill: 'currentColor', 'fill-opacity': 0.05, stroke: 'currentColor', 'stroke-opacity': 0.68, 'stroke-width': 2.3 }));
      fgLayer.appendChild(svgEl('text', { x: 56, y: 36, 'text-anchor': 'middle', fill: '#ef4444', 'font-size': 9.2, 'font-weight': 800 }, `Steam 180°C (${mHot.toFixed(2)} kg/s)`));
      fgLayer.appendChild(svgEl('text', { x: 56, y: 192, 'text-anchor': 'middle', fill: '#0284c7', 'font-size': 9.2, 'font-weight': 800 }, `Water 20°C (${mCold.toFixed(1)} kg/s)`));
      fgLayer.appendChild(svgEl('text', { x: 242, y: 66, 'text-anchor': 'middle', fill: '#059669', 'font-size': 9.5, 'font-weight': 800 }, `Mix: ${stMix.tC.toFixed(1)}°C (${stMix.phase === 'مایع متراکم' ? 'Liq' : stMix.x !== null ? 'x=' + stMix.x.toFixed(2) : 'Vap'})`));

      particles.forEach((p) => {
        p.el.style.display = '';
        const u = (p.u + flowClock * 0.28) % 1;
        const x = 22 + u * 276;
        let y = 110;
        if (u < 0.45) {
          y = p.stream === 0 ? 64 + p.lane * 10 : 155 + p.lane * 10;
        } else {
          y = 110 + p.lane * 20;
        }
        p.el.setAttribute('cx', x.toFixed(1));
        p.el.setAttribute('cy', y.toFixed(1));
        p.el.setAttribute('fill', u > 0.48 ? '#059669' : p.stream === 0 ? '#ef4444' : '#0284c7');
      });

      drawStackedBars(
        'Inlets Σṁ_i h_i',
        'Mixture ṁ₃ h₃',
        [
          { label: 'Hot Steam', val: mHot * stH.h, color: '#ef4444' },
          { label: 'Cold Water', val: mCold * stC.h, color: '#0284c7' },
        ],
        [{ label: 'ṁ₃ h₃', val: mMix * stMix.h, color: '#059669' }],
        'kW'
      );

      m1L.textContent = 'آنتالپی خروجی (h₃)';
      m1V.textContent = `${stMix.h.toFixed(1)} kJ/kg`;
      m2L.textContent = 'دمای مخلوط (T₃)';
      m2V.textContent = `${stMix.tC.toFixed(1)} °C`;
      m3L.textContent = 'فاز خروجی';
      m3V.textContent = stMix.x !== null ? `${stMix.phase} (x=${stMix.x.toFixed(2)})` : stMix.phase;
      m4L.textContent = 'دبی کل خروجی';
      m4V.textContent = `${mMix.toFixed(2)} kg/s`;
      explainEl.innerHTML = `در <strong>محفظهٔ اختلاط عایق</strong> (<span dir="ltr">P = 200 kPa</span>)، ترکیب مستقیم <span dir="ltr">${mHot.toFixed(2)} kg/s</span> بخار داغ با <span dir="ltr">2.0 kg/s</span> آب سرد، مخلوطی با آنتالپی <span dir="ltr">${stMix.h.toFixed(1)} kJ/kg</span> و دمای <strong><span dir="ltr">${stMix.tC.toFixed(1)} °C</span></strong> (<span dir="ltr">${stMix.phase}</span>) تولید می‌کند.`;
    }
  }

  const anim = createAnimController(root, (dt) => {
    flowClock += dt;
    render();
    return true;
  });

  root.querySelectorAll('#sfd-tabs button').forEach((btn) => {
    btn.addEventListener('click', () => {
      root.querySelectorAll('#sfd-tabs button').forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      tab = (btn.getAttribute('data-tab') as TabKey) || 'compressor';
      subKey = SUBTABS[tab][0].key;
      configureControls(true);
      render();
    });
  });

  s1Slider.addEventListener('input', () => {
    s1Val = parseFloat(s1Slider.value);
    render();
  });

  s2Slider.addEventListener('input', () => {
    s2Val = parseFloat(s2Slider.value);
    render();
  });

  playBtn.addEventListener('click', () => {
    if (anim.isPlaying()) {
      anim.stop();
      playBtn.textContent = '▶ پخش جریان';
    } else {
      playBtn.textContent = '⏸ توقف جریان';
      anim.start();
    }
  });

  resetBtn.addEventListener('click', () => {
    configureControls(true);
    render();
  });

  configureControls(true);
  render();
  // شروع خودکار جریان ملایم هنگام مشاهده شدن در صفحه
  playBtn.textContent = '⏸ توقف جریان';
  anim.start();
}
</script>
