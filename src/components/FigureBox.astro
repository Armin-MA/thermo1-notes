---
import PersianText from './PersianText.astro';

interface Props {
  src: string;
  alt: string;
  caption?: string;
  source?: string;
  maxWidth?: string;
}

const { src, alt, caption, source, maxWidth } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const resolvedSrc =
  src.startsWith('http://') || src.startsWith('https://') || src.startsWith(`${base}/`)
    ? src
    : `${base}/${src.replace(/^\//, '')}`;
---

<figure
  class="jh-figure not-content"
  style={maxWidth ? `--jh-fig-max: ${maxWidth};` : undefined}
>
  <div class="jh-figure__frame">
    <img src={resolvedSrc} alt={alt} loading="lazy" decoding="async" />
  </div>
  {(caption || source) && (
    <figcaption class="jh-figure__cap" dir="rtl">
      {source && <span class="jh-figure__tag"><PersianText text={source} /></span>}
      {caption && <span><PersianText text={caption} /></span>}
    </figcaption>
  )}
</figure>
