---
import Default from '@astrojs/starlight/components/Head.astro';
---

<Default />

<script is:inline>
  window.process = window.process || { env: {}, platform: 'browser', versions: {} };
  (() => {
    try {
      if (localStorage.getItem('jh-nav-collapsed') === 'true') {
        document.documentElement.dataset.jhNavCollapsed = 'true';
      }
      const rawSize = localStorage.getItem('jh-graph-size');
      if (rawSize) {
        const parsed = JSON.parse(rawSize);
        if (parsed.w >= 210 && parsed.w <= 480) {
          document.documentElement.style.setProperty('--jh-right-col-w', `${parsed.w}px`);
        }
        if (parsed.h >= 160 && parsed.h <= 480) {
          document.documentElement.style.setProperty('--jh-graph-h', `${parsed.h}px`);
        }
      }
    } catch (_) {}
  })();
  (() => {
    const cache = new Map();
    const inflight = new Map();
    let popover = null;
    let hideTimer = null;
    let showTimer = null;
    let activeLink = null;

    const isTouchLike = () =>
      window.matchMedia('(hover: none), (pointer: coarse)').matches;

    function escapeHtml(value) {
      return String(value ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function isElementVisibleInViewport(el) {
      const r = el.getBoundingClientRect();
      return r.top >= 48 && r.bottom <= window.innerHeight - 16;
    }

    function ensurePopover() {
      if (popover) return popover;
      popover = document.createElement('div');
      popover.id = 'jh-hover-popover';
      popover.setAttribute('role', 'dialog');
      popover.setAttribute('aria-label', 'پیش‌نمایش سریع');
      popover.addEventListener('mouseenter', () => clearTimeout(hideTimer));
      popover.addEventListener('mouseleave', scheduleHide);
      document.body.appendChild(popover);
      return popover;
    }

    function hidePopover() {
      clearTimeout(showTimer);
      clearTimeout(hideTimer);
      if (popover) {
        popover.classList.remove('is-visible');
        popover.style.visibility = '';
        activeLink = null;
      }
    }

    function scheduleHide() {
      clearTimeout(showTimer);
      if (isTouchLike()) return;
      clearTimeout(hideTimer);
      hideTimer = setTimeout(hidePopover, 180);
    }

    function positionPopover(anchorEl) {
      const box = ensurePopover();
      const rect = anchorEl.getBoundingClientRect();
      const vw = window.innerWidth;
      const vh = window.innerHeight;
      const boxRect = box.getBoundingClientRect();
      const width = boxRect.width || Math.min(460, vw - 24);
      const height = boxRect.height || 260;

      let left = rect.right - width;
      left = Math.min(Math.max(12, left), vw - width - 12);

      let top = rect.bottom + 8;
      if (top + height > vh - 12 && rect.top - 8 - height >= 12) {
        top = rect.top - height - 8;
      } else if (top + height > vh - 12) {
        top = Math.max(12, vh - height - 12);
      }

      box.style.left = `${left}px`;
      box.style.top = `${top}px`;
    }

    async function fetchParsedDoc(pageKey) {
      if (cache.has(pageKey)) return cache.get(pageKey);
      if (inflight.has(pageKey)) return inflight.get(pageKey);

      const req = (async () => {
        try {
          const res = await fetch(pageKey);
          if (!res.ok) return null;
          const text = await res.text();
          const parsed = new DOMParser().parseFromString(text, 'text/html');
          cache.set(pageKey, parsed);
          return parsed;
        } catch (_) {
          return null;
        } finally {
          inflight.delete(pageKey);
        }
      })();

      inflight.set(pageKey, req);
      return req;
    }

    function buildExercisePreview(target, href, showActions) {
      const numEl = target.querySelector('.jh-prob-num');
      const num = numEl?.textContent?.trim() || '';
      const title = target.querySelector('.jh-prob-title')?.textContent?.trim() || 'مسئله تمرینی';
      const tables = target.querySelector('.jh-badge--table')?.textContent?.trim() || '';
      const rawStatement = target.querySelector('.jh-prob-statement');
      if (!rawStatement) return null;

      const statementClone = rawStatement.cloneNode(true);
      statementClone.querySelectorAll('[id]').forEach((el) => el.removeAttribute('id'));
      statementClone.querySelectorAll('img').forEach((img) => {
        img.setAttribute('loading', 'eager');
      });

      const tableBadgeHtml = tables
        ? `<span class="jh-popover-table" dir="ltr">${escapeHtml(tables)}</span>`
        : '';
      const hintHtml = showActions
        ? ''
        : '<div class="jh-popover-prob__hint">برای رفتن به سوال و حل تشریحی کلیک کنید ↗</div>';

      const numHtml = numEl ? numEl.innerHTML : escapeHtml(num);
      return {
        badge: num ? `📝 پیش‌نمایش تمرین ${numHtml}` : '📝 پیش‌نمایش تمرین',
        metaHtml: tableBadgeHtml,
        html: `
          <div class="jh-popover-prob">
            <h4 class="jh-popover-prob__title">${escapeHtml(title)}</h4>
            <div class="jh-popover-prob__body sl-markdown-content">${statementClone.innerHTML}</div>
            ${hintHtml}
          </div>
        `,
        actionLabel: 'باز کردن سوال و حل ↗',
        href,
      };
    }

    async function loadPreview(href, showActions) {
      const url = new URL(href, window.location.href);
      if (url.origin !== window.location.origin) return null;

      // پیش‌نمایش معادله یا مسئله در همین صفحه (فقط وقتی خودش در قاب دید فعلی نباشد)
      if (url.pathname === window.location.pathname && url.hash) {
        const target = document.getElementById(url.hash.slice(1));
        if (!target || isElementVisibleInViewport(target)) return null;
        if (target.classList.contains('jh-prob-card')) {
          return buildExercisePreview(target, url.href, showActions);
        }
        return {
          badge: target.classList.contains('eq-card') ? '📐 پیش‌نمایش معادله' : '📌 پیش‌نمایش بخش',
          metaHtml: '',
          html: target.outerHTML,
          actionLabel: 'پرش به معادله ↓',
          href: url.href,
        };
      }

      // پیش‌نمایش از صفحه دیگر (تمرین، مفهوم یا معادله در فصل دیگر)
      const doc = await fetchParsedDoc(url.pathname);
      if (!doc) return null;

      if (url.hash) {
        const target = doc.getElementById(url.hash.slice(1));
        if (target) {
          if (target.classList.contains('jh-prob-card')) {
            return buildExercisePreview(target, url.href, showActions);
          }
          return {
            badge: '📐 پیش‌نمایش (از صفحه دیگر)',
            metaHtml: '',
            html: target.outerHTML,
            actionLabel: 'باز کردن در صفحه ↗',
            href: url.href,
          };
        }
      }

      const title = doc.querySelector('h1#_top, main h1')?.textContent?.trim() || 'پیش‌نمایش صفحه';
      const firstPara = doc.querySelector('.sl-markdown-content > p')?.innerHTML || '';
      if (!firstPara) return null;
      return {
        badge: `🔗 ${escapeHtml(title)}`,
        metaHtml: '',
        html: `<p style="margin:0">${firstPara}</p>`,
        actionLabel: 'باز کردن صفحه ↗',
        href: url.href,
      };
    }

    async function showPopoverFor(anchorEl, href, showActions) {
      clearTimeout(hideTimer);
      activeLink = anchorEl;
      try {
        const preview = await loadPreview(href, showActions);
        if (!preview || activeLink !== anchorEl) return;
        const box = ensurePopover();
        const actionsHtml = showActions
          ? `<div class="jh-popover-actions">
               <a class="jh-popover-go" href="${preview.href}">${preview.actionLabel}</a>
               <button type="button" class="jh-popover-close" aria-label="بستن پیش‌نمایش">بستن ×</button>
             </div>`
          : '';
        box.innerHTML = `<div class="jh-popover-head"><span class="jh-popover-badge">${preview.badge}</span>${preview.metaHtml || ''}</div>${preview.html}${actionsHtml}`;
        const closeBtn = box.querySelector('.jh-popover-close');
        if (closeBtn) closeBtn.addEventListener('click', hidePopover);
        const goBtn = box.querySelector('.jh-popover-go');
        if (goBtn) goBtn.addEventListener('click', hidePopover);
        box.style.visibility = 'hidden';
        box.classList.add('is-visible');
        positionPopover(anchorEl);
        box.style.visibility = '';
      } catch (_) {}
    }

    function bindHoverPopovers() {
      const touchMode = isTouchLike();
      // فقط ارجاع‌های درون متن اصلی (پاراگراف‌ها، تله‌ها، حل مسائل و کارت‌های شب امتحان)؛
      // منوها، فهرست‌ها، کارت‌های نقشه راه، آکاردئون پیش‌نیازها و خود شماره معادله شلوغ نمی‌شوند
      const links = document.querySelectorAll(
        '.sl-markdown-content > p a[href], .sl-markdown-content .jh-trap a[href], .sl-markdown-content .jh-prob-solution__body p a[href], .jh-exam-pane__body a[href]'
      );
      links.forEach((link) => {
        if (link.dataset.jhBound) return;
        if (link.closest('.eq-card, .dep-accordion, .roadmap-grid, .sl-link-card, h1, h2, h3, h4')) return;
        const href = link.getAttribute('href') || '';
        if (!href || href.startsWith('http') || href.startsWith('mailto:')) return;
        if (href.startsWith('#') && !href.startsWith('#eq-')) return;
        if (link.classList.contains('jh-popover-go')) return;

        link.dataset.jhBound = '1';
        link.dataset.popover = '1';

        // دسکتاپ: پیش‌بارگذاری سبک در پس‌زمینه و نمایش بعد از ۲۴۰ میلی‌ثانیه بدون پرش ناگهانی
        link.addEventListener('mouseenter', () => {
          if (isTouchLike()) return;
          clearTimeout(showTimer);
          clearTimeout(hideTimer);
          try {
            const url = new URL(href, window.location.href);
            if (url.origin === window.location.origin && url.pathname !== window.location.pathname) {
              fetchParsedDoc(url.pathname);
            }
          } catch (_) {}
          showTimer = setTimeout(() => {
            showPopoverFor(link, href, false);
          }, 240);
        });
        link.addEventListener('mouseleave', scheduleHide);

        // موبایل/لمسی:
        const isEqRef = href.includes('#eq-');
        if (isEqRef) {
          link.addEventListener('click', (e) => {
            if (!isTouchLike()) return;
            // اگر معادله همین الان در صفحه دیده می‌شود، پاپ‌آپ تکراری باز نشود
            const url = new URL(href, window.location.href);
            if (url.pathname === window.location.pathname && url.hash) {
              const t = document.getElementById(url.hash.slice(1));
              if (t && isElementVisibleInViewport(t)) return;
            }
            e.preventDefault();
            if (popover?.classList.contains('is-visible') && activeLink === link) {
              hidePopover();
            } else {
              showPopoverFor(link, href, true);
            }
          });
        } else if (touchMode) {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'jh-touch-peek-btn';
          btn.textContent = '👁';
          btn.title = 'پیش‌نمایش سریع بدون خروج از صفحه';
          btn.setAttribute('aria-label', 'پیش‌نمایش سریع بدون خروج از صفحه');
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            if (popover?.classList.contains('is-visible') && activeLink === btn) {
              hidePopover();
            } else {
              showPopoverFor(btn, href, true);
            }
          });
          link.insertAdjacentElement('afterend', btn);
        }
      });

      if (!window.__jhPopoverOutsideBound) {
        window.__jhPopoverOutsideBound = true;
        document.addEventListener('click', (e) => {
          if (!popover || !popover.classList.contains('is-visible')) return;
          const t = e.target;
          if (popover.contains(t)) return;
          if (activeLink && (activeLink === t || activeLink.contains(t))) return;
          hidePopover();
        });
      }
    }

    function bindNavToggle() {
      const titleWrap = document.querySelector('.header .title-wrapper');
      if (!titleWrap || document.getElementById('jh-nav-toggle')) return;
      const btn = document.createElement('button');
      btn.id = 'jh-nav-toggle';
      btn.type = 'button';
      btn.className = 'jh-nav-toggle';
      const syncLabel = () => {
        const collapsed = document.documentElement.dataset.jhNavCollapsed === 'true';
        btn.textContent = collapsed ? '☰ فهرست فصل‌ها' : '✕ بستن فهرست';
        btn.setAttribute('aria-pressed', String(collapsed));
        btn.title = collapsed ? 'باز کردن ستون فهرست فصل‌ها' : 'جمع کردن ستون فهرست برای فضای بیشتر جزوه';
      };
      syncLabel();
      btn.addEventListener('click', () => {
        const next = document.documentElement.dataset.jhNavCollapsed !== 'true';
        if (next) {
          document.documentElement.dataset.jhNavCollapsed = 'true';
        } else {
          delete document.documentElement.dataset.jhNavCollapsed;
        }
        try { localStorage.setItem('jh-nav-collapsed', String(next)); } catch (_) {}
        syncLabel();
        window.dispatchEvent(new Event('resize'));
      });
      titleWrap.appendChild(btn);
    }

    function bindSearchShortcuts() {
      const openBtn = document.querySelector('site-search button[data-open-modal]');
      if (openBtn) {
        openBtn.setAttribute('aria-keyshortcuts', '/ Control+/ Control+K');
        openBtn.title = 'جستجو در جزوه — میانبر: کلید / یا Ctrl+/ یا Ctrl+K';
        const kbdWrap = openBtn.querySelector(':scope > kbd');
        if (kbdWrap) {
          kbdWrap.innerHTML = '<kbd dir="ltr">/</kbd>';
          kbdWrap.style.display = '';
        }
      }

      if (window.__jhSearchShortcutBound) return;
      window.__jhSearchShortcutBound = true;

      window.addEventListener(
        'keydown',
        (e) => {
          const t = e.target;
          const tag = t && t.tagName ? t.tagName.toUpperCase() : '';
          const inEditable =
            tag === 'INPUT' ||
            tag === 'TEXTAREA' ||
            tag === 'SELECT' ||
            Boolean(t && t.isContentEditable);

          const isSlashBare =
            !e.ctrlKey &&
            !e.metaKey &&
            !e.altKey &&
            !inEditable &&
            (e.key === '/' || e.code === 'Slash' || e.code === 'NumpadDivide');

          const isCtrlSlash =
            (e.ctrlKey || e.metaKey) &&
            !e.altKey &&
            (e.key === '/' || e.code === 'Slash' || e.code === 'NumpadDivide');

          const isCtrlK =
            (e.ctrlKey || e.metaKey) &&
            !e.altKey &&
            (e.code === 'KeyK' || (e.key && e.key.toLowerCase() === 'k'));

          const isAltS =
            e.altKey &&
            !e.ctrlKey &&
            !e.metaKey &&
            (e.code === 'KeyS' || (e.key && e.key.toLowerCase() === 's'));

          if (!isSlashBare && !isCtrlSlash && !isCtrlK && !isAltS) return;

          const siteSearch = document.querySelector('site-search');
          if (!siteSearch) return;
          const dialog = siteSearch.querySelector('dialog');
          const btnOpen = siteSearch.querySelector('button[data-open-modal]');
          const btnClose = siteSearch.querySelector('button[data-close-modal]');

          e.preventDefault();
          e.stopPropagation();
          e.stopImmediatePropagation();

          if (dialog && dialog.open) {
            if (btnClose) btnClose.click();
            else dialog.close();
          } else if (btnOpen) {
            const openSearch = () => {
              btnOpen.click();
              const cleanAndFocus = () => {
                const inp = siteSearch.querySelector('input');
                if (inp) {
                  if (isSlashBare && inp.value === '/') {
                    inp.value = '';
                    inp.dispatchEvent(new Event('input', { bubbles: true }));
                  }
                  inp.focus();
                }
              };
              cleanAndFocus();
              if (isSlashBare) {
                setTimeout(cleanAndFocus, 50);
              }
            };
            if (isSlashBare) {
              setTimeout(openSearch, 45);
            } else {
              openSearch();
            }
          }
        },
        { capture: true }
      );
    }

    const PAIR_RX =
      /(?<![0-9\u06f0-\u06f9A-Za-z_])((?:[\u06f0-\u06f9]+|(?<![\u0621-\u06cc])ج)([\-–])([\u06f0-\u06f9]+))(?![0-9\u06f0-\u06f9A-Za-z_\-–])/g;

    function wrapPairsInElement(root) {
      if (!root) return;
      const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
        acceptNode(node) {
          const p = node.parentElement;
          if (!p) return NodeFilter.FILTER_REJECT;
          if (p.closest('.jh-numpair, .katex, code, pre, kbd, script, style, svg, [dir="ltr"]')) {
            return NodeFilter.FILTER_REJECT;
          }
          PAIR_RX.lastIndex = 0;
          return PAIR_RX.test(node.nodeValue || '') ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT;
        },
      });
      const textNodes = [];
      let cur;
      while ((cur = walker.nextNode())) textNodes.push(cur);

      for (const tn of textNodes) {
        const text = tn.nodeValue || '';
        PAIR_RX.lastIndex = 0;
        const frag = document.createDocumentFragment();
        let last = 0;
        let m;
        while ((m = PAIR_RX.exec(text)) !== null) {
          if (m.index > last) {
            frag.appendChild(document.createTextNode(text.slice(last, m.index)));
          }
          const full = m[1];
          const sep = m[2];
          const idx = full.indexOf(sep);
          const span = document.createElement('span');
          span.className = 'jh-numpair';
          span.dir = 'rtl';
          const b1 = document.createElement('bdi');
          b1.textContent = full.slice(0, idx);
          const b2 = document.createElement('bdi');
          b2.textContent = full.slice(idx + sep.length);
          span.appendChild(b1);
          span.appendChild(document.createTextNode(sep));
          span.appendChild(b2);
          frag.appendChild(span);
          last = PAIR_RX.lastIndex;
        }
        if (last < text.length) {
          frag.appendChild(document.createTextNode(text.slice(last)));
        }
        tn.parentNode?.replaceChild(frag, tn);
      }
    }

    function normalizeChromePairs() {
      document
        .querySelectorAll('main, .sidebar-content, starlight-toc, .pagination-links, .sl-link-card, .jh-widget')
        .forEach((el) => wrapPairsInElement(el));

      const searchDialog = document.querySelector('site-search dialog');
      if (searchDialog && !searchDialog.__jhPairObserved) {
        searchDialog.__jhPairObserved = true;
        let timer = null;
        const obs = new MutationObserver(() => {
          if (timer) clearTimeout(timer);
          timer = setTimeout(() => {
            timer = null;
            wrapPairsInElement(searchDialog);
          }, 40);
        });
        obs.observe(searchDialog, { childList: true, subtree: true });
      }
    }

    function onReady() {
      bindHoverPopovers();
      bindNavToggle();
      bindSearchShortcuts();
      normalizeChromePairs();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', onReady);
    } else {
      onReady();
    }
    document.addEventListener('astro:page-load', onReady);
  })();
</script>
